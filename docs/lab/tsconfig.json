{
  // Компилируем в обычные ES-модули и отдаём браузеру как есть: бандлера нет и не надо.
  // Импорты пишутся С расширением .js (tsc их не переписывает) — иначе браузер не найдёт файл.
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "Node",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,

    "rootDir": "src",
    "outDir": "dist",
    "sourceMap": true,
    "removeComments": false,

    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
