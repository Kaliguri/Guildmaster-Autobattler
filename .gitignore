# Unity generated
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# SimBench balance reports (generated tool output)
BalanceReports/

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crashes
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*/**.bundle
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*/**.bundle.meta

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/

# Visual Studio cache directory
.vs/
.vsconfig

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Rider solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# JetBrains Rider
.idea/
*.sln.iml

# MacOS Finder trash
.DS_Store

# Windows Thumbnails
Thumbs.db

# Node.js
node_modules/
npm-debug.log
yarn-error.log

# FMOD editor log (regenerated)
fmod_editor.log

# FMOD Studio project build cache (regenerated)
FMOD Project/.cache/

# Промежуточная нормализация звука: пересобирается scripts/audio/build_source_audio.py,
# а канонные копии всё равно живут в FMOD Project/Assets (FMOD копирует импорт к себе).
FMOD Project/SourceAudio/

# dotenv
.env
.env.*

# Cursor MCP config (contains secrets)
.cursor/mcp.json

# OS generated files
desktop.ini
ehthumbs.db

# Obsidian personal state (keep app.json and graph.json, ignore workspace state)
docs/wiki/.obsidian/workspace.json
docs/wiki/.obsidian/workspace-mobile.json
docs/wiki/.obsidian/cache
# Per-user plugin state that constantly drifts (recent-files = list of files YOU opened).
# Only personal-state data.json belongs here; plugin *config* data.json stays tracked.
docs/wiki/.obsidian/plugins/recent-files-obsidian/data.json

# Obsidian community plugins — track manifest.json only, not compiled bundles.
# main.js is large & re-downloadable; full inventory in docs/obsidian-plugins-backup.md
# (restore: github.com/<repo>/releases/latest/download/main.js into plugins/<id>/).
docs/wiki/.obsidian/plugins/*/main.js
docs/wiki/.obsidian/plugins/*/main.js.bak
docs/wiki/.obsidian/plugins/*/styles.css

# Docs site build artifacts
quartz-build/
site/

# Claude Code local settings (per-user, not shared)
.claude/settings.local.json

# Dev debug screenshots (UiPreviewCapture / manual grabs)
Assets/Screenshots/
Assets/Screenshots.meta

# MCP UI-preview render textures (generated by tooling, not shared)
Assets/UI/RT_MCP_*.renderTexture
Assets/UI/RT_MCP_*.renderTexture.meta

# Local test builds (Alebardium/Test/Build & Run) — not shared
/Builds/

# Personal scratch scenes (per-developer sandboxes, never shared).
# Имя вида «<Кто> Scene For Tests.unity» — личная песочница: содержимое меняется под сиюминутный
# опыт и мержится хуже всего. Общие сцены (Core/World/CombatSystems/UiPreview) остаются в git.
Assets/_Project/Scenes/*Scene For Tests.unity
Assets/_Project/Scenes/*Scene For Tests.unity.meta

# Python-кэш скриптов пайплайна
__pycache__/
*.pyc
