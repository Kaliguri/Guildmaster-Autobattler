// Шаблон сборки SteamPipe. Плейсхолдеры подставляет scripts/steam-publish.ps1 и пишет результат во
// временную папку — сюда готовые значения не попадают намеренно: путь к билду у каждого свой, а
// описание меняется каждый раз.
//
// setlive указывает ветку, на которой билд СРАЗУ становится текущим. Боевая ветка сюда не пишется
// никогда: в прод переводит человек кнопкой в партнёрке, посмотрев глазами.
"appbuild"
{
	"appid"		"{{APP_ID}}"
	"desc"		"{{DESCRIPTION}}"
	"buildoutput"	"{{BUILD_OUTPUT}}"
	"contentroot"	"{{CONTENT_ROOT}}"
	"setlive"	"{{BRANCH}}"
	"preview"	"{{PREVIEW}}"
	"local"		""

	"depots"
	{
		"{{DEPOT_ID}}"	"{{DEPOT_SCRIPT}}"
	}
}
