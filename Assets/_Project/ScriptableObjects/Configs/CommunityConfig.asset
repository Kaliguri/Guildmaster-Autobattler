  m_Script: {fileID: 11500000, guid: cbd21f7772b24a2696d9190048aba7a2, type: 3}
  m_Name: CommunityConfig
  m_EditorClassIdentifier: Guildmaster.Data::Guildmaster.Data.Definitions.CommunityConfig
  _headlineKey: ui.community.headline
  _headlineFallback: "\u042D\u0442\u043E \u0434\u0435\u043C\u043E\u0432\u0435\u0440\u0441\u0438\u044F"
  _paragraphs:
  - Key: ui.community.p1
    Fallback: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E, \u0447\u0442\u043E \u0437\u0430\u0448\u043B\u0438.
      \u0413\u0438\u043B\u044C\u0434\u0438\u044F \u0435\u0449\u0451 \u0441\u043E\u0431\u0438\u0440\u0430\u0435\u0442\u0441\u044F:
      \u0447\u0430\u0441\u0442\u044C \u0434\u0432\u0435\u0440\u0435\u0439 \u043E\u0442\u043A\u0440\u044B\u0442\u0430,
      \u0447\u0430\u0441\u0442\u044C \u0442\u043E\u043B\u044C\u043A\u043E \u043D\u0430\u0440\u0438\u0441\u043E\u0432\u0430\u043D\u0430."
  - Key: ui.community.p2
    Fallback: "\u041E\u0448\u0438\u0431\u043A\u0438 \u0431\u0443\u0434\u0443\u0442
      \u2014 \u0440\u0430\u0441\u0441\u043A\u0430\u0436\u0438\u0442\u0435 \u043D\u0430\u043C
      \u043E \u043D\u0438\u0445. \u041F\u0438\u0448\u0438\u0442\u0435, \u0447\u0442\u043E
      \u043F\u043E\u043D\u0440\u0430\u0432\u0438\u043B\u043E\u0441\u044C \u0438 \u0447\u0442\u043E
      \u0441\u043B\u043E\u043C\u0430\u043B\u043E\u0441\u044C."
