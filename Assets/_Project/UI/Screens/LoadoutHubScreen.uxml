<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement class="gm-screen">
        <ui:VisualElement class="gm-panel gm-panel--hub">
            <ui:Label name="hub-title" text="Гильдия" class="gm-panel__title" />
            <ui:VisualElement class="gm-divider" />

            <!-- Команда: ряд из 4 сосудов. Карточки катит код. -->
            <ui:Label name="hub-team-header" text="Команда" class="gm-hub-section" />
            <ui:VisualElement name="hub-roster" class="gm-hub-roster" />

            <ui:VisualElement class="gm-divider" />

            <!-- Общее: баннеры (party) + запас реликвий. -->
            <ui:VisualElement class="gm-hub-common">
                <ui:VisualElement class="gm-hub-common__col">
                    <ui:Label name="hub-banners-header" text="Баннеры" class="gm-hub-section" />
                    <ui:VisualElement name="hub-banners" class="gm-hub-banners" />
                </ui:VisualElement>
                <ui:VisualElement class="gm-hub-common__col">
                    <ui:Label name="hub-stash-header" text="Запас реликвий" class="gm-hub-section" />
                    <ui:VisualElement name="hub-stash" class="gm-slot-grid" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="gm-divider" />

            <ui:VisualElement class="gm-hub-footer">
                <ui:Label name="hub-gold" text="Золото: 0" class="gm-text-muted" />
                <ui:Button name="btn-close" text="Закрыть" class="gm-button" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
