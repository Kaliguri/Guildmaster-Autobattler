<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xmlns:gm="Guildmaster.UI.Components" editor-extension-mode="False">
    <ui:VisualElement class="gm-screen">
        <ui:VisualElement class="gm-panel" style="min-width: 560px; max-width: 600px;">
            <ui:Label text="Loadout" class="gm-panel__title" />

            <ui:VisualElement class="gm-tabbar">
                <ui:Button name="tab-relic" text="Relic" class="gm-tab gm-tab--active" />
                <ui:Button name="tab-items" text="Items" class="gm-tab" />
                <ui:Button name="tab-upgrades" text="Upgrades" class="gm-tab" />
                <ui:Button name="tab-ai" text="AI" class="gm-tab" />
            </ui:VisualElement>

            <ui:VisualElement class="gm-divider" />

            <ui:VisualElement class="gm-loadout-body">
                <ui:ScrollView name="relic-grid" style="flex-grow: 1; max-height: 220px;" />
                <ui:VisualElement class="gm-detail">
                    <ui:Label name="detail-name" text="—" class="gm-detail__name" />
                    <ui:Label name="detail-desc" text="" class="gm-detail__desc" />
                    <ui:Label name="detail-tags" text="" class="gm-detail__tags" />
                    <ui:Label name="detail-stats" text="" class="gm-detail__stats" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="gm-divider" />

            <!-- Пластины, как на всех игровых экранах: обычные ui:Button остались здесь с прежней
                 раскладки и были единственным местом, где кнопка выглядела чужой (наход. Макса
                 05.08.2026). Заодно ушли инлайн-стили и английские подписи. -->
            <ui:VisualElement class="gm-button-row">
                <gm:PlateButton name="btn-accept" text="Принять" class="gm-button gm-button--fill" />
                <gm:PlateButton name="btn-save" text="Сохранить" class="gm-button gm-button--fill" />
                <gm:PlateButton name="btn-close" text="Закрыть" class="gm-button gm-button--fill" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
