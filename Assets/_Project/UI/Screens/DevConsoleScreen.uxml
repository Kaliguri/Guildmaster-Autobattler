<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="console-root" class="gm-console">
        <ui:VisualElement class="gm-console__header">
            <ui:Label text="Команды" class="gm-console__title" picking-mode="Ignore" />
            <ui:VisualElement class="gm-console__spacer" picking-mode="Ignore" />
            <ui:Label text="F1 команды · F2 лог · F3 бои" class="gm-console__keys" picking-mode="Ignore" />
        </ui:VisualElement>

        <ui:ScrollView name="console-log" class="gm-console__log" mode="Vertical"
                       vertical-scroller-visibility="Auto" horizontal-scroller-visibility="Hidden" />

        <ui:ScrollView name="console-palette" class="gm-console__palette gm-console__palette--hidden" mode="Vertical"
                       vertical-scroller-visibility="Auto" horizontal-scroller-visibility="Hidden" />

        <ui:VisualElement name="console-input-row" class="gm-console__input-row">
            <ui:Label text="&gt;" class="gm-console__prompt" picking-mode="Ignore" />

            <ui:VisualElement name="console-field-slot" class="gm-console__field-slot">
                <ui:Label name="console-ghost" text="" class="gm-console__ghost" picking-mode="Ignore" />
                <ui:TextField name="console-field" class="gm-console__field" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="gm-console__footer">
            <ui:VisualElement class="gm-console__footer-buttons">
                <ui:Button name="console-all" text="все команды" class="gm-console__tool" />
                <ui:Button name="console-help" text="справка" class="gm-console__tool" />
                <ui:Button name="console-clear" text="очистить" class="gm-console__tool" />
            </ui:VisualElement>
            <ui:Label name="console-status" text="" class="gm-console__footer-text" picking-mode="Ignore" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
