<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xmlns:gm="Guildmaster.UI.Components" editor-extension-mode="False">
    <Style src="UiGalleryScreen.uss" />
    <ui:ScrollView class="gm-gallery-root">
        <ui:Label text="Guildmaster UI — component gallery" class="gm-panel__title" style="-unity-text-align: upper-left; font-size: 24px; margin-bottom: 4px;" />
        <ui:Label text="dev-каталог: токены и gm-* компоненты в одном месте (визуальная приёмка)" class="gm-text-muted" />

        <ui:Label text="SlantedPanel — подложка со скошенными торцами (лента режимов, капсулы ресурсов)" class="gm-text-muted gm-gallery-caption" />
        <ui:VisualElement class="gm-gallery-row">
            <gm:SlantedPanel Slant="14" class="gm-runbar__ribbon" style="height: 64px;">
                <gm:Chip class="gm-chip--collapsible gm-runbar__tab gm-runbar__tab--map" />
                <gm:Chip text="Бой" class="gm-chip--collapsible gm-runbar__tab gm-runbar__tab--battle gm-chip--active" />
                <ui:VisualElement class="gm-runbar__sep" />
                <gm:Chip class="gm-chip--collapsible gm-runbar__tab gm-runbar__tab--menu" />
            </gm:SlantedPanel>
            <gm:SlantedPanel Slant="10" class="gm-runbar__capsule">
                <ui:VisualElement class="gm-runbar__capsule-icon gm-runbar__capsule-icon--gold" />
                <ui:Label text="100" class="gm-runbar__capsule-value" />
            </gm:SlantedPanel>
        </ui:VisualElement>

        <ui:Label text="gm-chip — иконка + подпись (фильтры, теги; наведение интерактивно; активный — латунь)" class="gm-text-muted gm-gallery-caption" />
        <ui:VisualElement class="gm-gallery-row gm-gallery-row--wide">
            <gm:Chip text="Реликвии" class="gm-filter-tab gm-filter-tab--relics gm-chip--active" />
            <gm:Chip text="Предметы" class="gm-filter-tab gm-filter-tab--items" />
            <gm:Chip text="Знамёна" class="gm-filter-tab gm-filter-tab--banners" />
        </ui:VisualElement>

        <!-- ПАЛИТРА. Образцы ссылаются на токены классами (UiGalleryScreen.uss) — ни одного числа
             в разметке. Правка яруса токенов обязана быть видна здесь немедленно; если образец
             не поменялся — сломана витрина, а не палитра. -->
        <ui:Label text="Ярус 1 — примитивы: ink (дерево/чернила)" class="gm-text-muted gm-gallery-caption" />
        <ui:VisualElement class="gm-swatch-grid">
            <ui:VisualElement class="gm-swatch">
                <ui:VisualElement class="gm-swatch__box gm-swatch__box--ink-900" />
                <ui:Label text="ink-900" class="gm-text-muted gm-swatch__label" />
            </ui:VisualElement>
            <ui:VisualElement class="gm-swatch">
                <ui:VisualElement class="gm-swatch__box gm-swatch__box--ink-800" />
                <ui:Label text="ink-800" class="gm-text-muted gm-swatch__label" />
            </ui:VisualElement>
            <ui:VisualElement class="gm-swatch">
                <ui:VisualElement class="gm-swatch__box gm-swatch__box--ink-700" />
                <ui:Label text="ink-700" class="gm-text-muted gm-swatch__label" />
            </ui:VisualElement>
            <ui:VisualElement class="gm-swatch">
                <ui:VisualElement class="gm-swatch__box gm-swatch__box--ink-600" />
                <ui:Label text="ink-600" class="gm-text-muted gm-swatch__label" />
            </ui:VisualElement>
            <ui:VisualElement class="gm-swatch">
                <ui:VisualElement class="gm-swatch__box gm-swatch__box--ink-500" />
                <ui:Label text="ink-500" class="gm-text-muted gm-swatch__label" />
            </ui:VisualElement>
            <ui:VisualElement class="gm-swatch">
                <ui:VisualElement class="gm-swatch__box gm-swatch__box--ink-400" />
                <ui:Label text="ink-400" class="gm-text-muted gm-swatch__label" />
            </ui:VisualElement>
            <ui:VisualElement class="gm-swatch">
                <ui:VisualElement class="gm-swatch__box gm-swatch__box--ink-300" />
                <ui:Label text="ink-300" class="gm-text-muted gm-swatch__label" />
            </ui:VisualElement>
            <ui:VisualElement class="gm-swatch">
                <ui:VisualElement class="gm-swatch__box gm-swatch__box--ink-200" />
                <ui:Label text="ink-200" class="gm-text-muted gm-swatch__label" />
            </ui:VisualElement>
            <ui:VisualElement class="gm-swatch">
                <ui:VisualElement class="gm-swatch__box gm-swatch__box--ink-100" />
                <ui:Label text="ink-100" class="gm-text-muted gm-swatch__label" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:Label text="Ярус 1 — примитивы: brass (латунь) / parchment (пергамент) / danger" class="gm-text-muted gm-gallery-caption" />
        <ui:VisualElement class="gm-swatch-grid">
            <ui:VisualElement class="gm-swatch">
                <ui:VisualElement class="gm-swatch__box gm-swatch__box--brass-700" />
                <ui:Label text="brass-700" class="gm-text-muted gm-swatch__label" />
            </ui:VisualElement>
            <ui:VisualElement class="gm-swatch">
                <ui:VisualElement class="gm-swatch__box gm-swatch__box--brass-600" />
                <ui:Label text="brass-600" class="gm-text-muted gm-swatch__label" />
            </ui:VisualElement>
            <ui:VisualElement class="gm-swatch">
                <ui:VisualElement class="gm-swatch__box gm-swatch__box--brass-500" />
                <ui:Label text="brass-500" class="gm-text-muted gm-swatch__label" />
            </ui:VisualElement>
            <ui:VisualElement class="gm-swatch">
                <ui:VisualElement class="gm-swatch__box gm-swatch__box--brass-400" />
                <ui:Label text="brass-400" class="gm-text-muted gm-swatch__label" />
            </ui:VisualElement>
            <ui:VisualElement class="gm-swatch">
                <ui:VisualElement class="gm-swatch__box gm-swatch__box--brass-300" />
                <ui:Label text="brass-300" class="gm-text-muted gm-swatch__label" />
            </ui:VisualElement>
            <ui:VisualElement class="gm-swatch">
                <ui:VisualElement class="gm-swatch__box gm-swatch__box--brass-200" />
                <ui:Label text="brass-200" class="gm-text-muted gm-swatch__label" />
            </ui:VisualElement>
            <ui:VisualElement class="gm-swatch">
                <ui:VisualElement class="gm-swatch__box gm-swatch__box--parchment-100" />
                <ui:Label text="parch-100" class="gm-text-muted gm-swatch__label" />
            </ui:VisualElement>
            <ui:VisualElement class="gm-swatch">
                <ui:VisualElement class="gm-swatch__box gm-swatch__box--parchment-200" />
                <ui:Label text="parch-200" class="gm-text-muted gm-swatch__label" />
            </ui:VisualElement>
            <ui:VisualElement class="gm-swatch">
                <ui:VisualElement class="gm-swatch__box gm-swatch__box--parchment-300" />
                <ui:Label text="parch-300" class="gm-text-muted gm-swatch__label" />
            </ui:VisualElement>
            <ui:VisualElement class="gm-swatch">
                <ui:VisualElement class="gm-swatch__box gm-swatch__box--parchment-400" />
                <ui:Label text="parch-400" class="gm-text-muted gm-swatch__label" />
            </ui:VisualElement>
            <ui:VisualElement class="gm-swatch">
                <ui:VisualElement class="gm-swatch__box gm-swatch__box--danger-500" />
                <ui:Label text="danger-500" class="gm-text-muted gm-swatch__label" />
            </ui:VisualElement>
            <ui:VisualElement class="gm-swatch">
                <ui:VisualElement class="gm-swatch__box gm-swatch__box--danger-400" />
                <ui:Label text="danger-400" class="gm-text-muted gm-swatch__label" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:Label text="Ярус 2 — роли: поверхности и акценты" class="gm-text-muted gm-gallery-caption" />
        <ui:VisualElement class="gm-swatch-grid">
            <ui:VisualElement class="gm-swatch">
                <ui:VisualElement class="gm-swatch__box gm-swatch__box--surface-panel" />
                <ui:Label text="surface panel" class="gm-text-muted gm-swatch__label" />
            </ui:VisualElement>
            <ui:VisualElement class="gm-swatch">
                <ui:VisualElement class="gm-swatch__box gm-swatch__box--surface-raised" />
                <ui:Label text="surface raised" class="gm-text-muted gm-swatch__label" />
            </ui:VisualElement>
            <ui:VisualElement class="gm-swatch">
                <ui:VisualElement class="gm-swatch__box gm-swatch__box--surface-sunken" />
                <ui:Label text="surface sunken" class="gm-text-muted gm-swatch__label" />
            </ui:VisualElement>
            <ui:VisualElement class="gm-swatch">
                <ui:VisualElement class="gm-swatch__box gm-swatch__box--hover-surface" />
                <ui:Label text="hover surface" class="gm-text-muted gm-swatch__label" />
            </ui:VisualElement>
            <ui:VisualElement class="gm-swatch">
                <ui:VisualElement class="gm-swatch__box gm-swatch__box--accent" />
                <ui:Label text="accent" class="gm-text-muted gm-swatch__label" />
            </ui:VisualElement>
            <ui:VisualElement class="gm-swatch">
                <ui:VisualElement class="gm-swatch__box gm-swatch__box--accent-hover" />
                <ui:Label text="accent hover" class="gm-text-muted gm-swatch__label" />
            </ui:VisualElement>
            <ui:VisualElement class="gm-swatch">
                <ui:VisualElement class="gm-swatch__box gm-swatch__box--danger" />
                <ui:Label text="danger" class="gm-text-muted gm-swatch__label" />
            </ui:VisualElement>
            <ui:VisualElement class="gm-swatch">
                <ui:VisualElement class="gm-swatch__box gm-swatch__box--focus-ring" />
                <ui:Label text="focus ring" class="gm-text-muted gm-swatch__label" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Смысловые акценты. Проверка правила «тёплого света»: цвет есть, но рядом с латунью
             он не должен выглядеть чужим — если образец «звенит», он слишком чист. -->
        <ui:Label text="Ярус 2 — смысловые акценты (тёплый замес: положительное / отрицательное / информация / аркана)" class="gm-text-muted gm-gallery-caption" />
        <ui:VisualElement class="gm-swatch-grid">
            <ui:VisualElement class="gm-swatch">
                <ui:VisualElement class="gm-swatch__box gm-swatch__box--positive" />
                <ui:Label text="positive" class="gm-text-muted gm-swatch__label" />
            </ui:VisualElement>
            <ui:VisualElement class="gm-swatch">
                <ui:VisualElement class="gm-swatch__box gm-swatch__box--positive-dim" />
                <ui:Label text="positive dim" class="gm-text-muted gm-swatch__label" />
            </ui:VisualElement>
            <ui:VisualElement class="gm-swatch">
                <ui:VisualElement class="gm-swatch__box gm-swatch__box--negative" />
                <ui:Label text="negative" class="gm-text-muted gm-swatch__label" />
            </ui:VisualElement>
            <ui:VisualElement class="gm-swatch">
                <ui:VisualElement class="gm-swatch__box gm-swatch__box--info" />
                <ui:Label text="info" class="gm-text-muted gm-swatch__label" />
            </ui:VisualElement>
            <ui:VisualElement class="gm-swatch">
                <ui:VisualElement class="gm-swatch__box gm-swatch__box--info-dim" />
                <ui:Label text="info dim" class="gm-text-muted gm-swatch__label" />
            </ui:VisualElement>
            <ui:VisualElement class="gm-swatch">
                <ui:VisualElement class="gm-swatch__box gm-swatch__box--arcane" />
                <ui:Label text="arcane" class="gm-text-muted gm-swatch__label" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:Label text="Ярус 2 — роли: контуры (показаны контуром) и текст (показан текстом на своей поверхности)" class="gm-text-muted gm-gallery-caption" />
        <ui:VisualElement class="gm-swatch-grid">
            <ui:VisualElement class="gm-swatch">
                <ui:VisualElement class="gm-swatch__box gm-swatch__box--outline-strong" />
                <ui:Label text="outline strong" class="gm-text-muted gm-swatch__label" />
            </ui:VisualElement>
            <ui:VisualElement class="gm-swatch">
                <ui:VisualElement class="gm-swatch__box gm-swatch__box--outline-subtle" />
                <ui:Label text="outline subtle" class="gm-text-muted gm-swatch__label" />
            </ui:VisualElement>
            <ui:VisualElement class="gm-swatch">
                <ui:VisualElement class="gm-swatch__box gm-swatch__box--outline-inner" />
                <ui:Label text="outline inner" class="gm-text-muted gm-swatch__label" />
            </ui:VisualElement>
            <ui:VisualElement class="gm-swatch">
                <ui:Label text="Текст" class="gm-swatch__box gm-swatch__box--text gm-swatch__box--text-normal" />
                <ui:Label text="text" class="gm-text-muted gm-swatch__label" />
            </ui:VisualElement>
            <ui:VisualElement class="gm-swatch">
                <ui:Label text="Текст" class="gm-swatch__box gm-swatch__box--text gm-swatch__box--text-muted" />
                <ui:Label text="text muted" class="gm-text-muted gm-swatch__label" />
            </ui:VisualElement>
            <ui:VisualElement class="gm-swatch">
                <ui:Label text="Текст" class="gm-swatch__box gm-swatch__box--text gm-swatch__box--text-disabled" />
                <ui:Label text="text disabled" class="gm-text-muted gm-swatch__label" />
            </ui:VisualElement>
            <ui:VisualElement class="gm-swatch">
                <ui:Label text="Текст" class="gm-swatch__box gm-swatch__box--text gm-swatch__box--text-on-accent" />
                <ui:Label text="text on accent" class="gm-text-muted gm-swatch__label" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:Label text="gm-button (hover / active — интерактивны в Play)" class="gm-text-muted gm-gallery-caption" />
        <ui:VisualElement style="flex-direction: row; align-items: flex-start;">
            <ui:Button text="Default" class="gm-button" style="margin-right: 12px;" />
            <ui:Button text="Primary" class="gm-button gm-button--primary" style="margin-right: 12px;" />
            <ui:Button text="Disabled" class="gm-button" enabled="false" />
        </ui:VisualElement>

        <!-- СОСТОЯНИЯ. Показываем то, что видно статически: покой, «выбрано», ВЫКЛЮЧЕНО.
             Наведение и нажатие псевдоклассовые — их из разметки не изобразить, они проверяются
             мышью в Play. Выключенные элементы здесь стоят рядом с включёнными намеренно: раньше
             disabled жил только у кнопок, и у чипа/слота/поля выключенное состояние рисовала тема
             Unity своим серым (п.9 раунда 4) — на витрине это теперь видно сразу. -->
        <ui:Label text="Состояния: покой / выбрано / выключено (наведение и нажатие — мышью в Play)" class="gm-text-muted gm-gallery-caption" />
        <ui:VisualElement class="gm-gallery-row">
            <ui:Button text="Кнопка" class="gm-button" style="margin-right: 12px;" />
            <ui:Button text="Главная" class="gm-button gm-button--primary" style="margin-right: 12px;" />
            <ui:Button text="Выключена" class="gm-button" enabled="false" />
        </ui:VisualElement>

        <!-- Ряду чипов нужна реальная ширина колонки: табы-фильтры рассчитаны делить её между собой
             и без контейнера схлопываются друг на друга. -->
        <ui:VisualElement class="gm-gallery-row gm-gallery-row--wide">
            <gm:Chip text="Чип" class="gm-filter-tab" />
            <gm:Chip text="Выбран" class="gm-filter-tab gm-chip--active" />
            <gm:Chip text="Выключен" class="gm-filter-tab gm-filter-tab--last" enabled="false" />
        </ui:VisualElement>

        <ui:VisualElement class="gm-gallery-row">
            <gm:Slot class="gm-slot--sm" style="margin-right: 12px;" />
            <gm:Slot class="gm-slot--sm" enabled="false" style="margin-right: 24px;" />
            <ui:TextField class="gm-loadout__search" style="width: 220px; margin-right: 12px;" />
            <ui:TextField class="gm-loadout__search" enabled="false" style="width: 220px;" />
        </ui:VisualElement>

        <ui:VisualElement class="gm-gallery-row" style="width: 420px;">
            <ui:Slider class="gm-slider" low-value="0" high-value="1" value="0.6" style="flex-grow: 1; margin-right: 16px;" />
            <ui:Slider class="gm-slider" low-value="0" high-value="1" value="0.6" enabled="false" style="flex-grow: 1;" />
        </ui:VisualElement>

        <ui:Label text="gm-panel + gm-slider (settings preview)" class="gm-text-muted gm-gallery-caption" />
        <ui:VisualElement class="gm-panel" style="max-width: 380px;">
            <ui:Label text="Audio" class="gm-panel__title" />
            <ui:VisualElement class="gm-divider" />
            <ui:VisualElement class="gm-slider-row">
                <ui:Label text="Master" class="gm-slider-row__label" />
                <ui:Slider class="gm-slider" low-value="0" high-value="1" value="0.8" />
                <ui:Label text="80%" class="gm-slider-row__value" />
            </ui:VisualElement>
            <ui:VisualElement class="gm-slider-row">
                <ui:Label text="Music" class="gm-slider-row__label" />
                <ui:Slider class="gm-slider" low-value="0" high-value="1" value="0.65" />
                <ui:Label text="65%" class="gm-slider-row__value" />
            </ui:VisualElement>
            <ui:VisualElement class="gm-slider-row">
                <ui:Label text="SFX" class="gm-slider-row__label" />
                <ui:Slider class="gm-slider" low-value="0" high-value="1" value="1" />
                <ui:Label text="100%" class="gm-slider-row__value" />
            </ui:VisualElement>
            <gm:ToggleRow label-text="Анимация карточек" Value="true" />
            <gm:ToggleRow label-text="Анимация атаки карточек" Value="true" />
            <ui:VisualElement class="gm-divider" />
            <ui:VisualElement style="flex-direction: row; justify-content: space-between;">
                <ui:Button text="Save" class="gm-button gm-button--primary" style="flex-grow: 1; margin-right: 8px;" />
                <ui:Button text="Cancel" class="gm-button" style="flex-grow: 1; margin-right: 8px;" />
                <ui:Button text="Defaults" class="gm-button" style="flex-grow: 1;" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:ScrollView>
</ui:UXML>
