<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:gm="Guildmaster.UI.Components" editor-extension-mode="False">
    <!-- ПАНЕЛИ НЕТ (реш. Макса 04.08.2026). Меню — колонка текста у левой кромки поверх живого
         кадра; правые две трети остаются игре. Прежний диалог по центру со скримом на весь экран
         повторял единственный реф, которому разбор выписал цену: «читается как отдельная
         программа, а не как игра» (Factorio). Числа и приёмы — `_teardowns/01-main-menu.md`. -->
    <ui:VisualElement class="gm-mainmenu">
        <!-- Затемнение трёхслойное (04.08.2026). Общее приглушение кадра лежит фоном на самом корне;
             здесь — вторая ступень, вуаль ПОД колонкой: под пунктами идёт бой, и его яркость меняется
             каждый кадр. Так делают пятеро рефов из восьми, кладущих меню прямо на фон. -->
        <gm:EdgeVeil class="gm-mainmenu__veil" side="Left" />

        <!-- Третья ступень — зерно поверх обоих затемнений. Стоит ПОСЛЕ вуали и ДО колонки: фактура
             обязана лечь на затемнения, но остаться под текстом. -->
        <ui:VisualElement class="gm-mainmenu__texture" picking-mode="Ignore" />

        <ui:VisualElement class="gm-mainmenu__column">
            <!-- Вывеска: надстрочник между линейками, крупное слово, метка сборки (вариант «линейки»,
                 выбор Макса 04.08.2026). С 07.08.2026 это КОНТРОЛ, а не разметка: ту же вывеску
                 просит бут-экран, и композиция обязана быть одна на оба места. Тексты ставит View
                 из локализации — здесь только то, что видно без неё. -->
            <gm:Wordmark name="menu-title" class="gm-mainmenu__title" over="HAPPY" main="GUILDMASTERS" stage="DEMO" />

            <!-- ДВЕ кнопки входа, а не список режимов (модель Макса 02.08.2026). Режим выбирается
                 следующим шагом, вместе с домом и открытостью для друзей: кооп у нас свойство
                 сеанса, а не отдельная игра, и прежний вход «Сетевая игра» рядом с «Начать забег»
                 вёл в то же самое место — две двери в одну комнату.
                 Игровые пункты отделены от служебных зазором на «Профиле», без линии и подзаголовка. -->
            <ui:VisualElement class="gm-mainmenu__buttons">
                <gm:PlateButton name="btn-create" text="Создать игру" class="gm-button gm-button--lg gm-button--display gm-button--primary" />
                <gm:PlateButton name="btn-join" text="Присоединиться" class="gm-button gm-button--lg gm-button--display gm-button--primary" />
                <!-- Компендиум стоит в СЛУЖЕБНОЙ группе между профилем и настройками (порядок
                     Макса 22.08.2026): он про справку о мире, а не про вход в игру. Пока НЕАКТИВЕН —
                     экрана за ним ещё нет, но место в колонке занято уже сейчас, иначе меню
                     перестроится у игрока на глазах в день, когда экран появится. -->
                <gm:PlateButton name="btn-profile" text="Профиль" class="gm-button gm-button--lg gm-button--display gm-mainmenu__group-start" />
                <gm:PlateButton name="btn-compendium" text="Компендиум" class="gm-button gm-button--lg gm-button--display" />
                <gm:PlateButton name="btn-settings" text="Настройки" class="gm-button gm-button--lg gm-button--display" />
                <gm:PlateButton name="btn-quit" text="Выход" class="gm-button gm-button--lg gm-button--display" />
            </ui:VisualElement>
        </ui:VisualElement>


        <!-- ПАНЕЛЬ СООБЩЕСТВА — правая сторона кадра (заказ Макса 22.08.2026: «панель информации о
             сообществе в духе Guildrun и Olden Era и кнока "добавить в список желаемого"»). Оба рефа
             держат одну конструкцию: панель-обращение справа, ряд ссылок под ней, приглашение в
             желаемое отдельным блоком в углу. Числа замера — в теме рядом с правилами.
             Тексты, ссылки и значки ставит View из ассета сообщества: здесь только каркас. -->
        <ui:VisualElement name="community" class="gm-community">
            <ui:VisualElement class="gm-panel gm-community__panel">
                <gm:PanelFrame name="community-frame" class="gm-panel__frame" corner="18" />
                <ui:Label name="community-headline" class="gm-text-title gm-community__headline" />
                <ui:VisualElement name="community-body" class="gm-community__body" />
            </ui:VisualElement>

            <!-- СЛУЖЕБНАЯ СТРОКА ПОД ПАНЕЛЬЮ — 1:1 приём Olden Era: слева «Отчёт об ошибке», справа
                 круглые значки каналов. У рефа это единственное место, где живут ссылки, и стоит
                 оно ровно под панелью обращения, а не внутри неё. -->
            <ui:VisualElement name="community-service" class="gm-community__service">
                <gm:PlateButton name="btn-bugreport" class="gm-button gm-button--sm gm-community__bug">
                    <ui:VisualElement class="gm-button__icon gm-community__bug-icon" picking-mode="Ignore" />
                </gm:PlateButton>
                <ui:VisualElement name="community-links" class="gm-community__links" />
            </ui:VisualElement>

            <!-- Приглашение в желаемое стоит ПОД строкой отдельным блоком, как у Guildrun: это не
                 часть обращения, а просьба, и мешать её с «спасибо, что играете» нечестно. -->
            <ui:VisualElement name="community-wishlist" class="gm-community__wishlist">
                <ui:Label name="wishlist-caption" class="gm-text-caption gm-community__wishlist-caption" />
                <gm:PlateButton name="btn-wishlist" class="gm-button gm-button--sm gm-button--block gm-button--primary" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Версия билда: угол экрана. Нижний правый — самое частое место у рефов (13 из 14 держат
             версию мелким кеглем в углу), и единственный реф, поставивший её в центр верха, получил
             за это отдельный пункт в «чего избегать». Текст проставляется кодом. -->
        <ui:Label name="menu-version" class="gm-version-stamp" />
    </ui:VisualElement>
</ui:UXML>
