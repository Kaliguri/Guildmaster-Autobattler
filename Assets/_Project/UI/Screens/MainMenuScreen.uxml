<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:gm="Guildmaster.UI.Components" editor-extension-mode="False">
    <!-- ПАНЕЛИ НЕТ (реш. Макса 04.08.2026). Меню — колонка текста у левой кромки поверх живого
         кадра; правые две трети остаются игре. Прежний диалог по центру со скримом на весь экран
         повторял единственный реф, которому разбор выписал цену: «читается как отдельная
         программа, а не как игра» (Factorio). Числа и приёмы — `_teardowns/01-main-menu.md`. -->
    <ui:VisualElement class="gm-mainmenu">
        <!-- Затемнение трёхслойное (04.08.2026). Общее приглушение кадра лежит фоном на самом корне;
             здесь — вторая ступень, вуаль ПОД колонкой: под пунктами идёт бой, и его яркость меняется
             каждый кадр. Так делают пятеро рефов из восьми, кладущих меню прямо на фон. -->
        <gm:EdgeVeil class="gm-mainmenu__veil" side="Left" />

        <!-- Третья ступень — зерно поверх обоих затемнений. Стоит ПОСЛЕ вуали и ДО колонки: фактура
             обязана лечь на затемнения, но остаться под текстом. -->
        <ui:VisualElement class="gm-mainmenu__texture" picking-mode="Ignore" />

        <ui:VisualElement class="gm-mainmenu__column">
            <!-- Вывеска: надстрочник между линейками, крупное слово, метка сборки (вариант «линейки»,
                 выбор Макса 04.08.2026). Два слова живут отдельными элементами не для красоты — у них
                 разные гарнитуры, кегли и разрядка, одним Label этого не выразить. -->
            <ui:VisualElement class="gm-mainmenu__title" picking-mode="Ignore">
                <ui:VisualElement class="gm-title__band" picking-mode="Ignore">
                    <ui:VisualElement class="gm-title__rule" />
                    <ui:Label name="menu-title-over" text="HAPPY" class="gm-title__over" />
                    <ui:VisualElement class="gm-title__rule" />
                </ui:VisualElement>
                <ui:Label name="menu-title" text="GUILDMASTERS" class="gm-title__main" />
                <ui:Label name="menu-stage" text="DEMO" class="gm-title__demo" />
            </ui:VisualElement>

            <!-- ДВЕ кнопки входа, а не список режимов (модель Макса 02.08.2026). Режим выбирается
                 следующим шагом, вместе с домом и открытостью для друзей: кооп у нас свойство
                 сеанса, а не отдельная игра, и прежний вход «Сетевая игра» рядом с «Начать забег»
                 вёл в то же самое место — две двери в одну комнату.
                 Игровые пункты отделены от служебных зазором на «Профиле», без линии и подзаголовка. -->
            <ui:VisualElement class="gm-mainmenu__buttons">
                <gm:PlateButton name="btn-create" text="СОЗДАТЬ ИГРУ" class="gm-button gm-button--display gm-mainmenu__btn gm-mainmenu__btn--primary" />
                <gm:PlateButton name="btn-join" text="ПРИСОЕДИНИТЬСЯ" class="gm-button gm-button--display gm-mainmenu__btn gm-mainmenu__btn--primary" />
                <gm:PlateButton name="btn-profile" text="ПРОФИЛЬ" class="gm-button gm-button--display gm-mainmenu__btn gm-mainmenu__btn--group-start" />
                <gm:PlateButton name="btn-settings" text="НАСТРОЙКИ" class="gm-button gm-button--display gm-mainmenu__btn" />
                <gm:PlateButton name="btn-quit" text="ВЫХОД" class="gm-button gm-button--display gm-mainmenu__btn" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Версия билда: угол экрана. Нижний правый — самое частое место у рефов (13 из 14 держат
             версию мелким кеглем в углу), и единственный реф, поставивший её в центр верха, получил
             за это отдельный пункт в «чего избегать». Текст проставляется кодом. -->
        <ui:Label name="menu-version" class="gm-version-stamp" />
    </ui:VisualElement>
</ui:UXML>
