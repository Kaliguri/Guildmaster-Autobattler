<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:gm="Guildmaster.UI.Components" editor-extension-mode="False">
    <!-- Глобальная панель забега (app-shell): всегда сверху во время забега, тело экранов сдвинуто под неё.
         Слева гильдия + возвышение + акт + веха одной строкой; центр — лента со скошенными торцами, в ней
         иконки-режимы (Карта/Бой/Инвентарь/Тактика/Компендиум) и отделённые настройки;
         справа — компактные капсулы золота и перезапусков. Подписи режимов позже даст общая tooltip-система.
         Строки-плейсхолдеры RU; локализованные проставляет RunModeBarView (ключи ui.*). -->
    <ui:VisualElement name="runbar-root" class="gm-loadout__topbar gm-runbar">
        <ui:VisualElement class="gm-loadout__topbar-side">
            <ui:Label name="guild-name" text="Alebardium" class="gm-loadout__guild-name" />
            <ui:Label name="guild-asc" text="· ASC IV" class="gm-loadout__guild-asc" />
            <ui:Label name="topbar-act" text="· Акт 1" class="gm-loadout__guild-asc" />
            <ui:Label name="topbar-floor" text="· Веха 1/15" class="gm-loadout__guild-asc" />
        </ui:VisualElement>

        <!-- Лента-островок: форму рисует SlantedPanel вершинами (скос на 9-slice «плывёт» по ширине). -->
        <gm:SlantedPanel name="runbar-ribbon" Slant="14" class="gm-runbar__ribbon">
            <ui:Button name="mode-map" class="gm-runbar__tab gm-runbar__tab--map" />
            <ui:Button name="mode-battle" class="gm-runbar__tab gm-runbar__tab--battle" />
            <ui:Button name="mode-inventory" class="gm-runbar__tab gm-runbar__tab--inventory" />
            <ui:Button name="mode-tactics" class="gm-runbar__tab gm-runbar__tab--tactics" />
            <ui:Button name="mode-compendium" class="gm-runbar__tab gm-runbar__tab--compendium" />
            <!-- Настройки за разделителем: открывают модалку, а не переключают режим — не должны читаться шестым табом. -->
            <ui:VisualElement class="gm-runbar__sep" />
            <ui:Button name="btn-menu" class="gm-runbar__tab gm-runbar__tab--menu" />
        </gm:SlantedPanel>

        <ui:VisualElement class="gm-loadout__topbar-side gm-loadout__topbar-side--right">
            <gm:SlantedPanel Slant="10" class="gm-runbar__capsule">
                <ui:VisualElement class="gm-runbar__capsule-icon gm-runbar__capsule-icon--gold" />
                <ui:Label name="topbar-gold" text="0" class="gm-runbar__capsule-value" />
            </gm:SlantedPanel>
            <gm:SlantedPanel Slant="10" class="gm-runbar__capsule">
                <ui:VisualElement class="gm-runbar__capsule-icon gm-runbar__capsule-icon--hp" />
                <ui:Label name="topbar-hp" text="2/2" class="gm-runbar__capsule-value" />
            </gm:SlantedPanel>
            <!-- Время забега выключено по решению 2026-07-20; узел оставлен как шов (скрыт классом). -->
            <ui:Label name="topbar-timer" text="00:00" class="gm-loadout__stat gm-loadout__stat--timer gm-runbar__runtime" />
        </ui:VisualElement>

        <!-- Центр-слот «Начать»/таймер боя (QA #14): по центру, ЧУТЬ НИЖЕ панели (absolute под топбаром),
             единая точка — расстановка показывает «Начать», бой заменяет его таймером в ТОЙ ЖЕ точке. -->
        <ui:VisualElement name="battle-center" class="gm-loadout__battle-center">
            <ui:Button name="btn-start" text="Начать" class="gm-loadout__start-btn" />
            <ui:Label name="battle-timer" text="00:00" class="gm-loadout__stat gm-loadout__stat--timer gm-loadout__battle-timer" />
        </ui:VisualElement>

        <!-- Подписи режимов при наведении будут от общей системы тултипов (проектируется отдельно):
             свой локальный тултип здесь не заводим, чтобы потом не выпиливать конкурента. -->
    </ui:VisualElement>
</ui:UXML>
