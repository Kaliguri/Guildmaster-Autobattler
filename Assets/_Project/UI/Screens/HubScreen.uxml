<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:gm="Guildmaster.UI.Components" editor-extension-mode="False">
    <ui:VisualElement class="gm-screen">
        <ui:VisualElement class="gm-panel gm-panel--dialog gm-panel--menu">
            <gm:PanelFrame name="hub-frame" corner="0" />
            <!-- Титул — имя дома: игрок вернулся к СВОЕЙ гильдии, и узнать её он должен первым делом.
                 Текст проставляется кодом. -->
            <ui:Label name="hub-title" text="Двор гильдии" class="gm-text-title gm-panel__title" />
            <ui:VisualElement class="gm-divider" />

            <ui:VisualElement class="gm-panel__body gm-hub__body">
                <!-- ГДЕ СТОИТ ЗАБЕГ, а не «IN PROGRESS»: акт, его имя и ступень маршрута. Заказ Макса
                     22.08.2026. Строку собирает код, потому что имя акта приходит ключом, а ступень —
                     числом из состояния забега. -->
                <ui:Label name="hub-stage" class="gm-text-subtitle gm-hub__stage" />
                <ui:Label name="hub-stub" text="Двор ещё обустраивают" class="gm-text-caption gm-text--muted gm-hub__stub" />
                <gm:PlateButton name="btn-start-run" text="Начать забег" class="gm-button gm-button--primary" />
            </ui:VisualElement>

            <ui:VisualElement class="gm-divider" />
            <ui:VisualElement class="gm-hub__actions">
                <gm:BackButton name="btn-leave" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
