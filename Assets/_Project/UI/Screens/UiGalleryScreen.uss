/* ============================================================================
 * Стили ВИТРИНЫ (dev-экран приёмки). В игровые экраны не подключается.
 *
 * Зачем файл существует: образцы палитры раньше были вписаны в UXML числами
 * (background-color: rgb(217, 178, 106)), и витрина НЕ менялась при смене токенов —
 * единственный экран приёмки палитры врал. Здесь каждый образец ссылается на токен,
 * поэтому правка яруса токенов немедленно видна на витрине.
 *
 * Правило: в этом файле допустимы ТОЛЬКО var(--gm-*). Ни одного литерала цвета.
 * ========================================================================== */

/* --- Каркас витрины --- */
.gm-gallery-root {
    flex-grow: 1;
    background-color: var(--gm-ink-900);
    padding: var(--gm-space-3);
}

/* Подпись раздела витрины. Отступ сверху — один на все разделы, а не по месту. */
.gm-gallery-caption {
    margin-top: var(--gm-space-3);
    margin-bottom: var(--gm-space-1);
}

/* Ряд компонентов на витрине. Ширину ряда задаём явно: часть компонентов (табы фильтров)
   рассчитана делить ширину контейнера, поэтому и на витрине им нужен контейнер реального
   размера — иначе они либо схлопываются друг на друга, либо растягиваются во весь экран. */
.gm-gallery-row {
    flex-direction: row;
    align-items: center;
    align-self: flex-start;
}

.gm-gallery-row--wide {
    width: 640px;   /* ширина колонки инвентаря — там эти табы и живут */
}

/* --- Сетка образцов --- */
.gm-swatch-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.gm-swatch {
    align-items: center;
    margin-right: var(--gm-space-1);
    margin-bottom: var(--gm-space-2);
    width: 96px;
}

/* Плашка образца. Контур subtle, чтобы тёмные образцы читались на тёмном фоне. */
.gm-swatch__box {
    width: 100%;
    height: 44px;
    flex-shrink: 0;
    border-width: var(--gm-outline-width);
    border-color: var(--gm-outline-color-subtle);
}

.gm-swatch__label {
    margin-top: var(--gm-space-0);
    font-size: var(--gm-font-xxs);
    white-space: normal;
    -unity-text-align: upper-center;
}

/* --- ЯРУС 1: примитивы --- */
.gm-swatch__box--ink-900 { background-color: var(--gm-ink-900); }
.gm-swatch__box--ink-800 { background-color: var(--gm-ink-800); }
.gm-swatch__box--ink-700 { background-color: var(--gm-ink-700); }
.gm-swatch__box--ink-600 { background-color: var(--gm-ink-600); }
.gm-swatch__box--ink-500 { background-color: var(--gm-ink-500); }
.gm-swatch__box--ink-400 { background-color: var(--gm-ink-400); }
.gm-swatch__box--ink-300 { background-color: var(--gm-ink-300); }
.gm-swatch__box--ink-200 { background-color: var(--gm-ink-200); }
.gm-swatch__box--ink-100 { background-color: var(--gm-ink-100); }

.gm-swatch__box--brass-700 { background-color: var(--gm-brass-700); }
.gm-swatch__box--brass-600 { background-color: var(--gm-brass-600); }
.gm-swatch__box--brass-500 { background-color: var(--gm-brass-500); }
.gm-swatch__box--brass-400 { background-color: var(--gm-brass-400); }
.gm-swatch__box--brass-300 { background-color: var(--gm-brass-300); }
.gm-swatch__box--brass-200 { background-color: var(--gm-brass-200); }

.gm-swatch__box--parchment-100 { background-color: var(--gm-parchment-100); }
.gm-swatch__box--parchment-200 { background-color: var(--gm-parchment-200); }
.gm-swatch__box--parchment-300 { background-color: var(--gm-parchment-300); }
.gm-swatch__box--parchment-400 { background-color: var(--gm-parchment-400); }

.gm-swatch__box--danger-500 { background-color: var(--gm-danger-500); }
.gm-swatch__box--danger-400 { background-color: var(--gm-danger-400); }

/* --- ЯРУС 2: семантические роли (по ним и идёт приёмка) --- */
.gm-swatch__box--surface-panel  { background-color: var(--gm-color-surface-panel); }
.gm-swatch__box--surface-raised { background-color: var(--gm-color-surface-raised); }
.gm-swatch__box--surface-sunken { background-color: var(--gm-color-surface-sunken); }
.gm-swatch__box--accent         { background-color: var(--gm-color-accent); }
.gm-swatch__box--accent-hover   { background-color: var(--gm-color-accent-hover); }
.gm-swatch__box--danger         { background-color: var(--gm-color-danger); }
.gm-swatch__box--positive       { background-color: var(--gm-color-positive); }
.gm-swatch__box--positive-dim   { background-color: var(--gm-color-positive-dim); }
.gm-swatch__box--negative       { background-color: var(--gm-color-negative); }
.gm-swatch__box--info           { background-color: var(--gm-color-info); }
.gm-swatch__box--info-dim       { background-color: var(--gm-color-info-dim); }
.gm-swatch__box--arcane         { background-color: var(--gm-color-arcane); }
.gm-swatch__box--hover-surface  { background-color: var(--gm-color-hover-surface); }
.gm-swatch__box--focus-ring     { background-color: var(--gm-color-focus-ring); }

/* Роли-контуры показываем контуром, а не заливкой: заливкой их никто не видит в бою. */
.gm-swatch__box--outline-strong { background-color: var(--gm-color-surface-panel); border-color: var(--gm-outline-color); }
.gm-swatch__box--outline-subtle { background-color: var(--gm-color-surface-panel); border-color: var(--gm-outline-color-subtle); }
.gm-swatch__box--outline-inner  { background-color: var(--gm-color-surface-panel); border-color: var(--gm-outline-color-inner); }

/* Текстовые роли показываем ТЕКСТОМ на реальной поверхности — только так видно контраст.
   Именно здесь проваливается disabled: parchment-300 читается, ink-300 сливается с фоном. */
.gm-swatch__box--text {
    background-color: var(--gm-color-surface-panel);
    -unity-text-align: middle-center;
    font-size: var(--gm-font-xs);
}
.gm-swatch__box--text-normal   { color: var(--gm-color-text); }
.gm-swatch__box--text-muted    { color: var(--gm-color-text-muted); }
.gm-swatch__box--text-disabled { color: var(--gm-color-disabled-text); }
.gm-swatch__box--text-on-accent {
    background-color: var(--gm-color-accent);
    color: var(--gm-color-text-on-accent);
}
