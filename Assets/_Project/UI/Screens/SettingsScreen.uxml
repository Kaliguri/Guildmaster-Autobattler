<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:gm="Guildmaster.UI.Components" editor-extension-mode="False">
    <ui:VisualElement class="gm-screen">
        <ui:VisualElement class="gm-panel gm-panel--dialog gm-panel--settings">
            <ui:Label text="Настройки" class="gm-panel__title" />
            <ui:VisualElement class="gm-divider" />

            <!-- Табы (визуал-каркас на будущее): Игра / Графика / Звук. Переключение — в MenuRouter. -->
            <ui:VisualElement class="gm-tabbar">
                <ui:Button name="tab-game" text="Игра" class="gm-tab" />
                <ui:Button name="tab-video" text="Графика" class="gm-tab" />
                <ui:Button name="tab-audio" text="Звук" class="gm-tab gm-tab--active" />
            </ui:VisualElement>

            <!-- Тело диалога: занимает остаток высоты и прокручивается, если опций станет больше,
                 чем помещается. Габариты панели от содержимого больше не зависят. -->
            <ui:ScrollView class="gm-panel__body">
            <!-- Страница «Игра»: тумблеры презентации. Подписи + значения проставляет роутер из VM (loc). -->
            <ui:VisualElement name="page-game" class="gm-tab-page gm-tab-page--hidden">
                <gm:ToggleRow name="toggle-card-anim" />
                <gm:ToggleRow name="toggle-card-attack" />
            </ui:VisualElement>

            <!-- Страница «Графика» — заглушка под будущие опции. -->
            <ui:VisualElement name="page-video" class="gm-tab-page gm-tab-page--hidden">
                <ui:Label text="Настройки графики — скоро" class="gm-tab-placeholder" />
            </ui:VisualElement>

            <!-- Страница «Звук» — активная: три строки-слайдера (подписи/значения проставляет роутер из VM). -->
            <ui:VisualElement name="page-audio" class="gm-tab-page">
                <gm:SliderRow name="row-master" />
                <gm:SliderRow name="row-music" />
                <gm:SliderRow name="row-sfx" />
            </ui:VisualElement>

            </ui:ScrollView>

            <ui:VisualElement class="gm-divider" />
            <ui:VisualElement class="gm-button-row">
                <ui:Button name="btn-save" text="Сохранить" class="gm-button gm-button--primary gm-button--fill" />
                <ui:Button name="btn-cancel" text="Отмена" class="gm-button gm-button--fill" />
                <ui:Button name="btn-defaults" text="Сброс" class="gm-button gm-button--fill" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
