<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:gm="Guildmaster.UI.Components" editor-extension-mode="False">
    <ui:VisualElement class="gm-screen">
        <ui:VisualElement class="gm-panel gm-panel--settings">
            <ui:Label text="Аудио" class="gm-panel__title" />
            <ui:VisualElement class="gm-divider" />

            <!-- Строки-слайдеры — компонент SliderRow; подписи/значения проставляет роутер из VM. -->
            <gm:SliderRow name="row-master" />
            <gm:SliderRow name="row-music" />
            <gm:SliderRow name="row-sfx" />

            <ui:VisualElement class="gm-divider" />
            <ui:VisualElement class="gm-button-row">
                <ui:Button name="btn-save" text="Сохранить" class="gm-button gm-button--primary gm-button--fill" />
                <ui:Button name="btn-cancel" text="Отмена" class="gm-button gm-button--fill" />
                <ui:Button name="btn-defaults" text="Сброс" class="gm-button gm-button--fill" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
