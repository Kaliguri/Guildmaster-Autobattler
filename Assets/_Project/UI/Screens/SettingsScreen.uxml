<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:gm="Guildmaster.UI.Components" editor-extension-mode="False">
    <!-- ПАНЕЛИ НЕТ, ТАБЫ СВЕРХУ (выбор Макса 05.08.2026, главный реф — Guildrun). Прежде экран был
         диалогом с табами сбоку; горизонтальная лента взята как схема класса — так у семи рефов из
         тринадцати, — а отказ от панели у самого Guildrun: там настройки лежат прямо на затемнённом
         кадре, панели нет вовсе (`_teardowns/02-settings-pause.md` §5.1, строка «панели нет,
         контент на всём экране»).
         Заголовка «Настройки» тоже нет намеренно: его не рисуют девять рефов из одиннадцати, и это
         не экономия места — экран уже назван пунктом, с которого на него пришли. -->
    <ui:VisualElement class="gm-screen gm-settings">
        <!-- Лента разделов: три таба, как у Guildrun. Кнопка сброса стоит не здесь, а внизу с
             остальными действиями — у всех семи рефов, где она есть, она рядом с «Назад». -->
        <ui:VisualElement class="gm-tabbar gm-settings__tabs">
            <gm:PlateButton name="tab-game" text="Игра" class="gm-tab" />
            <gm:PlateButton name="tab-video" text="Графика" class="gm-tab" />
            <gm:PlateButton name="tab-audio" text="Звук" class="gm-tab gm-tab--active" />
        </ui:VisualElement>
        <!-- Рельса: линия, на которой стоит активная вкладка. Шире ленты — как у рефа. -->
        <ui:VisualElement class="gm-tabbar__rail" />

        <!-- Тело: плоский список строк без секций и заголовков — так у Guildrun, CotDG, Hades II,
             RoR2 и StS2. Прокрутка остаётся на случай, когда опций станет больше, чем помещается. -->
        <ui:ScrollView class="gm-settings__body">
            <!-- Страница «Игра»: тумблеры презентации. Подписи + значения проставляет роутер из VM (loc). -->
            <ui:VisualElement name="page-game" class="gm-tab-page gm-tab-page--hidden">
                <gm:ToggleRow name="toggle-card-anim" />
                <gm:ToggleRow name="toggle-card-attack" />
                <gm:ToggleRow name="toggle-tooltip-details" />
            </ui:VisualElement>

            <!-- Страница «Графика»: дисплей. Подписи и варианты проставляет роутер из VM.
                 «Частота обновления» гаснет вне эксклюзивного полноэкранного — Unity меняет её
                 только там, и живой список без эффекта врал бы игроку. -->
            <ui:VisualElement name="page-video" class="gm-tab-page gm-tab-page--hidden">
                <gm:SelectRow name="row-window-mode" />
                <gm:SelectRow name="row-resolution" />
                <gm:SelectRow name="row-refresh-rate" />
                <ui:Label name="video-hint" class="gm-text-caption gm-text--muted gm-tab-hint" />
            </ui:VisualElement>

            <!-- Страница «Звук» — активная: три строки-слайдера (подписи/значения проставляет роутер из VM). -->
            <ui:VisualElement name="page-audio" class="gm-tab-page">
                <gm:SliderRow name="row-master" />
                <gm:SliderRow name="row-music" />
                <gm:SliderRow name="row-sfx" />
            </ui:VisualElement>
        </ui:ScrollView>

        <!-- Действия внизу по центру: у Guildrun «Назад» стоит там же, а «Сброс по умолчанию» рядом
             с ним и НЕ выделен цветом — ни у одного из семи рефов, где он есть, он не покрашен. -->
        <ui:VisualElement class="gm-settings__actions">
            <gm:PlateButton name="btn-save" text="Сохранить" class="gm-button gm-button--display gm-button--primary" />
            <gm:PlateButton name="btn-defaults" text="Сбросить настройки" class="gm-button gm-button--display" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
