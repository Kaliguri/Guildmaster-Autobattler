<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:gm="Guildmaster.UI.Components">
    <!-- Страница «Предметы» (ГДД preparation-screens §2.2, раскладка «Строки»).

         Тот же каркас, что у страницы «Отряд»: шапка с лентой страниц, тело, действия внизу.
         Слоты выстроены в одну вертикаль — «у кого пусто» читается одним взглядом сверху вниз,
         и это главный вопрос страницы. -->
    <ui:VisualElement name="items-root" class="gm-items">

        <ui:VisualElement class="gm-items__head">
            <ui:Label name="title" text="ПОДГОТОВКА" class="gm-text-title gm-items__title" />
            <ui:VisualElement name="tabs" class="gm-tabbar gm-items__tabs">
                <gm:PlateButton name="tab-party" text="Отряд" class="gm-tab" />
                <gm:PlateButton name="tab-items" text="Предметы" class="gm-tab gm-tab--active" />
            </ui:VisualElement>
            <ui:Label name="slots-note" text="" class="gm-text-caption gm-text--muted" />
        </ui:VisualElement>

        <ui:VisualElement class="gm-items__middle">
            <ui:VisualElement name="rows" class="gm-items__rows" />
            <ui:VisualElement name="inspect-host" class="gm-items__inspect" />
        </ui:VisualElement>

        <ui:VisualElement class="gm-items__stash-block">
            <ui:VisualElement class="gm-items__stash-head">
                <ui:Label name="stash-title" text="ПРЕДМЕТЫ В ЗАПАСЕ" class="gm-text-name gm-text--accent" />
                <ui:Label name="stash-note" text="" class="gm-text-caption gm-text--muted" />
            </ui:VisualElement>
            <ui:ScrollView name="stash" class="gm-items__stash" />
        </ui:VisualElement>

        <ui:VisualElement class="gm-items__actions">
            <gm:PlateButton name="btn-battle" text="В БОЙ" class="gm-button gm-button--primary" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
