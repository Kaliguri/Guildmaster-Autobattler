<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:gm="Guildmaster.UI.Components" editor-extension-mode="False">
    <ui:VisualElement class="gm-screen">
        <ui:VisualElement class="gm-panel gm-panel--dialog gm-panel--confirm gm-panel--system">
            <ui:Label name="confirm-title" class="gm-panel__title" />
            <ui:VisualElement class="gm-divider" />

            <ui:VisualElement class="gm-panel__body">
                <ui:Label name="confirm-body" class="gm-confirm__body" />
                <!-- Отдельная строка последствия: игрок читает заголовок и кнопки, а «что именно
                     пропадёт» обязано попасться ему на глаза до нажатия, а не после. -->
                <ui:Label name="confirm-consequence" class="gm-confirm__consequence" />
            </ui:VisualElement>

            <ui:VisualElement class="gm-divider" />
            <ui:VisualElement class="gm-confirm__actions">
                <!-- Отмена стоит ПЕРВОЙ и она же primary: у необратимого действия по умолчанию
                     выбирается безопасное. -->
                <gm:PlateButton name="btn-cancel" text="Отмена" class="gm-button gm-button--primary" />
                <gm:PlateButton name="btn-confirm" text="Удалить" class="gm-button gm-button--danger" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
