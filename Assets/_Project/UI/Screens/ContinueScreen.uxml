<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <!-- Лёгкий полноэкранный слой-гейт: контент прозрачен, кнопки — в правом нижнем углу (единое место).
         Кнопки стоят СТОЛБИКОМ: главная («Продолжить») сверху, вторая («К построению») под ней.
         Вторая живёт в передышке между узлами и скрывается в режиме гейта — тогда столбик схлопывается
         в одну кнопку, и её место в углу не съезжает. -->
    <ui:VisualElement class="gm-continue-screen">
        <ui:VisualElement name="continue-actions" class="gm-continue">
            <ui:Button name="btn-continue" text="Продолжить" class="gm-button gm-button--primary" />
            <ui:Button name="btn-formation" text="К построению" class="gm-button gm-continue__secondary" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
