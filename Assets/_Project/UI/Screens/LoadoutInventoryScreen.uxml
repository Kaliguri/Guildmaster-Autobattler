<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:gm="Guildmaster.UI.Components" editor-extension-mode="False">
    <!-- Лоадаут/инвентарь — редизайн (Ф3a): ТОЛЬКО тело (боевая зона | грид таро-карточек | детали).
         Глобальный топбар забега (режимы/HP/золото/акт/таймер) — отдельный RunModeBar сверху (app-shell);
         тело сдвинуто под него через padding-top у .gm-loadout.
         Текст здесь — RU-плейсхолдер; локализованные строки проставляет LoadoutInventoryView (ключи ui.loadout.*). -->
    <!-- picking-mode Ignore на корне, теле и боевой «дырке» — чтобы panel.Pick над ними вернул null
         (ввод идёт в мир: юниты/камера под инвентарём). Панели .gm-loadout__main остаются перехватчиками. -->
    <ui:VisualElement name="loadout-root" class="gm-loadout" picking-mode="Ignore">

        <!-- ── Тело ── -->
        <ui:VisualElement class="gm-loadout__body" picking-mode="Ignore">

            <!-- Боевая зона-«дырка» (сквозная; прозрачна над персист-камерой). -->
            <ui:VisualElement name="battle-zone" class="gm-loadout__battle" picking-mode="Ignore">
                <ui:Label name="battle-hint" text="Живая расстановка" class="gm-loadout__battle-hint" picking-mode="Ignore" />
            </ui:VisualElement>

            <ui:VisualElement class="gm-loadout__main">
                <ui:VisualElement class="gm-loadout__cols">

                    <!-- Центр: фильтр-табы (центр) + поиск/сортировка + грид -->
                    <ui:VisualElement class="gm-loadout__center">
                        <ui:VisualElement class="gm-loadout__filters">
                            <!-- Фильтры-чипы (иконка + подпись): текст и активность ставит View. -->
                            <gm:Chip name="filter-relics" class="gm-filter-tab gm-filter-tab--relics" />
                            <gm:Chip name="filter-items" class="gm-filter-tab gm-filter-tab--items" />
                            <gm:Chip name="filter-banners" class="gm-filter-tab gm-filter-tab--banners" />
                        </ui:VisualElement>

                        <ui:VisualElement class="gm-loadout__toolbar">
                            <ui:TextField name="search" class="gm-loadout__search" />
                            <ui:Button name="sort" text="Имя ↓" class="gm-loadout__sort" />
                        </ui:VisualElement>

                        <ui:ScrollView name="relic-grid" style="flex-grow: 1;" />
                    </ui:VisualElement>

                    <!-- Правая панель: имя → теги → описание → видео → способности → улучшения → статы (внизу).
                         Порядок блоков по решению Макса; секции без своих рамок (единая панель + воздух). -->
                    <ui:VisualElement class="gm-loadout__detail">
                        <ui:Label name="detail-title" text="—" class="gm-loadout__detail-title" />
                        <ui:VisualElement name="detail-tags" class="gm-loadout__tags" />
                        <ui:Label name="detail-narrative" text="" class="gm-loadout__narrative-text" />
                        <ui:VisualElement class="gm-loadout__video">
                            <ui:Label name="video-hint" text="видео-вставка 16:9" class="gm-loadout__video-hint" />
                        </ui:VisualElement>
                        <ui:VisualElement class="gm-loadout__section">
                            <ui:Label name="skills-label" text="способности" class="gm-loadout__section-label" />
                            <ui:VisualElement name="detail-abilities" class="gm-loadout__abilities" />
                        </ui:VisualElement>
                        <ui:VisualElement class="gm-loadout__section">
                            <ui:Label name="upgrades-label" text="улучшения" class="gm-loadout__section-label" />
                            <ui:VisualElement class="gm-loadout__upgrades">
                                <ui:VisualElement name="upgrade-row-1" class="gm-loadout__upgrade-row" />
                                <ui:VisualElement name="upgrade-row-2" class="gm-loadout__upgrade-row" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <!-- Распорка отжимает статблок к низу панели. -->
                        <ui:VisualElement class="gm-loadout__spacer" />
                        <ui:VisualElement class="gm-loadout__section">
                            <ui:Label name="stats-label" text="характеристики" class="gm-loadout__section-label" />
                            <ui:VisualElement name="detail-stats" class="gm-loadout__stats" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                </ui:VisualElement>
            </ui:VisualElement>

        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
