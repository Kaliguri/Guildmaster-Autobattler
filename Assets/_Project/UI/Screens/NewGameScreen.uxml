<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:gm="Guildmaster.UI.Components" editor-extension-mode="False">
    <ui:VisualElement class="gm-screen">
        <ui:VisualElement class="gm-panel gm-panel--dialog gm-panel--menu">
            <gm:PanelFrame name="newgame-frame" corner="0" />
            <ui:Label name="newgame-title" text="Создать игру" class="gm-text-title gm-panel__title" />
            <ui:VisualElement class="gm-divider" />

            <!-- Тело диалога — ScrollView, а не VisualElement: переполнение обязано уходить в
                 прокрутку. Обычная коробка при нехватке места сжимает содержимое, и то рисуется
                 поверх соседей (04.08.2026: подсказка режима легла на кнопку PvP). -->
            <ui:ScrollView class="gm-panel__body">
                <!-- Открытость для друзей — свойство СЕАНСА, а не режима, поэтому галочка стоит ВЫШЕ
                     режимов: сначала «с кем играем», потом «во что». Под кнопкой-действием она
                     читалась бы как настройка этой кнопки. -->
                <gm:ToggleRow name="toggle-lobby" label-text="Создать онлайн-лобби" value="true" />
                <ui:Label name="lobby-hint" class="gm-text-caption gm-text--muted gm-newgame__hint" />

                <ui:VisualElement class="gm-divider" />

                <!-- Три режима, и каждый — ДЕЙСТВИЕ: клик уводит дальше, поэтому кнопки «Начать»
                     здесь нет. PvP и Ристалище — одно занятие с разными ограничениями, но выбирает
                     игрок игру, а не устройство движка. -->
                <ui:VisualElement name="mode-list" class="gm-newgame__modes">
                    <gm:PlateButton name="btn-mode-campaign" text="Кампания" class="gm-button gm-button--primary" />
                    <gm:PlateButton name="btn-mode-grounds" text="Ристалище" class="gm-button" />
                    <gm:PlateButton name="btn-mode-pvp" text="PvP" class="gm-button" />
                </ui:VisualElement>

                <!-- Пояснение идёт за курсором, а не за выбором: выбора на экране больше нет. -->
                <ui:Label name="mode-hint" class="gm-text-caption gm-text--muted gm-newgame__hint" />
            </ui:ScrollView>

            <ui:VisualElement class="gm-divider" />
            <gm:PlateButton name="btn-back" text="Назад" class="gm-button" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
