/* ============================================================================
 * Dev battle picker — компактный дев-инструмент запуска боёв (F2).
 * Реюзает семантические gm-токены (тема лежит на PanelSettings), но задаёт
 * СВОИ компактные размеры: игровой .gm-panel требует min-width 260px, а на
 * референсе 640×360 это почти полэкрана — для дев-списка не годится.
 * ========================================================================== */

.gm-dev-overlay {
    position: absolute;
    left: var(--gm-space-2);
    top: var(--gm-space-2);
}

.gm-dev-panel {
    background-color: var(--gm-color-surface-panel);
    border-width: var(--gm-border-1);
    border-color: var(--gm-color-border-frame);
    padding: 4px 6px;
    width: 150px;
    max-height: 248px;
    overflow: hidden; /* клип содержимого ScrollView, чтобы контент не вылезал за рамку вбок */
}

.gm-dev-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.gm-dev-title {
    color: var(--gm-color-accent);
    font-size: 11px;
    -unity-font-style: bold;
}

.gm-dev-hint {
    color: var(--gm-color-text-muted);
    font-size: 8px;
}

.gm-dev-rule {
    height: 1px;
    background-color: var(--gm-color-border-subtle);
    margin-top: 3px;
    margin-bottom: 2px;
}

.gm-dev-scroll {
    flex-shrink: 1;
    /* Без min-height:0 flex-элемент не сжимается меньше контента (min-height:auto),
       поэтому список вываливается за панель вместо внутреннего скролла. */
    min-height: 0;
}

/* Тонкий тёмный скроллбар без стрелок вместо жирного дефолтного (он ел ~40px и уродовал панель). */
.gm-dev-scroll .unity-scroller--vertical {
    width: 6px;
}
.gm-dev-scroll .unity-scroller__low-button,
.gm-dev-scroll .unity-scroller__high-button {
    display: none;
}
.gm-dev-scroll .unity-scroller--vertical .unity-base-slider__tracker {
    background-color: rgba(0, 0, 0, 0.25);
    border-width: 0;
    margin: 0;
}
.gm-dev-scroll .unity-scroller--vertical .unity-base-slider__dragger {
    background-color: var(--gm-color-border-frame);
    border-width: 0;
    border-radius: 0;
    width: 6px;
    left: 0;
}

.gm-dev-section {
    color: var(--gm-color-text-muted);
    font-size: 8px;
    -unity-font-style: bold;
    margin-top: 4px;
    margin-bottom: 1px;
}

.gm-dev-empty {
    color: var(--gm-color-text-muted);
    font-size: 9px;
    white-space: normal;
    padding-top: 4px;
    padding-bottom: 4px;
}

.gm-dev-row {
    flex-direction: row;
    align-items: center;
    padding-top: 1px;
    padding-bottom: 1px;
    padding-left: 3px;
    border-left-width: 2px;
    border-left-color: rgba(0, 0, 0, 0);
}

.gm-dev-row:hover {
    background-color: var(--gm-color-hover-surface);
}

.gm-dev-row--active {
    background-color: var(--gm-color-hover-surface);
    border-left-color: var(--gm-color-accent);
}

.gm-dev-row__label {
    flex-grow: 1;
    flex-shrink: 1;
    color: var(--gm-color-text);
    font-size: 10px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    margin-right: 4px;
}

.gm-dev-play {
    background-color: var(--gm-color-surface-raised);
    border-width: var(--gm-border-1);
    border-color: var(--gm-color-border-frame);
    color: var(--gm-color-text);
    font-size: 9px;
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 5px;
    padding-right: 5px;
    margin: 0;
    min-width: 30px;
    flex-shrink: 0;
}

.gm-dev-play:hover {
    background-color: var(--gm-color-hover-surface);
    border-color: var(--gm-color-hover-border);
}

.gm-dev-play:active {
    background-color: var(--gm-color-accent);
    border-color: var(--gm-color-accent-active);
    color: var(--gm-color-text-on-accent);
}
