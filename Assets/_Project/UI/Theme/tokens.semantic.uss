/* ============================================================================
 * Дизайн-токены — ЯРУС 2: SEMANTIC (смысловые роли).
 * Ссылается ТОЛЬКО на primitives. Компоненты (components.uss) консюмят ТОЛЬКО этот ярус.
 * Сменить всю тему = поправить значения здесь. Требует tokens.primitives.uss раньше в списке.
 * ========================================================================== */
:root {
    /* --- Поверхности --- */
    /* ЕДИНОЕ затемнение под любым UI поверх мира — один токен на проект, исключений нет (реш. Макса
       2026-07-26). Мир за экраном должен читаться всегда: и за наградой, и за меню, и за паузой.
       Читаемость держит непрозрачная панель, а не заливка всего экрана. Модалка поверх модалки своё
       затемнение не рисует — для этого есть .gm-screen--scrimless, иначе слои складываются. */
    --gm-color-scrim: rgba(0, 0, 0, 0.42);
    /* НЕПРОЗРАЧНАЯ заслонка — не оттенок scrim, а другая роль: закрыть мир насовсем, а не приглушить
       его под панелью. Нужна ровно там, где под UI больше нечего показывать (закрытие игры): без неё
       снятое меню открывает пустую арену, и последние секунды игрок смотрит на её фон. */
    --gm-color-veil: var(--gm-ink-900);
    /* ЛОКАЛЬНОЕ затенение под колонкой текста, лежащего прямо на кадре игры (главное меню поверх
       боя). Третья роль рядом с предыдущими двумя, и разводить их обязательно: scrim гасит ВЕСЬ
       кадр под панелью, veil закрывает его насовсем, а этот — держит контраст ОДНОЙ колонки, не
       трогая остальные две трети экрана. Так делают пятеро рефов из восьми, кладущих меню на фон
       (`_teardowns/01-main-menu.md`, приём 5); трое остальных платят за отказ читаемостью.
       Значение задано rgba напрямую — как scrim и поверхность консоли: прозрачность здесь часть
       роли, а var() внутрь rgba() USS не пускает. Оттенок обязан оставаться ступенью ink-900
       (R > G > B): вуаль на тёплом кадре не имеет права холодить его. */
    /* Тон, а не альфа (правка 05.08.2026, «усиль вуаль»). Прежние rgba(45,39,31,0.65) при замере
       давали у кромки (62,61,26) на траве (85,87,18) — перепад 27%, который глаз читает как
       естественный градиент луга, а не как подложку. Причина была не в альфе: на 0.65 вуаль уже
       красила почти в полную силу, просто её собственный тон стоял вровень с фоном. Отсюда правка
       вниз по светлоте — (48,46,18) у кромки, перепад 44%. */
    --gm-color-menu-shade: rgba(28, 24, 19, 0.78);
    /* Своего scrim у главного меню НЕТ намеренно: оно берёт общий --gm-color-scrim, как все экраны
       поверх мира. Заведённый было отдельный токен (табак 0.18-0.30) прожил один вечер и умер о факт:
       табак светлее чёрного, и та же цифра приглушает кадр почти вдвое слабее — «приглушения не видно
       вообще» (Макс, 04.08.2026). Держать роль, которая отличается от общей только тем, что хуже
       работает, незачем. */
    /* --- ДВА РЕГИСТРА ПОВЕРХНОСТЕЙ (реш. Макса 2026-08-02) ---
       Мир и забег (инвентарь, лавка, награда, карта) — ГРОССБУХ: непрозрачное дерево, латунь,
       пергамент. Мета-слой (главное меню, пауза, настройки) — СИСТЕМА: тёмное стекло, сквозь
       которое виден мир, свет вместо рамки, минимум границ.
       Регистр выбирается по СМЫСЛУ экрана, а не по вкусу: меню — не комната гильдии, а интерфейс,
       через который в неё входят. Поэтому «стеклянный» вид не спорит с гроссбухом, а размечает
       границу между миром и метой. Смешивать регистры на одном экране нельзя. */
    --gm-color-surface-glass: var(--gm-glass-900);
    --gm-color-glass-rim: var(--gm-glass-rim);

    --gm-color-surface-panel: var(--gm-ink-700);   /* тело панели */
    --gm-color-surface-raised: var(--gm-ink-600);  /* кнопки/поднятые блоки */
    --gm-color-surface-sunken: var(--gm-ink-800);  /* утопленные блоки */

    /* --- Рамки --- */
    --gm-color-border-frame: var(--gm-brass-500);  /* латунная рамка ПАНЕЛИ (мебель интерфейса) */
    /* Кайма того, что НАЖИМАЮТ. Патина, а не латунь: решение 04.08.2026 развело роли — латунь значит
       «это ценно», патина «сюда нажать», и кнопка в латунной кайме заявляла ровно не то. Латунь на
       кнопках была легаси прежней гаммы, где всё подряд было латунным. */
    /* Кайма кнопки В ПОКОЕ — приглушённая: контур очерчивает форму, а не зовёт. Насыщенную патину
       (400) она держала на всех пяти кнопках разом, и та была самым ярким пикселем экрана, спорящим
       и с текстом, и с вывеской. Яркость теперь принадлежит СОСТОЯНИЮ (реш. Макса 05.08.2026). */
    --gm-color-border-action: var(--gm-patina-outline);
    /* Наведение и фокус — вот где патина имеет право звенеть. Но не 300-й ступенью: она снята для
       ТОНКИХ линий на тёмном поле и после починки гаммы читается неоном. */
    --gm-color-border-action-strong: var(--gm-patina-outline-lit);
    --gm-color-border-inner: var(--gm-brass-700);  /* внутренняя линия рамки */
    /* Тихий контур. НЕ ink-300: тот сливался с панелью (контраст 1.67 при норме 3.0) —
       «тихий» читалось как «невидимый». ink-100 даёт 3.43: контур виден, но не спорит с латунью. */
    --gm-color-border-subtle: var(--gm-ink-100);

    /* --- АУТЛАЙН: ЕДИНЫЙ источник правды для всех рамок интерфейса (реш. Макса 2026-07-25) ---
       В проекте ровно ТРИ разновидности контура, других заводить нельзя. Пиксель-рамки Honeti
       (9-slice WindowStroke/GoldOutlined/Inactive) из рамок выведены: при -unity-slice-scale 2-3px
       они давали ~16px кайму, слоты и кнопки читались «в толстой оправе». Заливки Honeti (Gold2 —
       латунная плашка primary) остаются: это ФОН, а не контур.
         strong — акцентный контур: панели, видео-вставка, таро-карта, primary-кнопка, активный таб;
         subtle — тихий контур: поля ввода, вторичные кнопки, слоты, утопленные блоки;
         inner  — вторая кайма ВНУТРИ уже обведённого блока (таро-рамка вокруг арта). */
    --gm-outline-width: var(--gm-border-1);                    /* 2px — одна толщина на весь UI */
    --gm-outline-color: var(--gm-color-border-frame);          /* сильный (эталон — видео-вставка) */
    --gm-outline-color-subtle: var(--gm-color-border-subtle);  /* тихий (эталон — поле поиска) */
    --gm-outline-color-inner: var(--gm-color-border-inner);    /* внутренняя кайма */
    --gm-outline-color-hover: var(--gm-color-hover-border);    /* наведение на любой из трёх */

    /* Ширина вертикального скроллбара. Живёт токеном, потому что её должны знать ДВОЕ: сам скроллбар
       и всё, что обязано встать вровень с прокручиваемым содержимым (тулбар над гридом карт). */
    --gm-scrollbar-width: 14px;

    /* --- Размеры таро-карточки и ряда карт ---
       Ширина колонки инвентаря РАНЬШЕ была литералом 642px с комментарием «4 карты + зазоры +
       padding + скроллбар». Сумма была подобрана на глаз и оказалась на 4px больше настоящей —
       из-за чего тулбар над гридом не сходился с картами (находка Макса, п.7, три захода).
       Теперь ряд карт объявлен ОДИН раз здесь, а колонка берёт ширину по нему. Хочешь 5 карт в
       ряду — правишь --gm-grid-columns, и тулбар переезжает сам. */
    /* Сами значения --gm-card-width / --gm-card-gap лежат в ярусе примитивов (шкала размеров).
       Число колонок вписано в формулу ширины колонки в components.uss. */

    /* --- ГОЛОСА ИНТЕРФЕЙСА: две гарнитуры, роли разведены по смыслу, а не по кеглю ---
       ГОВОРИТ игра (`voice`) — сериф: титул экрана, подпись кнопки, имя сущности, заголовок секции.
       ПОКАЗЫВАЕТ игра (`data`) — гротеск: числа, статы, подписи полей, служебный текст, ввод.
       Разделение именно такое, потому что сериф несёт ХАРАКТЕР, а гротеск — ТОЧНОСТЬ: цифру статблока
       антиква со старостильными знаками сделала бы прыгающей, а кнопку гротеск делает веб-формой.
       До 2026-08-02 сериф стоял ровно в одном селекторе (`.gm-panel__title`), и голос заголовка
       расходился с голосом всего, что под ним — это и читалось «интерфейс не наш».
       `voice-italic` — нарратив (флейвор реликвий): та же антиква курсивом, отдельная роль, потому
       что это ГОЛОС МИРА, а не интерфейса, и разойтись с `voice` он вправе. */
    /* Название игры: тяжёлая дисплейная на самом слове, антиква — на надстрочнике и метке версии.
       Роль отдельная от --gm-font-voice: голос интерфейса и вывеска игры это разные вещи, и менять
       их надо порознь. */
    --gm-font-wordmark: var(--gm-typeface-display);
    --gm-font-inscription: var(--gm-typeface-inscription);

    --gm-font-voice: var(--gm-typeface-serif);
    --gm-font-voice-italic: var(--gm-typeface-serif);
    --gm-font-data: var(--gm-typeface-sans);
    --gm-font-data-strong: var(--gm-typeface-sans-bold);
    --gm-font-code: var(--gm-typeface-mono);

    /* --- Текст --- */
    --gm-color-text: var(--gm-parchment-100);
    --gm-color-text-muted: var(--gm-parchment-300);
    --gm-color-text-on-accent: var(--gm-ink-800);  /* текст на латунной заливке */
    /* ТЕКСТ-ДЕЙСТВИЕ: подпись, которая сама и есть кнопка — там, где заливки нет вовсе (пункты
       главного меню лежат прямо на кадре). Патина, потому что роль та же самая: «сюда нажать».
       Отдельно от --gm-color-hover-border и --gm-color-focus-ring намеренно: те про КАЙМУ, и
       красить ими текст значило бы завести один токен с двумя смыслами. */
    --gm-color-text-action: var(--gm-patina-300);
    /* Подпись НА интерактивном элементе (кнопка-пластина, чип) в покое и при нажатии. Латунь, а не
       патина: сама кнопка уже заявляет о себе формой и каймой, а подпись — её содержимое. */
    --gm-color-text-interactive: var(--gm-brass-200);
    --gm-color-text-interactive-dim: var(--gm-brass-300);
    /* ЦЕННОСТЬ прописью: валюта, цена, добыча, глиф сундука. Прямое следствие разделения ролей
       04.08.2026 — brass значит «это ценно», patina значит «сюда нажать». До этой роли цена в лавке
       ссылалась на ступень рампы, то есть заявляла цвет без смысла. */
    --gm-color-value: var(--gm-brass-300);
    /* Оправа ЦЕННОГО объекта (сундук) и она же под курсором. Не border-frame: та про мебель
       интерфейса, а здесь кайма сообщает, что внутри добыча. */
    --gm-color-border-value: var(--gm-brass-400);
    --gm-color-border-value-hover: var(--gm-brass-300);
    /* Акцентный заголовок экрана (итоги боя) и номер карты — крупная латунная метка, которая НЕ
       является ни ценностью, ни действием. */
    --gm-color-heading-accent: var(--gm-brass-300);
    /* Тёмный контур вокруг образца ПРОИЗВОЛЬНОГО цвета (плитка цвета профиля, точка участника).
       Роль существует потому, что цвет внутри задаёт игрок: без тёмной обводки светлый образец
       растворяется в панели, а тёмный — в её тени. */
    --gm-color-swatch-outline: var(--gm-ink-900);
    --gm-color-display-accent: var(--gm-brass-200); /* hero-лого экрана загрузки: ярче обычного акцента */
    /* ТИХАЯ половина вывески: надстрочник, линейки, метка версии.
       ПАТИНА, А НЕ ЛАТУНЬ (решение Макса 05.08.2026, отменяет прежнее правило этой строки). Раньше
       здесь стояла латунь по рассуждению «патина значит сюда нажать, а название нажать нельзя»;
       Макс это рассуждение отверг в пользу единства картинки: вывеска должна быть из того же
       материала, что пластины под ней. Сигнал действия при этом не размывается — его несёт не
       оттенок сам по себе, а ФОРМА: пластина, кайма, сдвиг при наведении. Ничего этого у надписи
       нет, и спутать её с кнопкой нельзя.
       Ступень 500, а не тон самой пластины: у заливки кнопки тот же тон (h=185, s=76%), но светлота
       23-33% — ровно как у травы под вывеской после вуали, и текст на ней исчезает. Совпадает
       поэтому тон, а глубину доигрывают градиент и обводка. */
    --gm-color-display-accent-quiet: var(--gm-patina-500);
    /* Обводка вывески — тёмная и ТЁПЛАЯ, одна на все три строки. Нужна потому, что вывеска лежит
       прямо на живом кадре боя, где яркость под буквами меняется каждый кадр: без контура надпись
       то читается, то тонет. Тёплый ink, а не холодная кайма пластины: обводка играет роль тени на
       кадре, а тени у нас тёплые (то же рассуждение, что у вуали — она не имеет права холодить
       кадр). Ширина живёт в компоненте: она зависит от кегля и гарнитуры, не от роли. */
    --gm-color-display-outline: var(--gm-ink-900);
    /* НЕЙТРАЛЬ ПОД ГРАДИЕНТ. Градиент текста в UI Toolkit не заменяет цвет, а УМНОЖАЕТСЯ на него,
       поэтому у элемента с градиентом цвет обязан быть белым — иначе пресет потемнеет вдвое и
       перестанет совпадать с задуманными ступенями. Это не «цвет мимо палитры», а единица
       умножения, и роль заведена, чтобы это было видно из USS без чтения комментария. */
    --gm-color-text-gradient-base: rgb(255, 255, 255);
    /* Ряд атрибуций бут-экрана: и подпись, и тинт знаков. Роль отдельная от text-muted именно
       потому, что она НЕ про приглушённый текст, а про «строку чужих брендов», где нейтраль —
       требование, а не вкус (см. --gm-neutral-300). */
    --gm-color-brand-attrib: var(--gm-neutral-300);

    /* --- Поверхность главного действия — ПАТИНА (реш. Макса 2026-08-04).
           ЭТО ОТМЕНЯЕТ решение 2026-07-25 «primary остаётся тёмной, инверсия ломает язык».
           Тогда выбор стоял между тёмным полем с латунной подписью и латунной плашкой с тёмным
           текстом — и вторая читалась чужой, потому что латунь в интерфейсе значила «ценно».
           Теперь у действия свой цвет, отдельный от ценности, и заливка перестала быть инверсией:
           бирюзовое поле не спорит с латунью, а противопоставлено ей по смыслу.
           Ступени идут ВВЕРХ по яркости от покоя к наведению — нажатие гасит. --- */
    /* Поле кнопки действия: свет ПАДАЕТ СВЕРХУ и размах у градиента настоящий (реш. Макса
       05.08.2026 по показу трёх вариантов живьём). До этого верх и низ стояли на соседних тёмных
       ступенях (800 -> 700), и пять кнопок читались плоскими чёрными плашками — вывод «зовёт оттенок,
       а не яркость» остался, но он про то, что поле не становится ярким ПЯТНОМ, а не про то, что
       объёма быть не должно. */
    --gm-color-surface-accent: var(--gm-patina-900);
    /* Наведение поднимает ОБА конца примерно в полтора раза — заметно, но кнопка остаётся в своей
       тёмной зоне. Ступени рампы (500/700) сюда больше не годятся: после снятия двойной конверсии
       они рисуются во всю силу и дают то самое «пятно краски». */
    --gm-color-surface-accent-hover: var(--gm-patina-hover);
    --gm-color-surface-accent-hover-far: var(--gm-patina-hover-far);
    --gm-color-surface-accent-active: var(--gm-patina-950);
    /* ПАРЫ ГРАДИЕНТНОЙ ЗАЛИВКИ — ближний и дальний конец. Пар всего две на весь интерфейс (обычная
       плашка и плашка действия): меняется не цвет, а откуда градиент идёт и какого он типа.
       Значения выставлены по ЗАМЕРУ Guildrun 04.08.2026, а не на глаз: у рефа поле кнопки светлеет
       книзу на 44% (яркость 22 -> 33), у нас было -15%, то есть темнело и втрое слабее — на экране
       это читается как «градиента нет». Направление здесь и есть смысл: свет падает снизу, от стола. */
    --gm-color-surface-plate: var(--gm-ink-800);
    --gm-color-surface-plate-far: var(--gm-ink-600);
    /* ПОДСВЕЧЕННАЯ плашка — та же пара, сдвинутая на ступень вверх. Наведение поднимает всё поле, а
       не подменяет градиент сплошной заливкой: иначе при наведении пластина теряет объём ровно в тот
       момент, когда на неё смотрят. */
    --gm-color-surface-plate-lit: var(--gm-ink-700);
    --gm-color-surface-plate-lit-far: var(--gm-ink-500);
    --gm-color-surface-accent-far: var(--gm-patina-950);
    /* ПЕРВИЧНОЕ ДЕЙСТВИЕ — поле на ступень светлее при том же тоне и том же размахе градиента
       (приём рефов: одна плашка красится, остальные нет — Factorio красит «Продолжить», AoW4 две
       верхние). Именно ступень рампы, а не отдельный оттенок: первичность обязана читаться как
       «та же кнопка, только громче», иначе на экране появляется второй цвет действия.
       Дальше 700-й ступени не идём намеренно — там начинается зона наведения (patina-hover), и
       кнопка в покое стала бы выглядеть уже наведённой. */
    --gm-color-surface-accent-lit: var(--gm-patina-700);

    /* --- Акцент (патина) — контуры и подписи первичных действий.
           Тонкие линии берут 400-ю ступень, а не 500-ю: насыщенный холод на тёплом фоне вибрирует
           именно на однопиксельном крае, и это единственное место, где разница заметна. --- */
    --gm-color-accent: var(--gm-patina-400);
    --gm-color-accent-active: var(--gm-patina-300);

    /* --- Смысловые акценты (правило «тёплого света»: цвет допустим любой, но приглушённый
           и с тёплым замесом; каркас интерфейса при этом остаётся ink/brass/parchment).
           Роли названы по СМЫСЛУ, а не по цвету — «положительное», а не «зелёное»:
           перекрасить их потом можно в одном месте, не переписывая компоненты. --- */
    --gm-color-positive: var(--gm-moss-400);       /* прирост стата, успех, лечение */
    --gm-color-negative: var(--gm-danger-400);     /* падение стата, урон, отказ */
    --gm-color-info: var(--gm-storm-300);          /* нейтральная подсветка, «выбрано» без похвалы */
    --gm-color-arcane: var(--gm-wine-400);         /* магическое: аркана, зачарование */

    /* --- Деструктив --- */
    --gm-color-danger: var(--gm-danger-500);

    /* Предупреждение — своя роль, а не «акцент»: жёлтая строка лога значит «посмотри», тогда как
       латунный акцент значит «это можно нажать». Один цвет на две роли путал бы их в первом же выводе. */
    --gm-color-warning: var(--gm-brass-300);

    /* --- Интерактив: hover/фокус. Уведены в патину 2026-08-04 вместе с акцентом: наведение и
           фокус — это про «сюда можно нажать», то есть та же роль действия, а не ценности. --- */
    --gm-color-hover-surface: var(--gm-ink-500);
    --gm-color-hover-border: var(--gm-patina-400);
    --gm-color-focus-ring: var(--gm-patina-300);
    /* Выключенный текст — выцветший ПЕРГАМЕНТ, а не цвет дерева: он всё ещё текст и обязан
       читаться (4.57 вместо прежних 1.67). «Выключено» показывают тусклость + отсутствие отклика. */
    --gm-color-disabled-text: var(--gm-parchment-400);

    /* --- Слайдер --- */
    --gm-color-track: var(--gm-ink-500);
    --gm-color-handle: var(--gm-brass-300);
    --gm-color-handle-border: var(--gm-brass-700);

    /* --- Размер диалоговой панели: главное меню, ESC-меню и настройки — ОДНО окно (п.10 раунда 4).
           Раньше у каждой был свой размер, и панели прыгали при переходе между ними — заметнее
           всего потому, что открываются они одна из другой.

           ЗАВИСИМОСТЬ ПЕРЕВЁРНУТА: не панель растёт под контент, а контент занимает панель.
           У диалога есть тело `.gm-panel__body`, которое забирает остаток высоты и прокручивается,
           если содержимого больше. Поэтому число здесь — просто удобный размер окна, а не подгонка
           под самый длинный экран: новая опция в настройках больше не меняет габариты диалогов. --- */
    /* Укрупнено 2026-07-27 (Макс): прежние 640×680 на канве 1920×1080 занимали треть ширины и
       читались мелко. Растёт ОДНО число — и меню, и ESC, и настройки, потому что габариты у них
       общие. Настройкам это заодно дало место под разделы слева. */
    --gm-dialog-width: 1280px;
    /* НИЖНЯЯ граница: рост диалога от неё, а не жёсткий размер. Пока контента мало, все диалоги
       одинаковы — ради этого габариты сюда и переезжали. */
    --gm-dialog-height: 860px;
    /* ВЕРХНЯЯ граница: дальше растёт не панель, а прокрутка её тела. 980 из 1080 канвы — панель
       остаётся в кадре с полем по краям, а не упирается в кромку экрана. */
    --gm-dialog-max-height: 980px;

    /* --- Инсеты/шкала (алиасы под компоненты) --- */
    /* Восемь токенов отсюда сняты (аудит 2026-07-26, волна 3): --gm-color-divider, -accent-hover,
       -positive-dim, -info-dim, -danger-hover, -track-fill, --gm-inset-control, --gm-gap-stack.
       Их не читал ни один стиль, то есть при правке палитры они молча оставались от прежней —
       а обещание «такая роль у нас есть» продолжали давать. Вернуть — вместе с потребителем. */
    --gm-inset-panel: var(--gm-space-5);

    /* Токенов редкости реликвий здесь тоже больше нет: рамку по редкости рисовал RelicCard.SetRarity,
       которого никто не звал (аудит 2026-07-26, волна 2). Вернуть — когда редкость начнёт что-то
       значить на экране; примитивы (ink / brass) для этого никуда не делись. */

    /* --- Бой ---
       Свет боя: вспышки по школе урона, исцеление, полосы HP и щита. Читает их не стиль, а тот же
       снимок палитры, что и карта. Оттенки взяты из боевых конфигов без правки — палитра здесь
       становится владельцем УЖЕ выбранного цвета, а не переназначает его.
       HDR-цвета (осколки, вспышка смерти, голограмма) сюда НЕ переезжают: у них компоненты больше
       единицы, и это не оттенок, а яркость свечения — она живёт в CombatFeelConfig рядом с прочими
       числами джуса. */
    --gm-color-combat-flash-physical: var(--gm-flare-white);
    --gm-color-combat-flash-magical: var(--gm-flare-amber);
    --gm-color-combat-flash-true: var(--gm-flare-gold);
    --gm-color-combat-flash-poison: var(--gm-flare-venom);
    --gm-color-combat-flash-light: var(--gm-flare-halo);
    --gm-color-combat-flash-dark: var(--gm-flare-violet);
    --gm-color-combat-heal: var(--gm-flare-mint);
    --gm-color-combat-hp-ally: var(--gm-flare-leaf);
    --gm-color-combat-hp-enemy: var(--gm-flare-rust);
    --gm-color-combat-shield: var(--gm-flare-ice);
    /* Цвет ЩИТА в момент, когда он сработал (решение Макса 31.07.2026). Это НЕ цвет интерфейса защиты:
       полоса и цифра поглощённого остаются ледяными, золото живёт только на теле юнита. Роли две именно
       поэтому — один токен на оба места запретил бы им разойтись. Honey, а не gold: нужен насыщенный
       жёлтый, потому что блок читается затемнением тела вокруг, а не яркостью самого щита. */
    --gm-color-combat-block-flash: var(--gm-flare-honey);
    /* Вспышка удара «вообще» — когда школьная раскраска выключена тумблером. Роль отдельная от
       физической школы намеренно: примитив у них один, но смысл разный, и разойтись они вправе. */
    --gm-color-combat-flash-neutral: var(--gm-flare-white);
    /* Холодный пересвет: осколки смерти и вспышка перед расколом. Один оттенок, ДВЕ яркости —
       множители живут в CombatFeelConfig, потому что это сила свечения, а не цвет. */
    --gm-color-combat-overbright: var(--gm-flare-frost-white);
    --gm-color-combat-hologram: var(--gm-flare-holo);
    /* Порез на теле — вскрытое, а не брызги: у нас крови нет, вместо неё светящаяся красная прореха
       (реф SAO). Цвет ОДИН на всех, включая костяных и конструктов: единый читается проще, а разведение
       по видам (костная пыль, каменная крошка) — возможная будущая правка, а не сегодняшняя. Яркость
       свечения накручивает CombatFeelConfig множителем, как у пересвета: сюда HDR не едет. */
    --gm-color-combat-cut: var(--gm-flare-wound);

    /* --- Мейн-цвета игроков ---
       Чем игрок опознаётся в коопе: курсор, подпись имени, метки узлов, аватарка в списке участников.
       Место в наборе раздаёт состав сеанса (`ISessionRoster.ColorIndex`), а какой это оттенок — решает
       палитра: цвет остаётся с одним владельцем даже когда едет по сети.
       Четыре — предел кооп-сессии, и они выбраны так, чтобы различаться на ТРЁХ фонах сразу (арена,
       карта акта, двор), а не только в меню: пары «синий-голубой» и «зелёный-лаймовый» отвергнуты
       именно поэтому. */
    --gm-color-player-1: var(--gm-flare-azure);
    --gm-color-player-2: var(--gm-flare-honey);
    --gm-color-player-3: var(--gm-flare-amethyst);
    --gm-color-player-4: var(--gm-flare-mint);

    /* --- Оттенки бойцов ---
       Чем светит конкретный юнит: снаряд, его след, контур каста, искры, осколки. Роли названы по
       СМЫСЛУ оттенка, а не по юниту: `UnitData` держит ссылку на роль, а «кому какая» решает дизайн
       (gdd/10-vision/vfx-color §Ростер). Роль на каждого героя превратила бы палитру во второй реестр
       контента, а повторять оттенок между юнитами разрешено прямо — героя от врага отличает полоса HP.
       Здесь LDR-база; HDR-яркость накручивает CombatColorPalette множителями. */
    --gm-color-unit-fire: var(--gm-flare-fire);
    --gm-color-unit-gold: var(--gm-flare-honey);
    --gm-color-unit-light: var(--gm-flare-halo);
    --gm-color-unit-lime: var(--gm-flare-lime);
    --gm-color-unit-grass: var(--gm-flare-grass);
    --gm-color-unit-emerald: var(--gm-flare-emerald);
    --gm-color-unit-wind: var(--gm-flare-cyan);
    --gm-color-unit-frost: var(--gm-flare-azure);
    --gm-color-unit-steel: var(--gm-flare-steel);
    --gm-color-unit-shadow: var(--gm-flare-amethyst);
    --gm-color-unit-venom: var(--gm-flare-venom);
    --gm-color-unit-bog: var(--gm-flare-bog);
    --gm-color-unit-iron: var(--gm-flare-copper);
    --gm-color-unit-dust: var(--gm-flare-dust);
    --gm-color-unit-neutral-warm: var(--gm-flare-tallow);
    --gm-color-unit-neutral-cool: var(--gm-flare-chalk);

    /* --- Приглушения тела ---
       Тинт умножается на готовый спрайт, поэтому это не «цвет юнита», а различитель тех, кто носит
       ОДИН арт: один из группы остаётся без тинта, остальные берут ступень отсюда. Ступеней три —
       больше на цветном арте не различить (UnitTintPolicyTests сторожит и это). */
    --gm-color-unit-dim-ash: var(--gm-dim-ash);
    --gm-color-unit-dim-verdant: var(--gm-dim-verdant);
    --gm-color-unit-dim-tan: var(--gm-dim-tan);

    /* --- Dev-консоль (Трек К) ---
       Полка консоли лежит ПОВЕРХ живого кадра, поэтому её поверхность полупрозрачна: инструмент не
       должен отбирать у разработчика то, что он в этот момент разглядывает. Значение задано rgba
       напрямую (как --gm-color-scrim), потому что прозрачность здесь — часть роли, а не оттенок.
       Оттенок при этом ОБЯЗАН лежать на рампе ink (R > G > B): это ступень ниже --gm-ink-900, а не
       свой цвет. Первая редакция была rgba(10, 12, 14) — синева, чужая всему остальному интерфейсу;
       заметно её стало только рядом с тёплыми панелями.
       Пересчитано 2026-08-04: рампа ink вынута из черноты, и без ручной правки консоль осталась бы
       единственной чёрной поверхностью среди тёплых — литерал автоматически не едет. */
    --gm-color-console-surface: rgba(38, 32, 26, 0.97);

    /* Призрачная подсказка в поле ввода консоли — та часть команды, которую предлагает автодополнение.
       Заведена ролью 2026-08-04: значение стояло литералом прямо в .gm-console__ghost, то есть в
       компоненте и мимо обоих ярусов. */
    --gm-color-text-ghost: var(--gm-parchment-500);

    /* Дорожка скроллера консоли. Тоже стояла литералом в компоненте — и притом ЧИСТО БЕЛЫМ
       (rgba(255,255,255,0.04)), то есть единственной холодной вещью в тёплом интерфейсе. Ровно на
       этом уже обжигались с самой полкой консоли: холодный оттенок в полупрозрачном элементе
       незаметен в одиночку и вылезает рядом с тёплыми панелями. Альфа здесь часть роли — дорожка
       обязана просвечивать, — поэтому значение остаётся rgba, но лежит на рампе ink (R > G > B). */
    --gm-color-console-track: rgba(176, 159, 141, 0.06);

    /* --- Карта акта ---
       Карта живёт в мире, а не в UITK, поэтому эти роли читает не стиль, а ассет палитры
       (GuildmasterPalette.asset, собирается из этого файла). Смысл тот же, что у прочей семантики:
       цвет принадлежит палитре, а MapStyle только называет роль. Раньше он держал собственные
       Color-поля и трижды разошёлся с токенами, которые сам же называл в подсказках (аудит T-7). */
    --gm-color-map-node-backing: var(--gm-ink-650);
    --gm-color-map-node-rim: var(--gm-brass-500);
    --gm-color-map-current-marker: var(--gm-brass-200);
    --gm-color-map-icon-shadow: var(--gm-ink-700);
    --gm-color-map-icon-light: var(--gm-parchment-50);
    --gm-color-map-path-idle: var(--gm-parchment-500);
    --gm-color-map-path-travelled: var(--gm-brass-500);
    --gm-color-map-path-available: var(--gm-brass-200);
    --gm-color-map-pawn: var(--gm-parchment-60);
}
