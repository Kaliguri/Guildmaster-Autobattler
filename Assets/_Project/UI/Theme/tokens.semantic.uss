/* ============================================================================
 * Дизайн-токены — ЯРУС 2: SEMANTIC (смысловые роли).
 * Ссылается ТОЛЬКО на primitives. Компоненты (components.uss) консюмят ТОЛЬКО этот ярус.
 * Сменить всю тему = поправить значения здесь. Требует tokens.primitives.uss раньше в списке.
 * ========================================================================== */
:root {
    /* --- Поверхности --- */
    /* ЕДИНОЕ затемнение под любым UI поверх мира — один токен на проект, исключений нет (реш. Макса
       2026-07-26). Мир за экраном должен читаться всегда: и за наградой, и за меню, и за паузой.
       Читаемость держит непрозрачная панель, а не заливка всего экрана. Модалка поверх модалки своё
       затемнение не рисует — для этого есть .gm-screen--scrimless, иначе слои складываются. */
    --gm-color-scrim: rgba(0, 0, 0, 0.42);
    --gm-color-surface-panel: var(--gm-ink-700);   /* тело панели */
    --gm-color-surface-raised: var(--gm-ink-600);  /* кнопки/поднятые блоки */
    --gm-color-surface-sunken: var(--gm-ink-800);  /* утопленные блоки */

    /* --- Рамки --- */
    --gm-color-border-frame: var(--gm-brass-500);  /* латунная рамка панели/кнопки */
    --gm-color-border-inner: var(--gm-brass-700);  /* внутренняя линия рамки */
    /* Тихий контур. НЕ ink-300: тот сливался с панелью (контраст 1.67 при норме 3.0) —
       «тихий» читалось как «невидимый». ink-100 даёт 3.43: контур виден, но не спорит с латунью. */
    --gm-color-border-subtle: var(--gm-ink-100);

    /* --- АУТЛАЙН: ЕДИНЫЙ источник правды для всех рамок интерфейса (реш. Макса 2026-07-25) ---
       В проекте ровно ТРИ разновидности контура, других заводить нельзя. Пиксель-рамки Honeti
       (9-slice WindowStroke/GoldOutlined/Inactive) из рамок выведены: при -unity-slice-scale 2-3px
       они давали ~16px кайму, слоты и кнопки читались «в толстой оправе». Заливки Honeti (Gold2 —
       латунная плашка primary) остаются: это ФОН, а не контур.
         strong — акцентный контур: панели, видео-вставка, таро-карта, primary-кнопка, активный таб;
         subtle — тихий контур: поля ввода, вторичные кнопки, слоты, утопленные блоки;
         inner  — вторая кайма ВНУТРИ уже обведённого блока (таро-рамка вокруг арта). */
    --gm-outline-width: var(--gm-border-1);                    /* 2px — одна толщина на весь UI */
    --gm-outline-color: var(--gm-color-border-frame);          /* сильный (эталон — видео-вставка) */
    --gm-outline-color-subtle: var(--gm-color-border-subtle);  /* тихий (эталон — поле поиска) */
    --gm-outline-color-inner: var(--gm-color-border-inner);    /* внутренняя кайма */
    --gm-outline-color-hover: var(--gm-color-hover-border);    /* наведение на любой из трёх */

    /* Ширина вертикального скроллбара. Живёт токеном, потому что её должны знать ДВОЕ: сам скроллбар
       и всё, что обязано встать вровень с прокручиваемым содержимым (тулбар над гридом карт). */
    --gm-scrollbar-width: 14px;

    /* --- Размеры таро-карточки и ряда карт ---
       Ширина колонки инвентаря РАНЬШЕ была литералом 642px с комментарием «4 карты + зазоры +
       padding + скроллбар». Сумма была подобрана на глаз и оказалась на 4px больше настоящей —
       из-за чего тулбар над гридом не сходился с картами (находка Макса, п.7, три захода).
       Теперь ряд карт объявлен ОДИН раз здесь, а колонка берёт ширину по нему. Хочешь 5 карт в
       ряду — правишь --gm-grid-columns, и тулбар переезжает сам. */
    /* Сами значения --gm-card-width / --gm-card-gap лежат в ярусе примитивов (шкала размеров).
       Число колонок вписано в формулу ширины колонки в components.uss. */

    /* --- Текст --- */
    --gm-color-text: var(--gm-parchment-100);
    --gm-color-text-muted: var(--gm-parchment-300);
    --gm-color-text-on-accent: var(--gm-ink-800);  /* текст на латунной заливке */

    /* --- Нагретая поверхность: фон главного действия. НЕ латунная плашка с тёмным текстом —
           инверсия ломала язык интерфейса (тёмное поле + латунная подпись). Здесь поле остаётся
           тёмным, но с янтарной подмесью: «та же кнопка, только нагретая». --- */
    --gm-color-surface-accent: var(--gm-ember-600);
    --gm-color-surface-accent-hover: var(--gm-ember-500);
    --gm-color-surface-accent-active: var(--gm-ember-700);

    /* --- Акцент (латунь) — контуры и подписи первичных действий --- */
    --gm-color-accent: var(--gm-brass-500);
    --gm-color-accent-active: var(--gm-brass-600);

    /* --- Смысловые акценты (правило «тёплого света»: цвет допустим любой, но приглушённый
           и с тёплым замесом; каркас интерфейса при этом остаётся ink/brass/parchment).
           Роли названы по СМЫСЛУ, а не по цвету — «положительное», а не «зелёное»:
           перекрасить их потом можно в одном месте, не переписывая компоненты. --- */
    --gm-color-positive: var(--gm-moss-400);       /* прирост стата, успех, лечение */
    --gm-color-negative: var(--gm-danger-400);     /* падение стата, урон, отказ */
    --gm-color-info: var(--gm-storm-300);          /* нейтральная подсветка, «выбрано» без похвалы */
    --gm-color-arcane: var(--gm-wine-400);         /* магическое: аркана, зачарование */

    /* --- Деструктив --- */
    --gm-color-danger: var(--gm-danger-500);

    /* --- Интерактив: hover/фокус --- */
    --gm-color-hover-surface: var(--gm-ink-500);
    --gm-color-hover-border: var(--gm-brass-300);
    --gm-color-focus-ring: var(--gm-brass-200);
    /* Выключенный текст — выцветший ПЕРГАМЕНТ, а не цвет дерева: он всё ещё текст и обязан
       читаться (4.37 вместо прежних 1.67). «Выключено» показывают тусклость + отсутствие отклика. */
    --gm-color-disabled-text: var(--gm-parchment-400);

    /* --- Слайдер --- */
    --gm-color-track: var(--gm-ink-500);
    --gm-color-handle: var(--gm-brass-300);
    --gm-color-handle-border: var(--gm-brass-700);

    /* --- Размер диалоговой панели: главное меню, ESC-меню и настройки — ОДНО окно (п.10 раунда 4).
           Раньше у каждой был свой размер, и панели прыгали при переходе между ними — заметнее
           всего потому, что открываются они одна из другой.

           ЗАВИСИМОСТЬ ПЕРЕВЁРНУТА: не панель растёт под контент, а контент занимает панель.
           У диалога есть тело `.gm-panel__body`, которое забирает остаток высоты и прокручивается,
           если содержимого больше. Поэтому число здесь — просто удобный размер окна, а не подгонка
           под самый длинный экран: новая опция в настройках больше не меняет габариты диалогов. --- */
    /* Укрупнено 2026-07-27 (Макс): прежние 640×680 на канве 1920×1080 занимали треть ширины и
       читались мелко. Растёт ОДНО число — и меню, и ESC, и настройки, потому что габариты у них
       общие. Настройкам это заодно дало место под разделы слева. */
    --gm-dialog-width: 1280px;
    --gm-dialog-height: 860px;

    /* --- Инсеты/шкала (алиасы под компоненты) --- */
    /* Восемь токенов отсюда сняты (аудит 2026-07-26, волна 3): --gm-color-divider, -accent-hover,
       -positive-dim, -info-dim, -danger-hover, -track-fill, --gm-inset-control, --gm-gap-stack.
       Их не читал ни один стиль, то есть при правке палитры они молча оставались от прежней —
       а обещание «такая роль у нас есть» продолжали давать. Вернуть — вместе с потребителем. */
    --gm-inset-panel: var(--gm-space-5);

    /* Токенов редкости реликвий здесь тоже больше нет: рамку по редкости рисовал RelicCard.SetRarity,
       которого никто не звал (аудит 2026-07-26, волна 2). Вернуть — когда редкость начнёт что-то
       значить на экране; примитивы (ink / brass) для этого никуда не делись. */

    /* --- Карта акта ---
       Карта живёт в мире, а не в UITK, поэтому эти роли читает не стиль, а ассет палитры
       (GuildmasterPalette.asset, собирается из этого файла). Смысл тот же, что у прочей семантики:
       цвет принадлежит палитре, а MapStyle только называет роль. Раньше он держал собственные
       Color-поля и трижды разошёлся с токенами, которые сам же называл в подсказках (аудит T-7). */
    --gm-color-map-node-backing: var(--gm-ink-650);
    --gm-color-map-node-rim: var(--gm-brass-500);
    --gm-color-map-current-marker: var(--gm-brass-200);
    --gm-color-map-icon-shadow: var(--gm-ink-700);
    --gm-color-map-icon-light: var(--gm-parchment-50);
    --gm-color-map-path-idle: var(--gm-parchment-500);
    --gm-color-map-path-travelled: var(--gm-brass-500);
    --gm-color-map-path-available: var(--gm-brass-200);
    --gm-color-map-pawn: var(--gm-parchment-60);
}
