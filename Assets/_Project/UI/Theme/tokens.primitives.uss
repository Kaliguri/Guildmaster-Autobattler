/* ============================================================================
 * Дизайн-токены — ЯРУС 1: PRIMITIVES (сырые рампы).
 * Единый источник цветов/шкал. В компонентах НАПРЯМУЮ НЕ ИСПОЛЬЗОВАТЬ —
 * только через семантический ярус (tokens.semantic.uss). Прыгать через ярус нельзя.
 * Эстетика — «гильдейский гроссбух»: тёмное дерево/чернила + латунь + пергамент.
 * Значения — плейсхолдер под финальный арт; менять здесь, структура не трогается.
 * ========================================================================== */
:root {
    /* --- Ink (тёмное дерево/чернила): фоны, панели, треки --- */
    --gm-ink-900: rgb(18, 16, 13);
    --gm-ink-800: rgb(23, 17, 12);
    --gm-ink-700: rgb(28, 20, 13);
    --gm-ink-600: rgb(36, 26, 18);
    --gm-ink-500: rgb(47, 34, 22);
    --gm-ink-400: rgb(58, 44, 30);
    --gm-ink-300: rgb(74, 58, 38);

    /* --- Brass (латунь): акценты, рамки, ручки --- */
    --gm-brass-700: rgb(138, 95, 40);
    --gm-brass-600: rgb(160, 111, 48);
    --gm-brass-500: rgb(184, 134, 59);
    --gm-brass-400: rgb(198, 154, 75);
    --gm-brass-300: rgb(217, 178, 106);
    --gm-brass-200: rgb(230, 201, 143);

    /* --- Parchment (пергамент): текст --- */
    --gm-parchment-100: rgb(239, 226, 196);
    --gm-parchment-200: rgb(216, 198, 160);
    --gm-parchment-300: rgb(176, 154, 114);

    /* --- Danger: деструктивные действия --- */
    --gm-danger-500: rgb(168, 80, 58);
    --gm-danger-400: rgb(194, 98, 68);

    /* --- Шкала отступов (UI-пиксели при базе 640x360) --- */
    --gm-space-1: 4px;
    --gm-space-2: 8px;
    --gm-space-3: 12px;
    --gm-space-4: 16px;
    --gm-space-5: 24px;
    --gm-space-6: 32px;

    /* --- Толщина рамок --- */
    --gm-border-1: 1px;
    --gm-border-2: 2px;

    /* --- Размеры шрифта --- */
    --gm-font-sm: 12px;
    --gm-font-body: 14px;
    --gm-font-title: 18px;
    --gm-font-lg: 24px;

    /* --- Радиус: 0 = острые пиксельные углы --- */
    --gm-radius-0: 0;
}
