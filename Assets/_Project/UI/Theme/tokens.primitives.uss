/* ============================================================================
 * Дизайн-токены — ЯРУС 1: PRIMITIVES (сырые рампы).
 * Единый источник цветов/шкал. В компонентах НАПРЯМУЮ НЕ ИСПОЛЬЗОВАТЬ —
 * только через семантический ярус (tokens.semantic.uss). Прыгать через ярус нельзя.
 * Эстетика — «табак и патина»: тёплый сумрак + окисленная бирюза + латунь
 * (реш. Макса 2026-08-04, журнал 2026-08-04/1). Тон ink 32°, насыщенность 0.18.
 * Значения — плейсхолдер под финальный арт; менять здесь, структура не трогается.
 * ========================================================================== */
:root {
    /* --- Ink (тёплый сумрак): фоны, панели, треки.
           Рампа ВЫНУТА ИЗ ЧЕРНОТЫ 2026-08-04: было l=0.06 у самой тёмной ступени, стало 0.15.
           Причина не вкусовая: интерфейс не должен быть dark fantasy, и персонажи с тёмными
           грязными лайнами на почти чёрной панели теряют силуэт. Насыщенность заодно снижена
           с 0.30 до 0.18 — на светлой поверхности прежняя читалась грязью, а не деревом. --- */
    --gm-ink-900: rgb(45, 39, 31);
    --gm-ink-800: rgb(54, 46, 38);
    --gm-ink-700: rgb(63, 54, 44);
    --gm-ink-600: rgb(78, 67, 54);
    /* Ступень между 600 и 700 — подложка узла карты: темнее поднятых блоков, но не так глуха,
       как чернила рампы иконок, иначе узел сливается с листом. */
    --gm-ink-650: rgb(69, 59, 48);
    --gm-ink-500: rgb(93, 80, 65);
    --gm-ink-400: rgb(111, 95, 77);
    --gm-ink-300: rgb(132, 114, 92);
    /* Светлый конец рампы — «тихие» контуры. Числа пересчитаны под новую панель (ink-700):
       ink-300 даёт 2.56 и для контура НЕ ГОДИТСЯ (норма 3.0 для нетекстовых), ink-200 — 3.52,
       ink-100 — 4.61. То есть тихий контур начинается с ink-200, а не с ink-300. */
    --gm-ink-200: rgb(157, 137, 114);
    --gm-ink-100: rgb(176, 159, 141);  /* 4.61 к панели — контур, который обязан быть заметен */

    /* Рампа ember («угли») жила здесь с 2026-07-25 под тёмную primary-кнопку и УДАЛЕНА 2026-08-04
       вместе с отменой того решения: поверхность действия ушла в patina, ссылок не осталось ни
       одной. Похоронена по слову Макса — не подкрашена «на всякий случай», потому что рампа без
       роли через месяц читается как забытая, а не как запасная. */

    /* --- Patina (окисленная латунь): ДЕЙСТВИЕ — то, что нажимают.
           Заведена 2026-08-04 вместе с разворотом гаммы. Роль отделена от латуни намеренно:
           brass говорит «это ценно» (валюта, редкость, уровень), patina — «сюда нажать»
           (primary-кнопка, наведение, выделение, свои). Один цвет на две роли и был причиной,
           по которой интерфейс читался плоско: подсветить действие было нечем, кроме светлоты.
           Имя материальное, как у всей рампы: патина — то, во что превращается латунь, то есть
           родня фону и акценту, а не чужой холодный голубой.
           Тон 185°, насыщенность 0.58. Тонкие линии брать НЕ ярче 400-й ступени: насыщенный
           холод на тёплом фоне вибрирует именно на однопиксельном крае. --- */
    --gm-patina-600: rgb(34, 121, 129);  /* тёмный конец градиента кнопки */
    --gm-patina-500: rgb(49, 174, 185);  /* заливка: 4.44 к панели — хватает для площади, не для текста */
    --gm-patina-400: rgb(70, 194, 206);  /* 5.56 — годится и под текст, и под кайму */
    --gm-patina-300: rgb(115, 203, 211); /* 6.32 — наведение и активное состояние */

    /* --- Brass (латунь): ЦЕННОСТЬ — валюта, редкость, уровень, кайма избранного --- */
    --gm-brass-700: rgb(138, 95, 40);
    --gm-brass-600: rgb(160, 111, 48);
    --gm-brass-500: rgb(184, 134, 59);
    --gm-brass-400: rgb(198, 154, 75);
    --gm-brass-300: rgb(217, 178, 106);
    --gm-brass-200: rgb(230, 201, 143);

    /* --- Parchment (пергамент): текст --- */
    /* Два самых светлых пергамента пришли с карты акта: светлый конец рампы перекраски иконок
       и фишка отряда. Они почти совпадают (разница — 11 единиц в синем, глазом не видно), но
       заведены раздельно, потому что были нарисованы раздельно; сводить их в один — отдельное
       решение по виду, а не по коду. */
    --gm-parchment-50: rgb(247, 237, 214);
    --gm-parchment-60: rgb(248, 236, 203);
    --gm-parchment-100: rgb(239, 226, 196);
    --gm-parchment-200: rgb(216, 198, 160);
    --gm-parchment-300: rgb(176, 154, 114);
    /* Выцветший пергамент — ВЫКЛЮЧЕННЫЙ текст (4.57 к панели). Раньше эту роль играл ink-300,
       то есть цвет ДЕРЕВА на дереве: контраст 1.67, выключенное было физически нечитаемо.
       Текст живёт в parchment, рамки — в ink; смешение этих рамп и было корнем провала.
       Подсветлен 2026-08-04 вместе с рампой ink: на прежнем значении новая панель давала 2.85,
       то есть выключенный текст снова провалился бы ниже нормы — светлеет фон, светлеет и он. */
    --gm-parchment-400: rgb(175, 159, 131);
    /* Ещё ступень выцветания: дорожка карты в покое. Тише всего, что несёт текст — она и не текст,
       а фон маршрута, который не должен спорить с открытым путём (3.13 к панели). */
    --gm-parchment-500: rgb(147, 129, 98);

    /* --- Стекло МЕТА-СЛОЯ: поверхности, сквозь которые виден мир (реш. Макса 2026-08-02).
           Прозрачность здесь — часть роли, а не оттенок, поэтому значения заданы rgba напрямую (как
           --gm-color-scrim и полка консоли), но оттенок ОБЯЗАН лежать на рампе ink (R > G > B):
           это ступень ниже ink-900 с альфой, а не свой цвет.
           Альфа 0.62 — компромисс из двух требований: сквозь поле должен читаться стол, но текст
           поверх обязан держать контраст. Ниже ~0.5 подпись начинает спорить с рисунком фона —
           это главная известная беда стеклянных интерфейсов, и мы её не воспроизводим. --- */
    --gm-glass-900: rgba(35, 30, 24, 0.62);
    --gm-glass-rim: rgba(230, 201, 143, 0.42);   /* кромка: свет ложится СВЕРХУ, поэтому линия одна */

    /* --- Neutral (нейтральный моно): единственная рампа ВНЕ тёплого фильтра, и это вынужденно.
           Заведена под ряд атрибуций на бут-экране: чужие трейдмарки красить в нашу латунь нельзя
           (гайд Unity разрешает из цветов только чёрный / тёмно-серый / светло-серый / белый), а
           держать в ряду два языка цвета — латунь у части знаков и серый у остальных — читается
           поломкой, а не решением. Поэтому ряд целиком уходит в нейтраль, включая наш знак.
           В остальном интерфейсе нейтрали не место: там цвет несёт тепло. --- */
    --gm-neutral-300: rgb(190, 190, 190);

    /* --- Flare (боевой свет): цвета, которые СВЕТЯТСЯ, а не покрывают поверхность.
           Отдельная ветвь от ink/brass/parchment намеренно: те приглушены тёплым фильтром, потому что
           это мебель интерфейса, а здесь — вспышки, полосы HP и щита, то есть свет. Правило авторинга
           у них своё (gdd/10-vision/vfx-color): насыщенность 70–90%, ни один канал не в нуле, яркость
           выше порога bloom. Значения пришли из боевых конфигов как есть — они подобраны на глаз в бою
           и здесь не «исправлены», а только перенесены во владение палитры. --- */
    --gm-flare-white: rgb(255, 255, 255);    /* физический удар: чистая вспышка без оттенка */
    --gm-flare-amber: rgb(255, 140, 64);     /* магический */
    --gm-flare-gold: rgb(255, 242, 140);     /* чистый урон (True) */
    --gm-flare-venom: rgb(115, 255, 102);    /* яд */
    --gm-flare-halo: rgb(255, 242, 191);     /* свет */
    --gm-flare-violet: rgb(140, 89, 217);    /* тьма */
    --gm-flare-mint: rgb(140, 255, 166);     /* исцеление */
    --gm-flare-leaf: rgb(77, 217, 89);       /* HP своих */
    --gm-flare-rust: rgb(255, 102, 33);      /* HP чужих */
    --gm-flare-ice: rgb(158, 219, 255);      /* щит */
    --gm-flare-frost-white: rgb(241, 243, 255); /* холодный пересвет: осколки и вспышка смерти */
    --gm-flare-holo: rgb(77, 242, 255);      /* цифровой циан голограммы развоплощения */
    --gm-flare-wound: rgb(255, 51, 51);      /* 0° 80% — вскрытое: порезы на теле */

    /* Оттенки БОЙЦОВ: чем светит конкретный юнит — снаряд, след, искры, осколки. Ступени названы по
       цвету, а не по юниту: юнитов будет вдесятеро больше, и роль на каждого превратила бы палитру во
       второй реестр контента. Повторять оттенок между юнитами разрешено прямо (Макс, 2026-07-30):
       героя от врага отличает полоса HP, а не цвет искр.
       Значения — база при ЯРКОСТИ 1; HDR-яркость накручивает код множителями (main ×2.0, насыщенный
       конец палитры ×2.2, пересвет ×2.6), поэтому здесь их нет — в палитру HDR не едет.
       Назначение «кому какой оттенок» — gdd/10-vision/vfx-color §Ростер. */
    --gm-flare-fire: rgb(255, 119, 51);      /* 20°  80% — огонь */
    --gm-flare-honey: rgb(255, 204, 51);     /* 45°  80% — золото щита */
    --gm-flare-lime: rgb(204, 255, 51);      /* 75°  80% — лайм выстрела */
    --gm-flare-grass: rgb(120, 255, 51);     /* 100° 80% — живая зелень */
    --gm-flare-emerald: rgb(51, 255, 153);   /* 150° 80% — изумруд лечения */
    --gm-flare-cyan: rgb(51, 222, 255);      /* 190° 80% — ветер */
    --gm-flare-azure: rgb(51, 153, 255);     /* 210° 80% — лёд (глубже, чем щитовой ice) */
    --gm-flare-steel: rgb(140, 169, 255);    /* 225° 45% — сталь: металл не звенит цветом */
    --gm-flare-amethyst: rgb(186, 51, 255);  /* 280° 80% — тень; насыщеннее школьного violet */
    --gm-flare-tallow: rgb(255, 236, 179);   /* 45°  30% — тёплая нейтраль болванки */
    --gm-flare-copper: rgb(255, 223, 191);   /* 30°  25% — тёплое железо */
    --gm-flare-dust: rgb(255, 245, 224);     /* 40°  12% — пыльная охра: рядовой никого не изображает */
    --gm-flare-bog: rgb(217, 255, 179);      /* 90°  30% — болотная зелень */
    --gm-flare-chalk: rgb(224, 235, 255);    /* 220° 12% — холодная нейтраль манекена */

    /* --- Приглушения тела (тинт): НЕ свет, а множитель поверх готового спрайта.
           Тинт умножается на арт, поэтому умеет только затемнять и уводить оттенок — перекрасить им
           персонажа нельзя (правило и сторож — UnitTintPolicyTests). Нужен ровно там, где один спрайт
           носят несколько юнитов: один остаётся без тинта, остальные берут ступень отсюда.
           Ступеней три, потому что больше на цветном арте не различить. ВЫБИРАТЬ ступень надо по цвету
           арта: умножение гасит только те каналы, которые в арте есть. На красном воине жёлто-бурая
           ступень не видна вовсе (его G и B и так низкие) — там работает холодное затемнение. --- */
    --gm-dim-ash: rgb(166, 179, 191);        /* холодное затемнение: единственное, что видно на ЛЮБОМ арте */
    --gm-dim-verdant: rgb(179, 242, 166);    /* зеленца: гасит красный и синий, зелёный оставляет */
    --gm-dim-tan: rgb(230, 191, 102);        /* жёлто-бурый: работает на зелёных и жёлтых артах */

    /* --- Danger: деструктивные действия.
           Подсветлен 2026-08-04: на прежних значениях новая панель давала 2.18 и 2.89, то есть
           «удалить» читалось хуже обычной кнопки — ровно наоборот тому, что должно. --- */
    --gm-danger-500: rgb(196, 94, 69);   /* заливка (2.84 — площадь, текст на ней свой) */
    --gm-danger-400: rgb(206, 121, 100); /* текст и кайма: 3.69 */

    /* --- Акцентные рампы «тёплого замеса» (решение Макса 2026-07-25: не монохром, а тёплый свет).
           Цвета в UI могут быть любыми, но проходят тёплый фильтр: чистого RGB не бывает,
           насыщенность приглушена, тени тёплые. Каркас (фоны/текст/рамки) остаётся ink/brass/
           parchment — ощущение задаёт он. Эти рампы — для смысловых акцентов, не для поверхностей. --- */
    --gm-moss-400: rgb(150, 168, 96);    /* положительное: рост стата, успех, лечение (4.54) */
    --gm-moss-500: rgb(118, 136, 72);
    /* Информация/выделение. Первая проба (150,164,178) на витрине «зазвенела» — читалась чужим
       голубым рядом с латунью. Уведена в пыльную бирюзу с зелёным подмесом: холод остался как
       СМЫСЛ («не хвалю, просто отмечаю»), но подчинился тёплому свету сцены.
       ВНИМАНИЕ (2026-08-04): роль «выделение» забрала patina, и storm теперь пересекается с ней
       по смыслу и почти совпадает по тону (h≈170 против h=185). Рампа НЕ удалена намеренно —
       сначала надо развести роли в семантике и посмотреть, останется ли за storm свой смысл
       («отмечаю», а не «нажми»). Если не останется — это кандидат на снос, а не на подкраску. */
    --gm-storm-300: rgb(134, 152, 146);  /* 3.90 к панели */
    --gm-storm-400: rgb(96, 114, 110);
    /* Магическое/аркана: фиолетовый, уведённый в вино. Подсветлен 2026-08-04 — на прежнем
       значении новая панель давала 2.85, ниже нормы даже для нетекстовых. */
    --gm-wine-400: rgb(193, 134, 171);   /* 4.09 — годится под текст */
    --gm-wine-500: rgb(181, 105, 153);   /* 3.07 — кайма и заливка */

    /* --- Шкала отступов (UI-пиксели под нативную канву 1920x1080, PanelSettings scale=1) ---
           space-0 — плотный зазор внутри однородных гридов (слоты способностей/улучшений,
           клетки статблока), где space-1 уже разваливает блок на отдельные острова. */
    --gm-space-0: 4px;
    --gm-space-1: 8px;
    --gm-space-2: 16px;
    --gm-space-3: 24px;
    --gm-space-4: 32px;
    --gm-space-5: 48px;
    --gm-space-6: 64px;

    /* --- Размер таро-карточки. Ширину ряда/колонки из них ВЫЧИСЛИТЬ В USS НЕЛЬЗЯ:
           UI Toolkit не поддерживает calc() и не умеет математику над переменными
           (docs.unity3d.com/Manual/UIE-USS-CustomProperties.html). Поэтому ширина колонки
           инвентаря остаётся одним числом в .gm-loadout__center, а согласованность
           держит тест-инвариант, а не формула. --- */
    --gm-card-width: 132px;
    --gm-card-gap: 8px;     /* поле карточки со всех сторон; зазор между соседними = 2×gap */

    /* --- Толщина рамок --- */
    --gm-border-1: 2px;
    --gm-border-2: 3px;

    /* --- Размеры шрифта (под 1080p) --- */
    --gm-font-xxs: 13px;
    --gm-font-xs: 17px;
    --gm-font-sm: 22px;
    --gm-font-body: 26px;
    --gm-font-title: 34px;
    --gm-font-lg: 48px;
    /* Hero-дисплей: лого на экране загрузки — единственный текст, держащий центр пустого
       кадра, поэтому крупнее заголовков панелей (--gm-font-lg). */
    --gm-font-display: 88px;

    /* --- Гарнитуры (сырые файлы TextCore SDF) ---
           Ярус примитивов держит ФАЙЛ, семантика — РОЛЬ («чем набран заголовок»), и разводить их
           обязательно: до этого гарнитура была прибита `url(...)` прямо в трёх правилах
           components.uss, поэтому у неё не было владельца — сменить шрифт значило искать по всему
           файлу. Пути относительны ЭТОГО файла (Theme/), как и у остальных url в теме.
           Serif — голос игры (титулы, кнопки, имена сущностей), sans — данные и служебный текст,
           mono — консоль. Четвёртой гарнитуры в проекте быть не должно: два голоса читаются как
           замысел, три — как сборная солянка. */
    /* ДИСПЛЕЙНЫЕ гарнитуры — только для названия игры и родственных «вывесок». В интерфейсе их нет:
       Yeseva с её контрастом штриха на кегле текста разваливается, а Forum в капсе ради разрядки и
       заведён. Обе лежали в проекте ttf-файлами; SDF собраны 04.08.2026 под типографический lockup. */
    --gm-typeface-display: url("../Fonts/YesevaOne-Regular SDF.asset");
    --gm-typeface-inscription: url("../Fonts/Forum-Regular SDF.asset");

    --gm-typeface-serif: url("../Fonts/CormorantGaramond-Medium SDF.asset");
    --gm-typeface-sans: url("../Fonts/FiraSans-Regular SDF.asset");
    --gm-typeface-sans-bold: url("../Fonts/FiraSans-Bold SDF.asset");
    --gm-typeface-mono: url("../Fonts/FiraMono-Regular SDF.asset");

    /* --- Радиус: 0 = острые пиксельные углы --- */
    --gm-radius-0: 0;

    /* --- Высота глобального топбара забега (app-shell): тело экранов сдвигается под него на эту величину.
           56 после перевода режимов на иконки (2026-07-20): текстовые табы и двухстрочная гильдия требовали 84. --- */
    --gm-topbar-height: 56px;

    /* --- Ширина колонки разделов в диалоге (настройки: разделы слева, содержимое справа). --- */
    --gm-sidebar-width: 300px;

    /* --- Ширина колонки пунктов меню (главное меню, ESC). Кнопка-строка шире этого читается как
           полоса с подписью, потерянной в центре пустоты. --- */
    --gm-menu-column-width: 620px;
}
