/* ============================================================================
 * ДВОР ГИЛЬДИИ (заглушка): где стоит забег, метка «в работе» и две двери.
 * ========================================================================== */

.gm-hub__body {
    align-items: center;
    justify-content: center;
}

/* ГДЕ МЫ — первое, что читают на этом экране: акт, его имя и ступень маршрута. Роль подзаголовка
   даёт сериф на кегле тела; кричать капсом ей незачем — это факт, а не зов. */
.gm-hub__stage {
    -unity-text-align: middle-center;
    margin-bottom: var(--gm-space-2);
}

/* Метка «сюда ещё не завезли» больше не кричит капсом: рядом появилась строка стадии, и две
   кричащие строки спорили бы за один и тот же взгляд. Уедет вместе с заглушкой. */
.gm-hub__stub {
    -unity-text-align: middle-center;
    margin-bottom: var(--gm-space-3);
}

/* Футер двора: дверь наружу на своём общем месте (левый край, см. button.uss). */
.gm-hub__actions {
    flex-direction: row;
}
