/* ============================================================================
 * ДВОР ГИЛЬДИИ (заглушка): метка «в работе» и единственная дверь наружу.
 * ========================================================================== */

.gm-hub__body {
    align-items: center;
    justify-content: center;
}

/* Метка кричит намеренно: это единственное, что отличает «сюда не завезли» от «сломалось».
   Уедет вместе с заглушкой, поэтому своих токенов не заводит — берёт готовые. */
.gm-hub__stub {
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 4px;
    margin-bottom: var(--gm-space-3);
    color: var(--gm-color-accent);
}
