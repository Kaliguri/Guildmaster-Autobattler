/* Страница «Предметы» (ГДД preparation-screens §2.2, раскладка «Строки»).

   Слоты стоят одной вертикалью, поэтому «у кого пусто» читается сверху вниз одним взглядом —
   это и есть главный вопрос страницы. Квадратные: круглое у нас человек, квадратное вещь. */

.gm-items__title {
    margin-right: var(--gm-space-5);
}

/* --- Строка носителя --- */

.gm-items__middle {
    flex-direction: row;
    flex-grow: 1;
}

.gm-items__inspect {
    flex-shrink: 0;
    padding-right: var(--gm-space-5);
}

.gm-items__rows {
    flex-grow: 1;
    padding: 0 var(--gm-space-5);
}

.gm-items-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--gm-space-2);
    padding: var(--gm-space-2);
    background-color: var(--gm-color-surface-panel);
    border-width: var(--gm-outline-width);
    border-color: var(--gm-outline-color);
}

.gm-items-row:hover {
    border-color: var(--gm-outline-color-hover);
}

/* Лицо носителя: круг — человек, квадрат — вещь (ГДД preparation-screens §2.2). */
.gm-items-row__portrait {
    width: var(--gm-cell-sm);
    height: var(--gm-cell-sm);
    border-radius: 22px;
    background-color: var(--gm-color-surface-raised);
    border-width: var(--gm-outline-width);
    border-color: var(--gm-outline-color);
    -unity-background-scale-mode: scale-to-fit;
}

/* Лица нет — круг гаснет: «сюда ещё не поставили», а не «портрет не загрузился». */
.gm-items-row__portrait--blank {
    background-color: var(--gm-color-surface-sunken);
    border-color: var(--gm-outline-color-subtle);
}

.gm-items-row__who {
    width: 160px;
    margin-left: var(--gm-space-3);
}

.gm-items-row__name {
    -unity-font-style: bold;
}

.gm-items-row__relic {
    color: var(--gm-color-accent);
}

.gm-items-row__slots {
    flex-direction: row;
}

/* --- Слот вещи: квадрат --- */

.gm-item-slot {
    width: var(--gm-cell-md);
    height: var(--gm-cell-md);
    margin-right: var(--gm-space-2);
    align-items: center;
    justify-content: center;
    background-color: var(--gm-color-surface-raised);
    border-width: var(--gm-outline-width);
    border-color: var(--gm-color-border-subtle);
}

.gm-item-slot--filled {
    border-color: var(--gm-outline-color);
}

.gm-item-slot--locked {
    background-color: rgba(0, 0, 0, 0);
    opacity: 0.6;
}

.gm-item-slot:hover {
    border-color: var(--gm-outline-color-hover);
}

/* Значок вещи занимает квадрат целиком, с полями: рисунок мелкий, и без полей он касается рамки. */
.gm-item-slot__icon {
    flex-grow: 1;
    margin: var(--gm-space-1);
    -unity-background-scale-mode: scale-to-fit;
}

/* Значка нет — в слоте имя. ОБРЕЗАЕТСЯ, а не переносится: квадрат мал, и длинное имя лезло за его
   край на соседний слот (наход. Макса 23.08.2026). Полное имя отдаёт подсказка. */
.gm-item-slot__name,
.gm-item-slot__note {
    color: var(--gm-color-text-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    -unity-text-align: middle-center;
}

/* --- Склад --- */

.gm-items__stash {
    max-height: 180px;
}

.gm-items__stash .unity-scroll-view__content-container {
    flex-direction: row;
    flex-wrap: wrap;
}

.gm-stash-item {
    width: var(--gm-cell-md);
    height: var(--gm-cell-md);
    margin: 0 var(--gm-space-2) var(--gm-space-2) 0;
    align-items: center;
    justify-content: center;
    background-color: var(--gm-color-surface-panel);
    border-width: var(--gm-outline-width);
    border-color: var(--gm-outline-color);
}

.gm-stash-item:hover {
    border-color: var(--gm-outline-color-hover);
}

/* Склад показывает вещь тем же лицом, что и слот носителя: узнаётся по одному признаку везде. */
.gm-stash-item .gm-item-slot__icon,
.gm-stash-item .gm-item-slot__name {
    color: var(--gm-color-text-muted);
}

