.gm-event-image {
    height: 120px;
    margin-bottom: var(--gm-space-3);
    -unity-background-scale-mode: scale-to-fit;
}

.gm-event-body {
    color: var(--gm-color-text);
    font-size: var(--gm-font-body);
    white-space: normal;
    margin-bottom: var(--gm-space-3);
}

/* Варианты ответа — колонка кнопок во всю ширину панели.
   РАСКЛАДЫВАЕТ КОНТЕЙНЕР, а не сама кнопка (правило Макса 06.08.2026: набор кнопок, а не список
   мест). Прежде здесь стоял класс `gm-event-choice`, который вешался на каждую кнопку и значил
   ровно «кнопка на экране события» — то есть привязку к месту вместо роли. Тот же класс нужен и
   привалу, поэтому имя общее: список вариантов. */
.gm-choice-list > .gm-button {
    width: 100%;
    margin-top: var(--gm-space-1);
    margin-bottom: 0;
}

/* ============================================================================
 * Привал: панель с бюджетом действий отряда.
 * ========================================================================== */

/* Остаток бюджета над колонкой действий — вторичная строка, читается как счётчик, а не как заголовок. */
.gm-camp-budget {
    color: var(--gm-color-text-muted);
    font-size: var(--gm-font-body);
    margin-bottom: var(--gm-space-2);
    -unity-text-align: middle-right;
}
