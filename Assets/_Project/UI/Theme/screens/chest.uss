.gm-chest__body {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.gm-chest__lid {
    width: 220px;
    height: 160px;
    align-items: center;
    justify-content: center;
    background-color: var(--gm-color-surface-raised);
    border-width: var(--gm-border-2);
    border-color: var(--gm-color-border-value);
    transition-property: scale, opacity;
    transition-duration: 0.13s;
}

.gm-chest__lid:hover {
    scale: 1.04 1.04;
    border-color: var(--gm-color-border-value-hover);
}

.gm-chest__lid--open {
    scale: 0.9 0.9;
    opacity: 0.5;
}

.gm-chest__glyph {
    font-size: var(--gm-font-lg);
    color: var(--gm-color-value);
}

.gm-chest__hint {
    margin-top: var(--gm-space-3);
}

/* Крышку сундука жмут — значит она отвечает на нажатие и на фокус (стала focusable 06.08.2026). */
.gm-chest__lid:active {
    background-color: var(--gm-color-surface-sunken);
}

.gm-chest__lid:focus {
    border-color: var(--gm-color-hover-border);
}

.gm-chest__lid:disabled {
    color: var(--gm-color-disabled-text);
}
