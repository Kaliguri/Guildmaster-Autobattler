/* ============================================================================
 * ЭКРАН ВЫБОРА ДОМА: слоты гильдий, свободные наравне с занятыми.
 * ========================================================================== */

/* Контейнер списка свой класс больше не носит: экран переехал на общий каркас входа
   (gm-entry__*), и отдельное правило колонки осталось бы стилем без потребителя. */

.gm-guilds__slot {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--gm-space-1);
}

/* Раскладывает строка, а не кнопка: см. профиль. */
.gm-guilds__slot > .gm-button {
    flex-grow: 1;
    -unity-text-align: middle-left;
}

/* Свободный слот приглушён, но не погашен: завести дом можно, просто это ещё не дом. Тем же
   приёмом, что пустой слот профиля, — смысл один, и вид обязан быть один. */
.gm-guilds__slot-create {
    flex-grow: 1;
    opacity: 0.75;
}

/* Знак дома в строке списка: белый силуэт, покрашенный своим цветом. Показываем занятую часть
   холста (фигура лежит в его левом верхнем углу — см. profile.uss), а не весь холст. */
.gm-guilds__emblem {
    width: 28px;
    height: 28px;
    margin-right: var(--gm-space-1);
    background-size: 100% 100%;
    background-position: 0% 0%;
    background-repeat: no-repeat;
}
