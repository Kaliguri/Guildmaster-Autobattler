/* ============================================================================
 * ЭКРАН ВЫБОРА ДОМА: слоты гильдий, свободные наравне с занятыми.
 * ========================================================================== */

.gm-guilds__slots {
    flex-direction: column;
}

.gm-guilds__slot {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--gm-space-1);
}

.gm-guilds__slot-pick {
    flex-grow: 1;
    -unity-text-align: middle-left;
}

/* Свободный слот приглушён, но не погашен: завести дом можно, просто это ещё не дом. Тем же
   приёмом, что пустой слот профиля, — смысл один, и вид обязан быть один. */
.gm-guilds__slot-create {
    flex-grow: 1;
    opacity: 0.75;
}
