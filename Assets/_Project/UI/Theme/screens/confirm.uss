.gm-confirm__body {
    white-space: normal;
    margin-bottom: var(--gm-space-1);
}

/* Последствие — тем же красным, что и кнопка сноса: это одна мысль, сказанная дважды. */
.gm-confirm__consequence {
    white-space: normal;
    color: var(--gm-color-danger);
}

.gm-confirm__actions {
    flex-direction: row;
    justify-content: flex-end;
}
