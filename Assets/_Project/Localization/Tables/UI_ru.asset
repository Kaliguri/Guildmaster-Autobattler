  m_TableData:
  - m_Id: 3461211247337472
    m_Localized: "\u041F\u0440\u0438\u0432\u0430\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 3461211293474816
    m_Localized: "\u041E\u0442\u0440\u044F\u0434 \u0440\u0430\u0437\u0431\u0438\u0432\u0430\u0435\u0442
      \u043B\u0430\u0433\u0435\u0440\u044C. \u0412\u0440\u0435\u043C\u0435\u043D\u0438
      \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u2014 \u0443\u0441\u043F\u0435\u0435\u0442\u0435
      \u0441\u0434\u0435\u043B\u0430\u0442\u044C \u043D\u0435 \u0432\u0441\u0451."
    m_Metadata:
      m_Items: []
  - m_Id: 3461211293474817
    m_Localized: "\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u0439 \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C:
      {0} \u0438\u0437 {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 3461211293474818
    m_Localized: "\u0423\u0441\u0438\u043B\u0438\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 3461211293474819
    m_Localized: "\u041F\u043E\u043B\u0443\u0447\u0438\u0442\u044C \u043A\u043E\u043F\u0438\u044E
      \u0440\u0435\u043B\u0438\u043A\u0432\u0438\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 3461211293474820
    m_Localized: "\u0421\u043D\u044F\u0442\u044C \u043D\u0435\u0433\u0430\u0442\u0438\u0432\u043D\u043E\u0435
      \u043F\u043E\u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 3461211293474821
    m_Localized: "\u041D\u0430\u043D\u044F\u0442\u044C \u0441\u043E\u0441\u0443\u0434\u0430
      (\u0438\u043B\u0438 \u0437\u0430\u043C\u0435\u043D\u0438\u0442\u044C \u0441\u0442\u0430\u0440\u043E\u0433\u043E)"
    m_Metadata:
      m_Items: []
  - m_Id: 3461211293474822
    m_Localized: "\u041F\u0440\u043E\u0439\u0442\u0438 \u043C\u0438\u043C\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 5532690453618688
    m_Localized: "\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 5532690512338944
    m_Localized: "\u041A \u043F\u043E\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 5589400031584256
    m_Localized: "\u0412\u044B \u0434\u0432\u0438\u043D\u0443\u043B\u0438\u0441\u044C
      \u0434\u0430\u043B\u044C\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 5594274752356352
    m_Localized: "\u041B\u0430\u0432\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 5594274802688000
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446 \u0441\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442
      \u043B\u043E\u0442\u043E\u043A \u0438 \u043C\u0430\u0448\u0435\u0442 \u0432\u0430\u043C
      \u0432\u0441\u043B\u0435\u0434: \xAB\u0417\u0430\u0445\u043E\u0434\u0438\u0442\u0435,
      \u043A\u0430\u043A \u0440\u0430\u0437\u0431\u043E\u0433\u0430\u0442\u0435\u0435\u0442\u0435!\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 5594274802688001
    m_Localized: "\u0421\u0443\u043D\u0434\u0443\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 5594274802688002
    m_Localized: "\u041A\u0440\u044B\u0448\u043A\u0430 \u0437\u0430\u0445\u043B\u043E\u043F\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u0441 \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u044B\u043C \u0449\u0435\u043B\u0447\u043A\u043E\u043C.
      \u0411\u043E\u043B\u044C\u0448\u0435 \u0432\u043D\u0443\u0442\u0440\u0438 \u043D\u0438\u0447\u0435\u0433\u043E
      \u043D\u0435\u0442 \u2014 \u0432\u044B \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u043B\u0438
      \u0434\u0432\u0430\u0436\u0434\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 5594274802688003
    m_Localized: "\u041F\u0440\u0438\u0432\u0430\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 5594274802688004
    m_Localized: "\u041A\u043E\u0441\u0442\u0451\u0440 \u0434\u043E\u0433\u043E\u0440\u0430\u0435\u0442
      \u0434\u043E \u0443\u0433\u043B\u0435\u0439. \u041E\u0442\u0440\u044F\u0434
      \u0441\u043E\u0431\u0438\u0440\u0430\u0435\u0442 \u0432\u0435\u0449\u0438;
      \u043A\u0442\u043E-\u0442\u043E \u0435\u0449\u0451 \u0434\u043E\u0436\u0451\u0432\u044B\u0432\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 5619220287315968
    m_Localized: "\u041E\u0431\u044B\u0447\u043D\u044B\u0439 \u043A\u0438\u0442"
