  - m_Id: 5619220350230537
    m_Localized: "\u041F\u043E\u0432\u0435\u0434\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 5619220350230538
    m_Localized: "\u0417\u0430\u0431\u0435\u0433"
    m_Metadata:
      m_Items: []
  - m_Id: 5619220350230539
    m_Localized: "\u0412\u0441\u0435\u0433\u0434\u0430 \u043F\u043E\u0434\u0440\u043E\u0431\u043D\u044B\u0435
      \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 5619220350230540
    m_Localized: "\u0421\u043B\u043E\u0442 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438
      \u2014 \u043F\u043E\u043A\u0430 \u043F\u0443\u0441\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 5619220350230541
    m_Localized: "\u0421\u043B\u043E\u0442 \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u044F
      \u2014 \u043F\u043E\u043A\u0430 \u043F\u0443\u0441\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 5619220350230542
    m_Localized: "\u0415\u0449\u0451 \u0442\u0435\u0433\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 5619882303676416
    m_Localized: "\u0423\u0440\u043E\u043D: {dmg}"
    m_Metadata:
      m_Items:
      - rid: 5615027262775099485
  - m_Id: 5628458929741824
    m_Localized: "\u0417\u0430\u043F\u0430\u0441 \u043F\u0440\u043E\u0447\u043D\u043E\u0441\u0442\u0438:
      \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0443\u0440\u043E\u043D\u0430 \u044E\u043D\u0438\u0442
      \u0432\u044B\u0434\u0435\u0440\u0436\u0438\u0442, \u043F\u0440\u0435\u0436\u0434\u0435
      \u0447\u0435\u043C \u0432\u044B\u0439\u0434\u0435\u0442 \u0438\u0437 \u0431\u043E\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 5628458975879168
    m_Localized: "\u0421\u043D\u0438\u0436\u0430\u0435\u0442 \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u043C\u044B\u0439
      [kw:physical]. \u041D\u0430 [kw:magical] \u0438 [kw:true] \u043D\u0435 \u0432\u043B\u0438\u044F\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 5628458975879169
    m_Localized: "\u0421\u043D\u0438\u0436\u0430\u0435\u0442 \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u043C\u044B\u0439
      [kw:magical]: \u043E\u0433\u043E\u043D\u044C, \u043B\u0451\u0434, \u043C\u043E\u043B\u043D\u0438\u044F
      \u0438 \u0430\u0440\u043A\u0430\u043D\u0430 \u0438\u0434\u0443\u0442 \u043F\u043E\u0434
      \u043D\u0435\u0439 \u043E\u0434\u043D\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 5628458975879170
    m_Localized: "\u0423\u0440\u043E\u043D \u043E\u0434\u043D\u043E\u0439 \u0430\u0432\u0442\u043E-\u0430\u0442\u0430\u043A\u0438
      \u2014 \u0434\u043E \u0442\u043E\u0433\u043E, \u043A\u0430\u043A \u0435\u0433\u043E
      \u0441\u043D\u0438\u0437\u0438\u0442 [kw:armor:nom] \u0446\u0435\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 5628458975879171
    m_Localized: "\u0421\u043A\u043E\u043B\u044C\u043A\u043E \u0430\u0432\u0442\u043E-\u0430\u0442\u0430\u043A
      \u044E\u043D\u0438\u0442 \u0443\u0441\u043F\u0435\u0432\u0430\u0435\u0442 \u0437\u0430
      \u0441\u0435\u043A\u0443\u043D\u0434\u0443. \u0421\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F
      \u0442\u0430\u043A \u0436\u0435, \u043A\u0430\u043A \u0432 \u0431\u043E\u044E
      \u2014 \u0441 \u0448\u0430\u0433\u043E\u043C \u0442\u0438\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 5628458975879172
    m_Localized: "\u041D\u0430 \u043A\u0430\u043A\u043E\u043C \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u0438
      \u044E\u043D\u0438\u0442 \u043C\u043E\u0436\u0435\u0442 \u0430\u0442\u0430\u043A\u043E\u0432\u0430\u0442\u044C,
      \u0432 \u043C\u0438\u0440\u043E\u0432\u044B\u0445 \u0435\u0434\u0438\u043D\u0438\u0446\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 5628458975879173
    m_Localized: "\u041A\u0430\u043A \u0431\u044B\u0441\u0442\u0440\u043E \u044E\u043D\u0438\u0442
      \u043F\u0435\u0440\u0435\u043C\u0435\u0449\u0430\u0435\u0442\u0441\u044F \u043F\u043E
      \u0430\u0440\u0435\u043D\u0435."
    m_Metadata:
      m_Items: []
