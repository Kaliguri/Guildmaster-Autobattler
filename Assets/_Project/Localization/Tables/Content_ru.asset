  m_TableData:
  - m_Id: 2796550348800
    m_Localized: "\u0421\u043A\u0440\u044B\u0442\u043D\u044B\u0439 \u0443\u0431\u0438\u0439\u0446\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2796625846272
    m_Localized: "\u0411\u044B\u0441\u0442\u0440\u044B\u0439 \u0443\u0431\u0438\u0439\u0446\u0430,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0432\u044B\u0440\u0435\u0437\u0430\u0435\u0442
      \u0441\u043B\u0430\u0431\u0443\u044E \u0446\u0435\u043B\u044C \u0438 \u0443\u0445\u043E\u0434\u0438\u0442
      \u0438\u0437 \u0444\u043E\u043A\u0443\u0441\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 3196892471296
    m_Localized: "\u041A\u0440\u0438\u043E\u043C\u0430\u043D\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 3196892471297
    m_Localized: "\u041B\u0435\u0434\u044F\u043D\u043E\u0439 \u043C\u0430\u0433,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0433\u043E\u0442\u043E\u0432\u0438\u0442
      \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044C \u0438 \u043B\u043E\u0432\u0438\u0442
      \u0432\u0440\u0430\u0433\u043E\u0432 \u0432 \u043E\u043A\u043D\u043E \u0443\u044F\u0437\u0432\u0438\u043C\u043E\u0441\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 3196892471298
    m_Localized: "\u041D\u0430\u0434\u0451\u0436\u043D\u044B\u0439 \u0437\u0430\u0449\u0438\u0442\u043D\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 3196892471299
    m_Localized: "\u0421\u0442\u043E\u0439\u043A\u0438\u0439 \u0444\u0440\u043E\u043D\u0442\u043E\u0432\u0438\u043A,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0434\u0435\u0440\u0436\u0438\u0442
      \u043B\u0438\u043D\u0438\u044E \u0438 \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u0435\u0442
      \u0441\u043E\u044E\u0437\u043D\u0438\u043A\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 3196892471300
    m_Localized: "\u0416\u0435\u043B\u0435\u0437\u043D\u044B\u0439 \u043A\u043E\u043F\u0435\u0439\u0449\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 3196892471301
    m_Localized: "\u0414\u0438\u0441\u0446\u0438\u043F\u043B\u0438\u043D\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439
      \u0430\u0432\u0430\u043D\u0433\u0430\u0440\u0434, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u043F\u0440\u043E\u0434\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442 \u0444\u0440\u043E\u043D\u0442
      \u043B\u0438\u043D\u0435\u0439\u043D\u044B\u043C \u0443\u0440\u043E\u043D\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 3196892471302
    m_Localized: "\u041B\u0435\u0441\u043D\u043E\u0439 \u0441\u043B\u0435\u0434\u043E\u043F\u044B\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 3196892471303
    m_Localized: "\u041C\u043E\u0431\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u0445\u043E\u0442\u043D\u0438\u043A,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u043E
      \u0434\u0435\u0440\u0436\u0438\u0442 \u0446\u0435\u043B\u044C \u043F\u043E\u0434
      \u0434\u0430\u0432\u043B\u0435\u043D\u0438\u0435\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 3196892471304
    m_Localized: "\u041C\u043E\u043D\u0430\u0445 \u0432\u0438\u0445\u0440\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 3196892471305
    m_Localized: "\u041F\u043E\u0434\u0432\u0438\u0436\u043D\u044B\u0439 \u043C\u0430\u0441\u0442\u0435\u0440
      \u0431\u043E\u044F, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043B\u043E\u043C\u0430\u0435\u0442
      \u043F\u043E\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435 \u0432\u0440\u0430\u0433\u0430
      \u0441\u0435\u0440\u0438\u0435\u0439 \u0442\u043E\u043B\u0447\u043A\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 3196892471306
    m_Localized: "\u0421\u0432\u0435\u0442\u043B\u044B\u0439 \u043F\u0430\u0441\u0442\u044B\u0440\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 3196892471307
    m_Localized: "\u0411\u043E\u0435\u0432\u043E\u0439 \u043B\u0435\u043A\u0430\u0440\u044C,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442
      \u043A\u043E\u043C\u0430\u043D\u0434\u0443 \u043D\u0430 \u0433\u0440\u0430\u043D\u0438
      \u0432\u044B\u0436\u0438\u0432\u0430\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 3196892471308
    m_Localized: "\u041E\u043F\u043B\u043E\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 3196892471309
    m_Localized: "\u0429\u0438\u0442 \u041E\u043F\u043B\u043E\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 3196892471310
    m_Localized: "\u0423\u043A\u043B\u043E\u043D\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 3196892471311
    m_Localized: "\u0417\u0430\u043C\u043E\u0440\u043E\u0437\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 3196892471312
    m_Localized: "\u041C\u0435\u0442\u043A\u0430 \u043E\u0445\u043E\u0442\u043D\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 3196892471313
    m_Localized: "\u041B\u0435\u0434\u044F\u043D\u044B\u0435 \u043E\u043A\u043E\u0432\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 3196892471314
    m_Localized: "\u0420\u0435\u0448\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
      \u0443\u0434\u0430\u0440: \u043E\u0433\u043B\u0443\u0448\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 3196892471315
    m_Localized: "\u0420\u0435\u0448\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
      \u0443\u0434\u0430\u0440: \u043E\u0441\u043B\u0430\u0431\u043B\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 3196892471316
    m_Localized: "\u0421\u043A\u0440\u044B\u0442\u043D\u043E\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 3196892471317
    m_Localized: "\u0421\u043A\u0440\u044B\u0442\u043D\u043E\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 3196892471318
    m_Localized: "\u041F\u0440\u0438\u0437\u0435\u043C\u043B\u0435\u043D\u0438\u0435
