  - m_Id: 5009382259810304
    m_Localized: "\u041F\u043E \u043F\u043B\u043E\u0449\u0430\u0434\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 5196083758358528
    m_Localized: "\u0426\u0435\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
      \u0441\u0432\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 5196083846438912
    m_Localized: "\u041B\u0443\u0447 \u0441\u0432\u0435\u0442\u0430 \u043B\u0435\u0447\u0438\u0442
      \u0441\u043E\u044E\u0437\u043D\u0438\u043A\u043E\u0432 \u043D\u0430 \u0441\u0432\u043E\u0451\u043C
      \u043F\u0443\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 5619108630749184
    m_Localized: "\u0413\u043E\u0440\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 5619108681080832
    m_Localized: "\u0413\u043E\u0440\u0435\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 5619108681080833
    m_Localized: "\u0413\u043E\u0440\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 5619108681080834
    m_Localized: "\u0413\u043E\u0440\u0435\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 5619108681080835
    m_Localized: "\u041F\u0435\u0440\u0438\u043E\u0434\u0438\u0447\u0435\u0441\u043A\u0438\u0439
      \u0443\u0440\u043E\u043D, \u043F\u043E\u043A\u0430 \u044D\u0444\u0444\u0435\u043A\u0442
      \u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F. \u042D\u0442\u043E [kw:magical],
      \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u0435\u0433\u043E \u0433\u0430\u0441\u0438\u0442
      \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u0431\u0440\u043E\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 5619108681080836
    m_Localized: "\u0413\u043E\u0440\u0435\u043D\u0438\u0435 \u043D\u0430\u043D\u043E\u0441\u0438\u0442
      \u0443\u0440\u043E\u043D \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u043E\u0439
      \u0448\u043A\u043E\u043B\u044B \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0438\u043C\u0438
      \u0434\u043E\u043B\u044F\u043C\u0438, \u043F\u043E\u043A\u0430 \u043D\u0435
      \u0438\u0441\u0442\u0435\u0447\u0451\u0442 \u0434\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C.
      \u0417\u043D\u0430\u0447\u0438\u0442, \u0435\u0433\u043E \u0441\u043D\u0438\u0436\u0430\u0435\u0442
      \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u0431\u0440\u043E\u043D\u044F,
      \u0430 \u043D\u0435 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u0430\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 5619108681080837
    m_Localized: "\u0417\u0430\u043C\u043E\u0440\u043E\u0437\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 5619108681080838
    m_Localized: "\u0417\u0430\u043C\u043E\u0440\u043E\u0437\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 5619108681080839
    m_Localized: "\u0417\u0430\u043C\u043E\u0440\u043E\u0437\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 5619108681080840
    m_Localized: "\u0417\u0430\u043C\u043E\u0440\u043E\u0437\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 5619108681080841
    m_Localized: "\u041C\u0435\u0442\u043A\u0430 \u0445\u043E\u043B\u043E\u0434\u0430:
      \u0441\u0430\u043C\u0430 \u043D\u0435 \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442,
      \u043D\u043E \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u0446\u0435\u043B\u044C
      \u0434\u043B\u044F [kw:stun:gen]."
    m_Metadata:
      m_Items: []
  - m_Id: 5619108681080842
    m_Localized: "\u0417\u0430\u043C\u043E\u0440\u043E\u0437\u043A\u0430 \u043D\u0435
      \u043C\u0435\u0448\u0430\u0435\u0442 \u0446\u0435\u043B\u0438 \u0434\u0435\u0439\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C
      \u2014 \u044D\u0442\u043E \u043C\u0435\u0442\u043A\u0430. \u041D\u0430 \u043D\u0435\u0451
      \u0441\u043C\u043E\u0442\u0440\u044F\u0442 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438
      \u043A\u0440\u0438\u043E\u043C\u0430\u043D\u0442\u0430: \u043E\u043D\u0438
      \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u044E\u0442 \u0432\u0441\u0435\u0445
      \u0437\u0430\u043C\u043E\u0440\u043E\u0436\u0435\u043D\u043D\u044B\u0445 \u0440\u0430\u0437\u043E\u043C
      \u0432 \u043E\u0433\u043B\u0443\u0448\u0451\u043D\u043D\u044B\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 5619108681080843
    m_Localized: "\u042F\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 5619108681080844
    m_Localized: "\u042F\u0434\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 5619108681080845
    m_Localized: "\u042F\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 5619108681080846
    m_Localized: "\u042F\u0434\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 5619108681080847
    m_Localized: "\u0421\u0440\u043E\u0434\u0441\u0442\u0432\u043E \u0443\u0440\u043E\u043D\u0430:
      \u0431\u0440\u043E\u043D\u0451\u0439 \u043D\u0435 \u0433\u0430\u0441\u0438\u0442\u0441\u044F,
      \u043D\u043E \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442 \u043D\u0435
      \u043D\u0430 \u0432\u0441\u0435\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 5619108681080848
    m_Localized: "\u042F\u0434 \u2014 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u0430\u044F
      \u043E\u0441\u044C \u0443\u0440\u043E\u043D\u0430, \u0430 \u043D\u0435 \u0448\u043A\u043E\u043B\u0430.
      \u0411\u0440\u043E\u043D\u044F \u0435\u0433\u043E \u043D\u0435 \u0441\u043D\u0438\u0436\u0430\u0435\u0442;
      \u0432\u043C\u0435\u0441\u0442\u043E \u044D\u0442\u043E\u0433\u043E \u043E\u043D
      \u0437\u0430\u0432\u0438\u0441\u0438\u0442 \u043E\u0442 \u0442\u0438\u043F\u0430
      \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0430: \u043D\u0435\u0436\u0438\u0442\u044C
      \u0438 \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0442\u044B \u043A
      \u044F\u0434\u0443 \u043D\u0435\u0432\u043E\u0441\u043F\u0440\u0438\u0438\u043C\u0447\u0438\u0432\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 5619108681080849
    m_Localized: "\u041E\u0433\u043B\u0443\u0448\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 5619108681080850
    m_Localized: "\u041E\u0433\u043B\u0443\u0448\u0435\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 5619108681080851
    m_Localized: "\u041E\u0433\u043B\u0443\u0448\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 5619108681080852
    m_Localized: "\u041E\u0433\u043B\u0443\u0448\u0435\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 5619108681080853
    m_Localized: "\u0426\u0435\u043B\u044C \u043D\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442,
      \u043F\u043E\u043A\u0430 \u044D\u0444\u0444\u0435\u043A\u0442 \u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F.
      \u0427\u0430\u0441\u0442\u043E \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442
      \u0438\u0437 [kw:frozen:gen]."
    m_Metadata:
      m_Items: []
  - m_Id: 5619108681080854
    m_Localized: "\u041E\u0433\u043B\u0443\u0448\u0435\u043D\u0438\u0435 \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E
      \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442
      \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F \u0446\u0435\u043B\u0438 \u043D\u0430
      \u0432\u0440\u0435\u043C\u044F \u044D\u0444\u0444\u0435\u043A\u0442\u0430:
      \u043D\u0438 \u0430\u0442\u0430\u043A, \u043D\u0438 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0435\u0439,
      \u043D\u0438 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 5619108681080855
    m_Localized: "\u0421\u043A\u0440\u044B\u0442\u043D\u043E\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 5619108681080856
    m_Localized: "\u0421\u043A\u0440\u044B\u0442\u043D\u043E\u0441\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 5619108681080857
    m_Localized: "\u0421\u043A\u0440\u044B\u0442\u043D\u043E\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 5619108681080858
    m_Localized: "\u042E\u043D\u0438\u0442\u0430 \u043D\u0435 \u0432\u044B\u0431\u0438\u0440\u0430\u044E\u0442
      \u0446\u0435\u043B\u044C\u044E, \u043F\u043E\u043A\u0430 \u043E\u043D \u043D\u0435
      \u0443\u0434\u0430\u0440\u0438\u0442 \u0441\u0430\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 5619108681080859
    m_Localized: "\u041F\u043E\u043A\u0430 \u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F
      \u0441\u043A\u0440\u044B\u0442\u043D\u043E\u0441\u0442\u044C, \u0432\u0440\u0430\u0433\u0438
      \u043D\u0435 \u0431\u0435\u0440\u0443\u0442 \u044E\u043D\u0438\u0442\u0430
      \u0432 \u0446\u0435\u043B\u044C. \u041F\u0435\u0440\u0432\u0430\u044F \u0436\u0435
      \u0435\u0433\u043E \u0430\u0432\u0442\u043E-\u0430\u0442\u0430\u043A\u0430
      \u0441\u043D\u0438\u043C\u0430\u0435\u0442 \u044D\u0444\u0444\u0435\u043A\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 5619108681080860
    m_Localized: "\u041C\u0435\u0442\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 5619108681080861
    m_Localized: "\u041C\u0435\u0442\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 5619108681080862
    m_Localized: "\u041C\u0435\u0442\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 5619108681080863
    m_Localized: "\u041C\u0435\u0442\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 5619108681080864
    m_Localized: "\u041E\u0442\u043C\u0435\u0447\u0435\u043D\u043D\u0430\u044F \u0446\u0435\u043B\u044C
      \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442 \u0431\u043E\u043B\u044C\u0448\u0435
      \u0443\u0440\u043E\u043D\u0430 \u0438 \u043F\u0440\u0438\u0442\u044F\u0433\u0438\u0432\u0430\u0435\u0442
      \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435 \u0432\u0440\u0430\u0433\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 5619108681080865
    m_Localized: "\u041C\u0435\u0442\u043A\u0430 \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442
      \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u043C\u044B\u0439 \u0446\u0435\u043B\u044C\u044E
      \u0443\u0440\u043E\u043D \u0438 \u043F\u043E\u0432\u044B\u0448\u0430\u0435\u0442
      \u0435\u0451 \u043F\u0440\u0438\u043E\u0440\u0438\u0442\u0435\u0442 \u0434\u043B\u044F
      \u0418\u0418: \u043E\u0442\u043C\u0435\u0447\u0435\u043D\u043D\u043E\u0433\u043E
      \u0434\u043E\u0431\u0438\u0432\u0430\u044E\u0442 \u043E\u0445\u043E\u0442\u043D\u0435\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 5619108681080866
    m_Localized: "\u0429\u0438\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 5619108681080867
    m_Localized: "\u0429\u0438\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 5619108681080868
    m_Localized: "\u0429\u0438\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 5619108681080869
    m_Localized: "\u0429\u0438\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 5619108681080870
    m_Localized: "\u0412\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0439 \u0437\u0430\u043F\u0430\u0441
      \u043F\u0440\u043E\u0447\u043D\u043E\u0441\u0442\u0438: \u0442\u0440\u0430\u0442\u0438\u0442\u0441\u044F
      \u0440\u0430\u043D\u044C\u0448\u0435 \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F
      \u0438 \u043D\u0435 \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u043B\u0435\u0447\u0435\u043D\u0438\u0435\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 5619108681080871
    m_Localized: "\u0429\u0438\u0442 \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442
      \u0443\u0440\u043E\u043D \u0432\u043C\u0435\u0441\u0442\u043E \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F,
      \u043F\u043E\u043A\u0430 \u043D\u0435 \u0438\u0441\u0441\u044F\u043A\u043D\u0435\u0442
      \u0438\u043B\u0438 \u043D\u0435 \u0438\u0441\u0442\u0435\u0447\u0451\u0442.
      \u041B\u0435\u0447\u0435\u043D\u0438\u0435 \u0435\u0433\u043E \u043D\u0435
      \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 5619108681080872
    m_Localized: "\u0411\u0440\u043E\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 5619108681080873
    m_Localized: "\u0411\u0440\u043E\u043D\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 5619108681080874
    m_Localized: "\u0411\u0440\u043E\u043D\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 5619108681080875
    m_Localized: "\u0421\u043D\u0438\u0436\u0430\u0435\u0442 \u0443\u0440\u043E\u043D
      \u0441\u0432\u043E\u0435\u0439 \u0448\u043A\u043E\u043B\u044B: [kw:physical]
      \u0438\u043B\u0438 [kw:magical]. [kw:true] \u043D\u0435 \u0441\u043D\u0438\u0436\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 5619108681080876
    m_Localized: "\u0411\u0440\u043E\u043D\u044F \u0433\u0430\u0441\u0438\u0442 \u0443\u0440\u043E\u043D
      \u0442\u043E\u0439 \u0448\u043A\u043E\u043B\u044B, \u043A \u043A\u043E\u0442\u043E\u0440\u043E\u0439
      \u043E\u0442\u043D\u043E\u0441\u0438\u0442\u0441\u044F. \u0427\u0438\u0441\u0442\u044B\u0439
      \u0443\u0440\u043E\u043D \u043E\u043D\u0430 \u043D\u0435 \u0441\u043D\u0438\u0436\u0430\u0435\u0442,
      \u0438 \u0441\u0440\u043E\u0434\u0441\u0442\u0432\u043E (\u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440,
      \u044F\u0434) \u0442\u043E\u0436\u0435 \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442
      \u043C\u0438\u043C\u043E \u043D\u0435\u0451."
    m_Metadata:
      m_Items: []
  - m_Id: 5619108681080877
    m_Localized: "\u0424\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u0443\u0440\u043E\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 5619108681080878
    m_Localized: "\u0424\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
      \u0443\u0440\u043E\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 5619108681080879
    m_Localized: "\u0424\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u0443\u0440\u043E\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 5619108681080880
    m_Localized: "\u0428\u043A\u043E\u043B\u0430 \u0443\u0440\u043E\u043D\u0430,
      \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u0433\u0430\u0441\u0438\u0442 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u0430\u044F
      [kw:armor]."
    m_Metadata:
      m_Items: []
  - m_Id: 5619108681080881
    m_Localized: "\u0424\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u0448\u043A\u043E\u043B\u0430
      \u0434\u0435\u043B\u0438\u0442\u0441\u044F \u043D\u0430 \u043F\u043E\u0434\u0442\u0438\u043F\u044B
      \u2014 \u0434\u0440\u043E\u0431\u044F\u0449\u0438\u0439, \u0440\u0435\u0436\u0443\u0449\u0438\u0439
      \u0438 \u043A\u043E\u043B\u044E\u0449\u0438\u0439. \u041F\u043E\u0434\u0442\u0438\u043F
      \u043E\u043F\u0438\u0441\u044B\u0432\u0430\u0435\u0442 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440
      \u0443\u0434\u0430\u0440\u0430; \u0441\u043D\u0438\u0436\u0430\u0435\u0442
      \u0442\u0430\u043A\u043E\u0439 \u0443\u0440\u043E\u043D \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u0430\u044F
      \u0431\u0440\u043E\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 5619108681080882
    m_Localized: "\u041C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u0443\u0440\u043E\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 5619108681080883
    m_Localized: "\u041C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
      \u0443\u0440\u043E\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 5619108681080884
    m_Localized: "\u041C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u0443\u0440\u043E\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 5619108681080885
    m_Localized: "\u0428\u043A\u043E\u043B\u0430 \u0443\u0440\u043E\u043D\u0430,
      \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u0433\u0430\u0441\u0438\u0442 \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0430\u044F
      [kw:armor]: \u043E\u0433\u043E\u043D\u044C, \u043B\u0451\u0434, \u043C\u043E\u043B\u043D\u0438\u044F
      \u0438 \u0430\u0440\u043A\u0430\u043D\u0430 \u0438\u0434\u0443\u0442 \u043F\u043E\u0434
      \u043D\u0435\u0439 \u043E\u0434\u043D\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 5619108681080886
    m_Localized: "\u041E\u0433\u043E\u043D\u044C, \u043B\u0451\u0434, \u043C\u043E\u043B\u043D\u0438\u044F
      \u0438 \u0430\u0440\u043A\u0430\u043D\u0430 \u2014 \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u044B
      \u043E\u0434\u043D\u043E\u0439 \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u043E\u0439
      \u0448\u043A\u043E\u043B\u044B: \u0440\u0430\u0437\u043B\u0438\u0447\u0430\u044E\u0442\u0441\u044F
      \u043C\u0435\u0445\u0430\u043D\u0438\u043A\u043E\u0439, \u043D\u043E \u0441\u043D\u0438\u0436\u0430\u044E\u0442\u0441\u044F
      \u043E\u0431\u0449\u0435\u0439 \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u043E\u0439
      \u0431\u0440\u043E\u043D\u0451\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 5619108681080887
    m_Localized: "\u0427\u0438\u0441\u0442\u044B\u0439 \u0443\u0440\u043E\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 5619108681080888
    m_Localized: "\u0427\u0438\u0441\u0442\u043E\u0433\u043E \u0443\u0440\u043E\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 5619108681080889
    m_Localized: "\u0427\u0438\u0441\u0442\u044B\u0439 \u0443\u0440\u043E\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 5619108681080890
    m_Localized: "\u0423\u0440\u043E\u043D \u043C\u0438\u043C\u043E \u0431\u0440\u043E\u043D\u0438:
      \u043D\u0438 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u0430\u044F,
      \u043D\u0438 \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0430\u044F [kw:armor]
      \u0435\u0433\u043E \u043D\u0435 \u0441\u043D\u0438\u0436\u0430\u044E\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 5619108681080891
    m_Localized: "\u0427\u0438\u0441\u0442\u044B\u0439 \u0443\u0440\u043E\u043D \u0438\u0433\u043D\u043E\u0440\u0438\u0440\u0443\u0435\u0442
      \u043E\u0431\u0435 \u0431\u0440\u043E\u043D\u0438. \u0421\u0440\u043E\u0434\u0441\u0442\u0432\u043E
      \u043F\u043E\u0432\u0435\u0440\u0445 \u043D\u0435\u0433\u043E \u043F\u043E-\u043F\u0440\u0435\u0436\u043D\u0435\u043C\u0443
      \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442 \u2014 \u0446\u0435\u043B\u044C
      \u043C\u043E\u0436\u0435\u0442 \u043E\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F
      \u043D\u0435\u0432\u043E\u0441\u043F\u0440\u0438\u0438\u043C\u0447\u0438\u0432\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 5619108681080892
    m_Localized: "\u0423\u0433\u0440\u043E\u0437\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 5619108681080893
    m_Localized: "\u0423\u0433\u0440\u043E\u0437\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 5619108681080894
    m_Localized: "\u0423\u0433\u0440\u043E\u0437\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 5619108681080895
    m_Localized: "\u0427\u0435\u043C \u0432\u044B\u0448\u0435 \u0443\u0433\u0440\u043E\u0437\u0430
      \u044E\u043D\u0438\u0442\u0430, \u0442\u0435\u043C \u043E\u0445\u043E\u0442\u043D\u0435\u0435
      \u0432\u0440\u0430\u0433\u0438 \u0432\u044B\u0431\u0438\u0440\u0430\u044E\u0442
      \u0435\u0433\u043E \u0446\u0435\u043B\u044C\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 5619108681080896
    m_Localized: "\u0423\u0433\u0440\u043E\u0437\u0430 \u2014 \u044D\u0442\u043E
      \u0432\u0435\u0441 \u0432 \u0432\u044B\u0431\u043E\u0440\u0435 \u0446\u0435\u043B\u0438
      \u0432\u0440\u0430\u0433\u043E\u043C, \u0430 \u043D\u0435 \u0441\u0442\u0435\u043D\u0430:
      \u043E\u043D\u0430 \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442
      \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435 \u043D\u0430 \u0442\u0430\u043D\u043A\u0435,
      \u043D\u043E \u043D\u0435 \u0437\u0430\u043F\u0440\u0435\u0449\u0430\u0435\u0442
      \u0432\u0440\u0430\u0433\u0443 \u043F\u0435\u0440\u0435\u043A\u043B\u044E\u0447\u0438\u0442\u044C\u0441\u044F."
    m_Metadata:
