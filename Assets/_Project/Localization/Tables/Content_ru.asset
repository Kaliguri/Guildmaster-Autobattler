  - m_Id: 6901444622147584
    m_Localized: "\u0410\u0440\u043A\u0430\u043D\u0438\u0441\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 6901444643119104
    m_Localized: "\u041C\u0430\u0433 \u0440\u0430\u0437\u043B\u043E\u043C\u0430:
      \u0432\u044B\u043F\u0430\u0434\u0430\u0435\u0442 \u0438\u0437-\u043F\u043E\u0434
      \u0431\u043B\u0438\u0436\u043D\u0435\u0433\u043E \u0443\u0434\u0430\u0440\u0430
      \u0438 \u0440\u0435\u0436\u0435\u0442 \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0443\u044E
      \u0437\u0430\u0449\u0438\u0442\u0443 \u0446\u0435\u043B\u0438. \u0427\u0435\u043C
      \u0434\u043E\u043B\u044C\u0448\u0435 \u0431\u043E\u0439, \u0442\u0435\u043C
      \u0448\u0438\u0440\u0435 \u0435\u0433\u043E \u0437\u0430\u043B\u043F."
    m_Metadata:
      m_Items: []
  - m_Id: 6901444643119105
    m_Localized: "\u0420\u0430\u0437\u043B\u0430\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 6901444643119106
    m_Localized: "\u041C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u0437\u0430\u0449\u0438\u0442\u0430
      \u0446\u0435\u043B\u0438 \u0441\u043D\u0438\u0436\u0435\u043D\u0430. \u0421\u0442\u0430\u043A\u0438
      \u0441\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u044E\u0442\u0441\u044F \u0438
      \u043E\u0431\u043D\u043E\u0432\u043B\u044F\u044E\u0442 \u0441\u0440\u043E\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 6901444643119107
    m_Localized: "\u0421\u043C\u0435\u0449\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 6901444643119108
    m_Localized: "\u0420\u0430\u0437 \u0432 15 \u0441\u0435\u043A \u0431\u043B\u0438\u0436\u043D\u0438\u0439
      \u0443\u0434\u0430\u0440 \u043E\u0442\u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F
      \u0446\u0435\u043B\u0438\u043A\u043E\u043C: \u043D\u043E\u0441\u0438\u0442\u0435\u043B\u044C
      \u0443\u0445\u043E\u0434\u0438\u0442 \u0442\u0435\u043B\u0435\u043F\u043E\u0440\u0442\u043E\u043C
      \u0432 \u0442\u044B\u043B \u0438 \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442
      [kw:shield:acc]."
    m_Metadata:
      m_Items: []
  - m_Id: 6901444643119109
    m_Localized: "\u0429\u0438\u0442 \u0440\u0430\u0437\u043B\u043E\u043C\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 6901444643119110
    m_Localized: "\u041F\u043E\u0433\u043B\u043E\u0449\u0430\u0435\u0442 \u0443\u0440\u043E\u043D
      3 \u0441\u0435\u043A\u0443\u043D\u0434\u044B \u043F\u043E\u0441\u043B\u0435
      \u0441\u043C\u0435\u0449\u0435\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 6901444643119111
    m_Localized: "\u041D\u043E\u0447\u043D\u043E\u0435 \u043B\u0435\u0437\u0432\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 6901444643119112
    m_Localized: "\u0422\u0435\u043D\u044C \u0441 \u043A\u0443\u043D\u0430\u044F\u043C\u0438:
      \u043D\u0435 \u0440\u0443\u0431\u0438\u0442, \u0430 \u0436\u0430\u043B\u0438\u0442.
      \u0423\u0434\u0430\u0440 \u0432 \u0441\u043F\u0438\u043D\u0443 \u0433\u043D\u043E\u0438\u0442
      \u0440\u0430\u043D\u0443 \u0432\u0434\u0432\u043E\u0435 \u0438 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442
      \u0446\u0435\u043B\u044C \u0434\u043B\u044F \u0432\u0441\u0435\u0439 \u043A\u043E\u043C\u0430\u043D\u0434\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 6901444643119113
    m_Localized: "\u0413\u043D\u0438\u043B\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 6901444643119114
    m_Localized: "\u042F\u0434 \u0442\u043E\u0447\u0438\u0442 \u0446\u0435\u043B\u044C
      \u0438 \u0441\u043D\u0438\u043C\u0430\u0435\u0442 \u043F\u043E 3 \u0431\u0440\u043E\u043D\u0438
      \u043E\u0431\u0435\u0438\u0445 \u0448\u043A\u043E\u043B \u0437\u0430 \u0441\u0442\u0430\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 6901444643119115
    m_Localized: "\u042F\u0434\u043E\u0432\u0438\u0442\u044B\u0435 \u043A\u043B\u0438\u043D\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 6901444643119116
    m_Localized: "\u0423\u0434\u0430\u0440 \u0432 \u0442\u044B\u043B \u043D\u0430\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442
      \u0434\u0432\u043E\u0439\u043D\u0443\u044E [kw:poison:acc]."
    m_Metadata:
      m_Items: []
  - m_Id: 6901444643119117
    m_Localized: "\u042F\u0434\u043E\u0432\u0438\u0442\u0430\u044F \u043F\u0435\u0447\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 6901444643119118
    m_Localized: "\u0427\u0435\u0440\u0435\u0437 3 \u0441\u0435\u043A\u0443\u043D\u0434\u044B
      \u043F\u0435\u0447\u0430\u0442\u044C \u0432\u0437\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F,
      \u043D\u0430\u043D\u043E\u0441\u044F \u0443\u0440\u043E\u043D \u043E\u0431\u0435\u0438\u043C\u0438
      \u0448\u043A\u043E\u043B\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 6901444643119119
    m_Localized: "\u041C\u043E\u043D\u0430\u0445 \u0432\u043E\u0434\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 6901444643119120
    m_Localized: "\u0421\u043F\u043E\u043A\u043E\u0439\u043D\u0430\u044F \u0441\u0438\u043B\u0430
      \u0441 \u043F\u043E\u0441\u043E\u0445\u043E\u043C: \u0434\u0435\u0440\u0436\u0438\u0442
      \u0441\u0442\u0440\u043E\u0439, \u0440\u0430\u0437 \u0432 \u0447\u0435\u0442\u044B\u0440\u0435
      \u0441\u0435\u043A\u0443\u043D\u0434\u044B \u0440\u0430\u0441\u043A\u0438\u0434\u044B\u0432\u0430\u0435\u0442
      \u043D\u0430\u0431\u0435\u0433\u0430\u044E\u0449\u0438\u0445 \u0438 \u043E\u0434\u0435\u0432\u0430\u0435\u0442
      \u0441\u043E\u044E\u0437\u043D\u0438\u043A\u0430 \u0432 \u0432\u043E\u0434\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 6901444643119121
    m_Localized: "\u0412\u043E\u0441\u0445\u043E\u0434\u044F\u0449\u0438\u0439 \u0443\u0434\u0430\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 6901444643119122
    m_Localized: "\u0420\u0430\u0437 \u0432 4 \u0441\u0435\u043A\u0443\u043D\u0434\u044B
      \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u0443\u0434\u0430\u0440
      \u0431\u044C\u0451\u0442 \u0432\u0434\u0432\u043E\u0435 \u0441\u0438\u043B\u044C\u043D\u0435\u0435
      \u0438 \u043E\u0442\u0431\u0440\u0430\u0441\u044B\u0432\u0430\u0435\u0442 \u0446\u0435\u043B\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 6901444643119123
    m_Localized: "\u0412\u0437\u0432\u0435\u0434\u0451\u043D\u043D\u0430\u044F \u0432\u043E\u043B\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 6901444643119124
    m_Localized: "\u0421\u043B\u0435\u0434\u0443\u044E\u0449\u0430\u044F \u0430\u0442\u0430\u043A\u0430
      \u0443\u0441\u0438\u043B\u0435\u043D\u0430 \u0438 \u0442\u043E\u043B\u043A\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 6901444643119125
    m_Localized: "\u0412\u043E\u0434\u044F\u043D\u043E\u0439 \u0449\u0438\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 6901444643119126
    m_Localized: "\u041F\u043E\u0433\u043B\u043E\u0449\u0430\u0435\u0442 \u0443\u0440\u043E\u043D
      5 \u0441\u0435\u043A\u0443\u043D\u0434. \u041F\u043E \u0438\u0441\u0442\u0435\u0447\u0435\u043D\u0438\u0438
      \u0438\u043B\u0438 \u043F\u0440\u0438 \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0435\u043D\u0438\u0438
      \u0440\u0430\u0437\u043B\u0435\u0442\u0430\u0435\u0442\u0441\u044F \u0432\u043E\u043B\u043D\u043E\u0439:
      \u0442\u043E\u043B\u043A\u0430\u0435\u0442 \u0438 \u0437\u0430\u043C\u0435\u0434\u043B\u044F\u0435\u0442
      \u0432\u0440\u0430\u0433\u043E\u0432 \u0440\u044F\u0434\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 6901444643119127
    m_Localized: "\u041E\u0442\u043B\u0438\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 6901444643119128
    m_Localized: "\u0421\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u043F\u0435\u0440\u0435\u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F
      \u0441\u043D\u0438\u0436\u0435\u043D\u0430 \u043D\u0430 60%."
    m_Metadata:
      m_Items: []
  - m_Id: 6901444643119129
    m_Localized: "\u0425\u0440\u0430\u043D\u0438\u0442\u0435\u043B\u044C \u0443\u0433\u043B\u0435\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 6901444643119130
    m_Localized: "\u041E\u043D \u043D\u0435 \u0442\u0443\u0448\u0438\u0442 \u043E\u0433\u043E\u043D\u044C,
      \u0430 \u0434\u0435\u043B\u0438\u0442\u0441\u044F \u0438\u043C: \u0443\u0433\u043B\u0438
      \u043D\u0430 \u0441\u043E\u044E\u0437\u043D\u0438\u043A\u0430\u0445 \u0437\u0430\u043A\u0430\u043B\u044F\u044E\u0442,
      \u0430 \u043D\u0435 \u0436\u0433\u0443\u0442. \u0421\u0430\u043C \u0433\u0440\u0435\u0435\u0442\u0441\u044F
      \u043E\u0442 \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u0441\u0432\u043E\u0435\u0433\u043E
      \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 6901444643119131
    m_Localized: "\u0422\u0451\u043F\u043B\u044B\u0439 \u043F\u0435\u043F\u0435\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 6901444643119132
    m_Localized: "\u041A\u0430\u0436\u0434\u044B\u0439 \u0441\u0442\u0430\u043A \u0441\u043E\u043A\u0440\u0430\u0449\u0430\u0435\u0442
      \u0434\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C \u0434\u0435\u0431\u0430\u0444\u0444\u043E\u0432
      \u043D\u0430 10%, \u0434\u043E \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 6901444643119133
    m_Localized: "\u0417\u0430\u0441\u043B\u043E\u043D \u043E\u0442 \u0436\u0430\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 6901444643119134
    m_Localized: "\u0423\u0440\u043E\u043D \u043E\u0433\u043D\u0451\u043C \u0441\u043D\u0438\u0436\u0435\u043D
      \u043D\u0430 25%."
    m_Metadata:
      m_Items: []
  - m_Id: 6901444643119135
    m_Localized: "\u0416\u0438\u0432\u043E\u0439 \u0443\u0433\u043E\u043B\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 6901444643119136
    m_Localized: "\u0421\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0435
      \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u044F \u043E\u0433\u043D\u0451\u043C
      \u0433\u0440\u0435\u044E\u0442 \u043D\u043E\u0441\u0438\u0442\u0435\u043B\u044F,
      \u0430 \u0435\u0433\u043E \u0443\u0440\u043E\u043D \u0440\u0430\u0441\u0442\u0451\u0442
      \u043E\u0442 \u043D\u0430\u043A\u043E\u043F\u043B\u0435\u043D\u043D\u044B\u0445
      \u0443\u0433\u043B\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 6901444643119137
    m_Localized: "\u0420\u0430\u0437\u0434\u0443\u0442\u044C \u0436\u0430\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 6901444643119138
    m_Localized: "\u0421\u0438\u043B\u044C\u043D\u043E\u0435 \u0440\u0430\u0437\u0432\u0435\u0438\u0432\u0430\u043D\u0438\u0435:
      \u0441\u043D\u0438\u043C\u0430\u0435\u0442 \u0434\u0430\u0436\u0435 \u0442\u043E,
      \u0447\u0442\u043E \u043D\u0435 \u0431\u0435\u0440\u0451\u0442 \u043B\u0435\u043A\u0430\u0440\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 6906555314462720
    m_Localized: "\u0410\u043D\u0442\u0438\u043C\u0430\u0433"
    m_Metadata:
      m_Items: []
  - m_Id: 6906555327045632
    m_Localized: "\u0412\u043E\u0438\u043D, \u043E\u0431\u0443\u0447\u0435\u043D\u043D\u044B\u0439
      \u0433\u0430\u0441\u0438\u0442\u044C \u0447\u0443\u0436\u0443\u044E \u043C\u0430\u0433\u0438\u044E.
      \u041A\u0430\u0436\u0434\u043E\u0435 \u0432\u0440\u0430\u0436\u0435\u0441\u043A\u043E\u0435
      \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u0438\u0435 \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
      \u043D\u0430 \u043D\u0451\u043C \u043D\u0430\u043B\u0451\u0442 \u0441\u0438\u043B\u044B,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043E\u043D \u043F\u043E\u0442\u043E\u043C
      \u0448\u0432\u044B\u0440\u044F\u0435\u0442 \u043E\u0431\u0440\u0430\u0442\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 6906555327045633
    m_Localized: "\u0427\u0430\u0440\u043D\u044B\u0439 \u043D\u0430\u043B\u0451\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 6906555327045634
    m_Localized: "\u041F\u043E\u0433\u043B\u043E\u0449\u0430\u0435\u0442 \u0442\u043E\u043B\u044C\u043A\u043E
      \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u0443\u0440\u043E\u043D.
      \u041D\u0430\u043B\u0451\u0442\u044B \u043A\u043E\u043F\u044F\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 6906555327045635
    m_Localized: "\u041E\u0442\u0440\u0430\u0436\u0430\u044E\u0449\u0438\u0439 \u043D\u0430\u043B\u0451\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 6906555327045636
    m_Localized: "\u041A\u0430\u0436\u0434\u043E\u0435 \u0432\u0440\u0430\u0436\u0435\u0441\u043A\u043E\u0435
      \u0437\u0430\u043A\u043B\u0438\u043D\u0430\u043D\u0438\u0435 \u043E\u0434\u0435\u0432\u0430\u0435\u0442
      \u043D\u043E\u0441\u0438\u0442\u0435\u043B\u044F \u0432 \u0449\u0438\u0442
      \u043E\u0442 \u043C\u0430\u0433\u0438\u0438 \u2014 \u0434\u043E \u0442\u043E\u0433\u043E,
      \u043A\u0430\u043A \u043F\u043E \u043D\u0435\u043C\u0443 \u0443\u0434\u0430\u0440\u044F\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 6906555327045637
    m_Localized: "\u041F\u0435\u0440\u0435\u0433\u0440\u0443\u0437\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 6906555327045638
    m_Localized: "\u0428\u0432\u044B\u0440\u044F\u0435\u0442 \u0432 \u0446\u0435\u043B\u044C
      \u0434\u043E\u043B\u044E \u0432\u0441\u0435\u0433\u043E \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
      \u0443\u0440\u043E\u043D\u0430, \u043F\u043E\u0433\u043B\u043E\u0449\u0451\u043D\u043D\u043E\u0433\u043E
      \u0441 \u043F\u0440\u043E\u0448\u043B\u043E\u0439 \u041F\u0435\u0440\u0435\u0433\u0440\u0443\u0437\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 6908399222775808
    m_Localized: "\u041F\u043E\u0436\u0438\u0440\u0430\u0442\u0435\u043B\u044C \u0441\u043D\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 6908399256330240
    m_Localized: "\u0423\u0441\u044B\u043F\u043B\u044F\u0435\u0442 \u0446\u0435\u043B\u044C
      \u0438 \u043E\u0431\u0433\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442 \u0435\u0451
      \u0441\u043E\u043D: \u0447\u0435\u043C \u0434\u043E\u043B\u044C\u0448\u0435
      \u043E\u043D\u0430 \u0441\u043F\u0438\u0442, \u0442\u0435\u043C \u0431\u043E\u043B\u044C\u043D\u0435\u0435
      \u043A\u0430\u0436\u0434\u044B\u0439 \u0442\u0438\u043A. \u041A\u043E\u043C\u0430\u043D\u0434\u0430
      \u043E\u0431\u044F\u0437\u0430\u043D\u0430 \u0434\u0435\u0440\u0436\u0430\u0442\u044C
      \u0440\u0443\u043A\u0438 \u043F\u0440\u0438 \u0441\u0435\u0431\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 6908399256330241
    m_Localized: "\u0421\u043E\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 6908399256330242
    m_Localized: "\u0426\u0435\u043B\u044C \u043D\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442
      \u0438 \u0432\u044B\u043F\u0430\u0434\u0430\u0435\u0442 \u0438\u0437 \u0432\u044B\u0431\u043E\u0440\u0430
      \u0446\u0435\u043B\u0438. \u0427\u0443\u0436\u043E\u0439 \u0443\u0434\u0430\u0440
      \u0431\u0443\u0434\u0438\u0442 \u0435\u0451 \u0438 \u0431\u044C\u0451\u0442
      \u0432\u0434\u0432\u043E\u0435 \u0441\u0438\u043B\u044C\u043D\u0435\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 6908399256330243
    m_Localized: "\u041A\u043E\u0448\u043C\u0430\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 6908399256330244
    m_Localized: "\u0423\u0440\u043E\u043D \u0442\u044C\u043C\u043E\u0439, \u0440\u0430\u0441\u0442\u0443\u0449\u0438\u0439
      \u0437\u0430 \u043A\u0430\u0436\u0434\u0443\u044E \u0441\u0435\u043A\u0443\u043D\u0434\u0443
      \u0441\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 6997959210426368
    m_Localized: "\u0425\u043B\u0430\u0434\u043D\u043E\u0440\u043E\u0436\u0434\u0451\u043D\u043D\u044B\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 6997959269146624
    m_Localized: "\u041C\u0451\u0440\u0442\u0432\u044B\u0439 \u0432\u043E\u0438\u043D
      \u0438\u0437 \u043C\u0435\u0440\u0437\u043B\u043E\u0442\u044B: \u0431\u044C\u0451\u0442
      \u0442\u044F\u0436\u0435\u043B\u043E \u0438 \u0440\u0435\u0434\u043A\u043E,
      \u0432\u0433\u043E\u043D\u044F\u044F \u0432 \u0446\u0435\u043B\u044C \u0445\u043E\u043B\u043E\u0434.
      \u041A\u043E\u0433\u0434\u0430 \u0446\u0435\u043B\u044C \u043F\u0440\u043E\u043C\u0435\u0440\u0437\u0430\u0435\u0442
      \u043D\u0430\u0441\u043C\u0435\u0440\u0442\u044C \u2014 \u0434\u043E\u0431\u0438\u0432\u0430\u0435\u0442
      \u043E\u0434\u043D\u0438\u043C \u0440\u0430\u0437\u043C\u0430\u0448\u0438\u0441\u0442\u044B\u043C
      \u0443\u0434\u0430\u0440\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 6997959269146625
    m_Localized: "\u0418\u0437\u043C\u043E\u0440\u043E\u0437\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 6997959269146626
    m_Localized: "\u0425\u043E\u043B\u043E\u0434 \u043A\u043E\u043F\u0438\u0442\u0441\u044F
      \u043D\u0430 \u0446\u0435\u043B\u0438: \u0441\u043D\u0430\u0447\u0430\u043B\u0430
      \u0437\u0430\u043C\u0435\u0434\u043B\u044F\u0435\u0442, \u043F\u043E\u0442\u043E\u043C
      \u043F\u0440\u0438\u043A\u043E\u0432\u044B\u0432\u0430\u0435\u0442 \u043A \u043C\u0435\u0441\u0442\u0443,
      \u0430 \u043D\u0430 \u043F\u0440\u0435\u0434\u0435\u043B\u0435 \u043E\u0431\u0440\u0430\u0449\u0430\u0435\u0442
      \u0432 \u043B\u0451\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 6997959269146627
    m_Localized: "\u041F\u0440\u0438\u043C\u0451\u0440\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 6997959269146628
    m_Localized: "\u0426\u0435\u043B\u044C \u043D\u0435 \u043C\u043E\u0436\u0435\u0442
      \u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F, \u043D\u043E \u043C\u043E\u0436\u0435\u0442
      \u0434\u0435\u0439\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 6997959273340928
    m_Localized: "\u041E\u0431\u0440\u0430\u0442\u0438\u043B\u0441\u044F \u0432 \u043B\u0451\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 6997959273340929
    m_Localized: "\u0426\u0435\u043B\u044C \u043E\u0433\u043B\u0443\u0448\u0435\u043D\u0430
      \u0438 \u0445\u0440\u0443\u043F\u043A\u0430: \u0434\u0440\u043E\u0431\u044F\u0449\u0438\u0439
      \u0443\u0440\u043E\u043D \u043F\u043E \u043D\u0435\u0439 \u0440\u0430\u0441\u0442\u0451\u0442.
      \u0424\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u0443\u0434\u0430\u0440
      \u0440\u0430\u0441\u043A\u0430\u043B\u044B\u0432\u0430\u0435\u0442 \u0441\u0442\u0430\u0442\u0443\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 6997959273340930
    m_Localized: "\u0420\u0430\u0441\u043A\u043E\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 6997959273340931
    m_Localized: "\u041E\u0433\u043B\u0443\u0448\u0435\u043D\u0438\u0435 \u043F\u043E\u0441\u043B\u0435
      \u0440\u0430\u0441\u043A\u043E\u043B\u043E\u0442\u043E\u0439 \u0441\u0442\u0430\u0442\u0443\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 6997959273340932
    m_Localized: "\u041C\u0435\u0440\u0437\u043B\u043E\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 6997959273340933
    m_Localized: "\u0423\u0434\u0430\u0440\u044B \u0440\u0430\u0441\u0449\u0435\u043F\u043B\u0435\u043D\u044B
      \u043C\u0435\u0436\u0434\u0443 \u0441\u0442\u0430\u043B\u044C\u044E \u0438
      \u043B\u044C\u0434\u043E\u043C; \u043A\u0430\u0436\u0434\u044B\u0439 \u0442\u0440\u0435\u0442\u0438\u0439
      \u0431\u044C\u0451\u0442 \u0432\u0434\u0432\u043E\u0435 \u0438 \u0432\u0433\u043E\u043D\u044F\u0435\u0442
      \u0432\u0442\u0440\u043E\u0435 \u0431\u043E\u043B\u044C\u0448\u0435 \u0445\u043E\u043B\u043E\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 6997959273340934
    m_Localized: "\u0422\u044F\u0436\u0451\u043B\u044B\u0439 \u0437\u0430\u043C\u0430\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 6997959273340935
    m_Localized: "\u0421\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u0443\u0434\u0430\u0440
      \u0443\u0441\u0438\u043B\u0435\u043D \u0438 \u0432\u0433\u043E\u043D\u044F\u0435\u0442
      \u043B\u0438\u0448\u043D\u0438\u0435 \u0441\u0442\u0430\u043A\u0438 \u0445\u043E\u043B\u043E\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 6997959273340936
    m_Localized: "\u041B\u0435\u0434\u044F\u043D\u0430\u044F \u0445\u0432\u0430\u0442\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 6997959273340937
    m_Localized: "\u0416\u0430\u0442\u0432\u0430 \u0434\u0435\u0440\u0436\u0438\u0442
      \u0446\u0435\u043B\u044C, \u043F\u043E\u043A\u0430 \u0438\u0434\u0451\u0442
      \u0437\u0430\u043C\u0430\u0445."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
