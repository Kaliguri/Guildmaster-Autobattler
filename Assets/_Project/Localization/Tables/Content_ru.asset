  - m_Id: 3196892471312
    m_Localized: "\u041C\u0435\u0442\u043A\u0430 \u043E\u0445\u043E\u0442\u043D\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 3196892471313
    m_Localized: "\u041B\u0435\u0434\u044F\u043D\u044B\u0435 \u043E\u043A\u043E\u0432\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 3196892471314
    m_Localized: "\u0420\u0435\u0448\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
      \u0443\u0434\u0430\u0440: \u043E\u0433\u043B\u0443\u0448\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 3196892471315
    m_Localized: "\u0420\u0435\u0448\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
      \u0443\u0434\u0430\u0440: \u043E\u0441\u043B\u0430\u0431\u043B\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 3196892471316
    m_Localized: "\u0421\u043A\u0440\u044B\u0442\u043D\u043E\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 3196892471317
    m_Localized: "\u0421\u043A\u0440\u044B\u0442\u043D\u043E\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 3196892471318
    m_Localized: "\u041F\u0440\u0438\u0437\u0435\u043C\u043B\u0435\u043D\u0438\u0435
      \u0432\u0438\u0445\u0440\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 3196892471319
    m_Localized: "\u0412\u0438\u0445\u0440\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 3196892471320
    m_Localized: "\u0417\u0430\u0445\u0432\u0430\u0442 \u0432\u0438\u0445\u0440\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 202216797626368
    m_Localized: "\u0422\u0440\u0435\u043D\u0438\u0440\u043E\u0432\u043E\u0447\u043D\u044B\u0439
      \u043C\u0430\u043D\u0435\u043A\u0435\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 202216843763712
    m_Localized: "\u041F\u0430\u0441\u0441\u0438\u0432\u043D\u0430\u044F \u0442\u0435\u0441\u0442\u043E\u0432\u0430\u044F
      \u043C\u0438\u0448\u0435\u043D\u044C \u0434\u043B\u044F \u043F\u043B\u0435\u0439\u0442\u0435\u0441\u0442\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 1132609788960768
    m_Localized: "\u0413\u043E\u0431\u043B\u0438\u043D \u0441 \u043F\u0430\u043B\u043A\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 1132609788960769
    m_Localized: "\u0421\u043B\u0430\u0431\u044B\u0439 \u0433\u043E\u0431\u043B\u0438\u043D
      \u0441 \u0434\u0443\u0431\u0438\u043D\u043E\u0439 \u2014 \u043E\u043F\u0430\u0441\u0435\u043D
      \u0442\u043E\u043B\u044C\u043A\u043E \u0447\u0438\u0441\u043B\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 1132610745262080
    m_Localized: "\u0413\u043E\u0431\u043B\u0438\u043D-\u0432\u043E\u0438\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 1132610745262081
    m_Localized: "\u041A\u0440\u0435\u043F\u043A\u0438\u0439 \u0444\u0440\u043E\u043D\u0442\u043E\u0432\u043E\u0439
      \u0433\u043E\u0431\u043B\u0438\u043D \u0441 \u043C\u0435\u0447\u043E\u043C
      \u0438 \u0449\u0438\u0442\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 1132607029108736
    m_Localized: "\u0413\u043E\u0431\u043B\u0438\u043D-\u043B\u0443\u0447\u043D\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 1132607058468864
    m_Localized: "\u0422\u0440\u0443\u0441\u043B\u0438\u0432\u044B\u0439 \u043B\u0443\u0447\u043D\u0438\u043A,
      \u043E\u0431\u0441\u0442\u0440\u0435\u043B\u0438\u0432\u0430\u044E\u0449\u0438\u0439
      \u043A\u043E\u043C\u0430\u043D\u0434\u0443 \u0438\u0437 \u0442\u044B\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1132608274817024
    m_Localized: "\u0413\u043E\u0431\u043B\u0438\u043D-\u0443\u0431\u0438\u0439\u0446\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1132608274817025
    m_Localized: "\u0411\u044B\u0441\u0442\u0440\u044B\u0439 \u043D\u043E\u0436\u043D\u0438\u043A,
      \u043E\u0431\u0445\u043E\u0434\u044F\u0449\u0438\u0439 \u0444\u0440\u043E\u043D\u0442
      \u043A \u043B\u0451\u0433\u043A\u0438\u043C \u0446\u0435\u043B\u044F\u043C
      \u0442\u044B\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1137885233537024
    m_Localized: "\u041F\u0443\u0441\u0442\u043E\u0439 \u0441\u043E\u0441\u0443\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 1137885267091456
    m_Localized: "\u041F\u0440\u043E\u0441\u0442\u043E\u0439 \u0431\u043E\u0435\u0432\u043E\u0439
      \u043A\u0438\u0442 \xAB\u043F\u0443\u0441\u0442\u043E\u0433\u043E\xBB \u0441\u043E\u0441\u0443\u0434\u0430
      \u0431\u0435\u0437 \u043E\u0441\u043E\u0431\u043E\u0433\u043E \u0440\u0435\u043B\u0438\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1407021935222784
    m_Localized: "\u0414\u0440\u0443\u0438\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 1407021998137344
    m_Localized: "\u0417\u0430\u043A\u043B\u0438\u043D\u0430\u0442\u0435\u043B\u044C
      [kw:poison:gen]: \u0441\u043F\u043E\u0440\u044B \u0432\u044B\u0435\u0434\u0430\u044E\u0442
      \u0441\u0442\u0440\u043E\u0439 \u0432\u0440\u0430\u0433\u0430, \u0430 \u0437\u0430\u0442\u0435\u043C
      \u0434\u0435\u0442\u043E\u043D\u0438\u0440\u0443\u044E\u0442 \u0440\u0430\u0437\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 1407021998137345
    m_Localized: "\u041E\u0433\u043D\u0435\u043D\u043D\u044B\u0439 \u043C\u0435\u0447\u043D\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 1407021998137346
    m_Localized: "\u041A\u0430\u0436\u0434\u044B\u0439 \u0443\u0434\u0430\u0440 \u043A\u043B\u0438\u043D\u043A\u0430
      \u0440\u0430\u0437\u0433\u043E\u043D\u044F\u0435\u0442 \u0435\u0433\u043E \u0438
      \u043D\u0430\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442 [kw:burn:acc]
      \u2014 \u0446\u0435\u043D\u043E\u0439 \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439
      \u043A\u0440\u043E\u0432\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 1407021998137347
    m_Localized: "\u0414\u0440\u0435\u0432\u0435\u043D\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1407021998137348
    m_Localized: "\u0416\u0438\u0432\u0430\u044F \u0441\u0442\u0435\u043D\u0430:
      \u0447\u0435\u043C \u043A\u0440\u0435\u043F\u0447\u0435 \u043A\u043E\u0440\u0430
      \u0438 \u0432\u044B\u0448\u0435 [kw:armor], \u0442\u0435\u043C \u0431\u043E\u043B\u044C\u043D\u0435\u0435
      \u0448\u0438\u043F\u044B \u0431\u044C\u044E\u0442 \u0432\u0441\u0435\u0445
      \u0432\u043E\u043A\u0440\u0443\u0433."
    m_Metadata:
      m_Items: []
  - m_Id: 1407021998137349
    m_Localized: "\u0413\u0440\u0438\u0431\u043D\u044B\u0435 \u0441\u043F\u043E\u0440\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 1407021998137350
    m_Localized: "\u041F\u043E\u0434\u0436\u043E\u0433"
    m_Metadata:
      m_Items: []
  - m_Id: 1407021998137351
    m_Localized: "\u041F\u044B\u043B\u0430\u044E\u0449\u0438\u0435 \u043A\u043B\u0438\u043D\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1407021998137352
    m_Localized: "\u041F\u044B\u043B\u0430\u044E\u0449\u0438\u0435 \u043A\u043B\u0438\u043D\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1407021998137353
    m_Localized: "\u0428\u0438\u043F\u0430\u0441\u0442\u043E\u0435 \u0434\u0440\u0435\u0432\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 1407021998137354
    m_Localized: "\u0420\u0430\u0437\u0440\u0430\u0441\u0442\u0430\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1419809709613056
    m_Localized: "\u0421\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u0439
      \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446"
    m_Metadata:
      m_Items: []
  - m_Id: 1419809755750400
    m_Localized: "\u041D\u0430 \u043F\u0435\u0440\u0435\u043F\u0443\u0442\u044C\u0435
      \u0432\u0430\u0441 \u043E\u043A\u043B\u0438\u043A\u0430\u0435\u0442 \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446
      \u0432 \u043F\u044B\u043B\u044C\u043D\u043E\u043C \u043F\u043B\u0430\u0449\u0435.
      \u0422\u043E\u0432\u0430\u0440 \u043D\u0435\u0434\u0451\u0448\u0435\u0432,
      \u043D\u043E \u0433\u043B\u0430\u0437\u0430 \u0435\u0433\u043E \u0445\u0438\u0442\u0440\u043E
      \u0431\u043B\u0435\u0441\u0442\u044F\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 1419809755750401
    m_Localized: "\u041A\u0443\u043F\u0438\u0442\u044C \u0440\u0435\u043B\u0438\u043A\u0432\u0438\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 1419809755750402
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446 \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u043E
      \u043A\u0438\u0432\u0430\u0435\u0442 \u0438 \u0432\u0440\u0443\u0447\u0430\u0435\u0442
      \u0432\u0430\u043C \u0441\u0432\u0451\u0440\u0442\u043E\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 1419809755750403
    m_Localized: "\u041E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u0442\u043E\u0432\u0430\u0440"
