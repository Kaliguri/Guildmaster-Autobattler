      \u043E\u0433\u043D\u0451\u043C, \u0430 \u043E\u0433\u043E\u043D\u044C \u2014
      \u044D\u0442\u043E [kw:magical]. \u041A\u043E\u043F\u044F\u0442\u0441\u044F
      \u043E\u0442 \u043B\u044E\u0431\u043E\u0433\u043E \u043E\u0433\u043D\u044F,
      \u043E\u0441\u044B\u043F\u0430\u044E\u0442\u0441\u044F \u0431\u0435\u0437 \u043F\u043E\u0434\u043F\u0438\u0442\u043A\u0438."
