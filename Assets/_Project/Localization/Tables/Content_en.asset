  - m_Id: 202216797626368
    m_Localized: Training Dummy
    m_Metadata:
      m_Items: []
  - m_Id: 202216843763712
    m_Localized: A passive test target for playtesting.
    m_Metadata:
      m_Items: []
  - m_Id: 1132609788960768
    m_Localized: Goblin Grunt
    m_Metadata:
      m_Items: []
  - m_Id: 1132609788960769
    m_Localized: "Weak club goblin \u2014 dangerous only in numbers."
    m_Metadata:
      m_Items: []
  - m_Id: 1132610745262080
    m_Localized: Goblin Warrior
    m_Metadata:
      m_Items: []
  - m_Id: 1132610745262081
    m_Localized: Sword-and-shield frontliner that holds the line.
    m_Metadata:
      m_Items: []
  - m_Id: 1132607029108736
    m_Localized: Goblin Archer
    m_Metadata:
      m_Items: []
  - m_Id: 1132607058468864
    m_Localized: Cowardly archer that peppers the party from the back line.
    m_Metadata:
      m_Items: []
  - m_Id: 1132608274817024
    m_Localized: Goblin Cutthroat
    m_Metadata:
      m_Items: []
  - m_Id: 1132608274817025
    m_Localized: Fast knife goblin that flanks toward soft back-line targets.
    m_Metadata:
      m_Items: []
  - m_Id: 1137885233537024
    m_Localized: Base Kit
    m_Metadata:
      m_Items: []
  - m_Id: 1137885267091456
    m_Localized: Plain fighter kit worn by a vessel with no special relic.
    m_Metadata:
      m_Items: []
  - m_Id: 1407021935222784
    m_Localized: Druid
    m_Metadata:
      m_Items: []
  - m_Id: 1407021998137344
    m_Localized: 'A poison caster: his spores wither the enemy line, then burst all
      at once.'
    m_Metadata:
      m_Items: []
  - m_Id: 1407021998137345
    m_Localized: Flame Swordsman
    m_Metadata:
      m_Items: []
  - m_Id: 1407021998137346
    m_Localized: "Every blade hit stokes his speed and sets the target ablaze \u2014
      at the cost of his own blood."
    m_Metadata:
      m_Items: []
  - m_Id: 1407021998137347
    m_Localized: Treant
    m_Metadata:
      m_Items: []
  - m_Id: 1407021998137348
    m_Localized: 'A living wall: the tougher his bark, the more the thorns bite back
      at everyone around.'
    m_Metadata:
      m_Items: []
