  m_TableData:
  - m_Id: 2796550348800
    m_Localized: Assassin
    m_Metadata:
      m_Items: []
  - m_Id: 2796625846272
    m_Localized: A swift killer who cuts down a weak target and slips out of focus.
    m_Metadata:
      m_Items: []
  - m_Id: 3196892471296
    m_Localized: Cryomancer
    m_Metadata:
      m_Items: []
  - m_Id: 3196892471297
    m_Localized: An ice mage who sets up control and catches enemies in a window
      of weakness.
    m_Metadata:
      m_Items: []
  - m_Id: 3196892471298
    m_Localized: Defender
    m_Metadata:
      m_Items: []
  - m_Id: 3196892471299
    m_Localized: A steadfast frontliner who holds the line and shields allies.
    m_Metadata:
      m_Items: []
  - m_Id: 3196892471300
    m_Localized: Iron Spearman
    m_Metadata:
      m_Items: []
  - m_Id: 3196892471301
    m_Localized: A disciplined vanguard who pushes the front with linear damage.
    m_Metadata:
      m_Items: []
  - m_Id: 3196892471302
    m_Localized: Ranger
    m_Metadata:
      m_Items: []
  - m_Id: 3196892471303
    m_Localized: A mobile hunter who keeps constant pressure on the priority target.
    m_Metadata:
      m_Items: []
  - m_Id: 3196892471304
    m_Localized: Whirl Monk
    m_Metadata:
      m_Items: []
  - m_Id: 3196892471305
    m_Localized: An agile combat master who breaks enemy formation with a flurry
      of shoves.
    m_Metadata:
      m_Items: []
  - m_Id: 3196892471306
    m_Localized: Light Shepherd
    m_Metadata:
      m_Items: []
  - m_Id: 3196892471307
    m_Localized: A battle healer who keeps the team hanging on the edge of survival.
    m_Metadata:
      m_Items: []
  - m_Id: 3196892471308
    m_Localized: Bulwark
    m_Metadata:
      m_Items: []
  - m_Id: 3196892471309
