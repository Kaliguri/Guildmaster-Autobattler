/*
 * Content Hub chrome. Consumes only var(--gh-*) from ContentHubTokens.uss.
 * Shell layout: toolbar / accent line / pill tab bar / content scroll.
 */

.gh-root {
    flex-grow: 1;
    background-color: var(--gh-bg);
    color: var(--gh-text);
}

/* ---------------------------------------------------------------- toolbar */
.gh-toolbar {
    flex-direction: row;
    align-items: center;
    height: 34px;
    padding-left: var(--gh-pad);
    padding-right: var(--gh-pad);
    background-color: var(--gh-bg-raised);
    border-bottom-width: 1px;
    border-bottom-color: var(--gh-border);
}

.gh-brand {
    flex-direction: row;
    align-items: baseline;
}

.gh-brand-dim {
    color: var(--gh-text-faint);
    font-size: 11px;
    -unity-font-style: bold;
    margin-right: 4px;
}

.gh-brand-bright {
    color: var(--gh-text);
    font-size: 12px;
    -unity-font-style: bold;
}

.gh-header-sep {
    width: 1px;
    height: 18px;
    background-color: var(--gh-border);
    margin-left: var(--gh-gap);
    margin-right: var(--gh-gap);
}

.gh-header-spacer {
    flex-grow: 1;
}

.gh-toolbar-btn {
    height: 22px;
    padding-left: 10px;
    padding-right: 10px;
    background-color: var(--gh-panel);
    border-width: 1px;
    border-color: var(--gh-border);
    border-radius: var(--gh-radius-sm);
    color: var(--gh-text);
    margin-left: 4px;
}

.gh-toolbar-btn:hover {
    background-color: var(--gh-panel-hover);
    border-color: var(--gh-border-strong);
}

/* ---------------------------------------------------------------- accent line */
.gh-accent-line {
    height: 2px;
    background-color: var(--gh-accent);
}

/* ---------------------------------------------------------------- tab bar */
.gh-tabbar {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    padding: 6px var(--gh-pad);
    background-color: var(--gh-bg-raised);
    border-bottom-width: 1px;
    border-bottom-color: var(--gh-border);
}

.gh-pill-group {
    flex-direction: row;
    align-items: center;
}

.gh-pill-group-sep {
    width: 1px;
    height: 16px;
    background-color: var(--gh-border);
    margin-left: 6px;
    margin-right: 6px;
}

.gh-pill {
    flex-direction: row;
    align-items: center;
    height: 24px;
    padding-left: 10px;
    padding-right: 10px;
    margin-right: 3px;
    background-color: transparent;
    border-width: 1px;
    border-color: transparent;
    border-radius: 12px;
    color: var(--gh-text-dim);
}

.gh-pill:hover {
    background-color: var(--gh-panel);
    color: var(--gh-text);
}

.gh-pill--active {
    background-color: var(--gh-accent-dim);
    border-color: var(--gh-accent);
    color: var(--gh-text);
}

.gh-pill-label {
    font-size: 12px;
    -unity-font-style: bold;
}

.gh-pill-badge {
    min-width: 15px;
    height: 15px;
    margin-left: 6px;
    padding-left: 4px;
    padding-right: 4px;
    border-radius: 8px;
    background-color: var(--gh-error);
    color: white;
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* ---------------------------------------------------------------- content */
.gh-content {
    flex-grow: 1;
    background-color: var(--gh-bg);
}

.gh-page {
    padding: 14px;
}

.gh-intro {
    color: var(--gh-text-dim);
    font-size: 12px;
    white-space: normal;
    margin-bottom: 12px;
    padding: 8px 10px;
    background-color: var(--gh-bg-sunken);
    border-left-width: 2px;
    border-left-color: var(--gh-accent);
    border-radius: var(--gh-radius-sm);
}

.gh-stub {
    color: var(--gh-text-faint);
    font-size: 13px;
    -unity-text-align: middle-center;
    margin-top: 40px;
    white-space: normal;
}

/* ---------------------------------------------------------------- two-pane */
.gh-twopane {
    flex-direction: row;
    flex-grow: 1;
}

.gh-twopane-left {
    width: 300px;
    min-width: 180px;
    background-color: var(--gh-bg-sunken);
    border-right-width: 1px;
    border-right-color: var(--gh-border);
}

.gh-twopane-divider {
    width: 4px;
    background-color: var(--gh-border);
    cursor: resize-horizontal;
}

.gh-twopane-divider:hover {
    background-color: var(--gh-accent-dim);
}

.gh-twopane-right {
    flex-grow: 1;
}

.gh-search {
    margin: 6px;
}

/* ---------------------------------------------------------------- toasts */
.gh-toast {
    position: absolute;
    bottom: 14px;
    right: 14px;
    max-width: 380px;
    padding: 8px 12px;
    border-radius: var(--gh-radius);
    background-color: var(--gh-panel);
    border-left-width: 3px;
    border-left-color: var(--gh-info);
    color: var(--gh-text);
    font-size: 12px;
    white-space: normal;
    opacity: 1;
    transition-property: opacity;
    transition-duration: 0.4s;
}

.gh-toast--out {
    opacity: 0;
}

.gh-toast--success { border-left-color: var(--gh-success); }
.gh-toast--info { border-left-color: var(--gh-info); }
.gh-toast--warning { border-left-color: var(--gh-warning); }
.gh-toast--error { border-left-color: var(--gh-error); }
