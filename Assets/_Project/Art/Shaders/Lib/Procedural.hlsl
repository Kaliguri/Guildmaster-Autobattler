#ifndef GUILDMASTER_PROCEDURAL_INCLUDED
#define GUILDMASTER_PROCEDURAL_INCLUDED

// ОБЩИЕ ФОРМУЛЫ ДЛЯ ШЕЙДЕРОВ — хеши, шум, дизеринг. Единственный дом для того, что иначе копируется
// из шейдера в шейдер: матрица Байера уже стояла дословным дублем в тумане карты и в переходе.
// Правило и границы применения — code-standards §8.
//
// ЧТО СЮДА КЛАДЁМ: формулу, у которой есть ВТОРОЙ потребитель или который заведомо появится в этом
// же заходе. Функция «на будущее» здесь — мёртвый код, а он у нас дефект, а не задел: непонятно,
// правильная ли она, пока её никто не вызвал.
//
// ЧТО СЮДА НЕ КЛАДЁМ: рандом симуляции (`XorShiftRng`, C#) и шум запекателя панелей. Похожи только
// на вид — задачи разные: воспроизводимость между машинами, дешевизна на пиксель и красота фактуры.
// Сведение их к одной функции было бы симметрией ради симметрии.
//
// ПРЕФИКС `GM_` обязателен: файл включается рядом с хедерами URP, а имена вроде `Hash` и `Noise`
// там уже заняты и будут заняты дальше.

// --------------------------------------------------------------------------------------------
// Хеши
// --------------------------------------------------------------------------------------------

/// 1D → 1D. Целочисленно-битовая раскрутка дробной части: без `sin`, поэтому не зависит от того, как
/// конкретный компилятор разворачивает тригонометрию, и одинаково ведёт себя на всех целевых платформах.
/// Это версия для ВТОРОЙ ступени детерминизма (§8) — там, где двое игроков обязаны увидеть одно и то же.
float GM_Hash11(float x)
{
    x = frac(x * 0.1031);
    x *= x + 33.33;
    return frac((x + x) * x);
}

/// 2D → 1D, дешёвый вариант на `sin`. Годится только для ТРЕТЬЕЙ ступени (§8) — когда результат не
/// сверяет никто: разброс осколков, зерно, джиттер. Для общей картинки в коопе брать `GM_Hash11`
/// от сида, пришедшего из симуляции.
float GM_Hash21(float2 p)
{
    return frac(sin(dot(p, float2(12.9898, 78.233))) * 43758.5453);
}

// --------------------------------------------------------------------------------------------
// Шум
// --------------------------------------------------------------------------------------------

/// Гладкий 1D value noise в диапазоне [-1..1]. Сглаживание обязательно: рваные скачки между узлами
/// читаются как грязь, а не как неровность.
float GM_ValueNoise11(float x)
{
    float i = floor(x);
    float f = frac(x);
    f = f * f * (3.0 - 2.0 * f);
    return lerp(GM_Hash11(i), GM_Hash11(i + 1.0), f) * 2.0 - 1.0;
}

// --------------------------------------------------------------------------------------------
// Дизеринг
// --------------------------------------------------------------------------------------------

/// Матрица Байера 4x4 — порог упорядоченного дизеринга по положению пикселя НА ЭКРАНЕ.
static const float GM_BayerMatrix4x4[16] =
{
     0.0 / 16.0,  8.0 / 16.0,  2.0 / 16.0, 10.0 / 16.0,
    12.0 / 16.0,  4.0 / 16.0, 14.0 / 16.0,  6.0 / 16.0,
     3.0 / 16.0, 11.0 / 16.0,  1.0 / 16.0,  9.0 / 16.0,
    15.0 / 16.0,  7.0 / 16.0, 13.0 / 16.0,  5.0 / 16.0
};

/// Порог дизеринга для пикселя. Даёт точечный растр вместо гладкого градиента — прозрачность
/// перестаёт читаться как «фильтр поверх картинки» и становится её частью. Приём общий для тумана
/// карты и растворения перехода, и он же ждёт любое будущее затухание в мире.
///
/// КООРДИНАТА ОБЯЗАНА БЫТЬ ЭКРАННОЙ (`positionCS.xy`): растр держится за пиксели, а не за поверхность.
/// Подашь UV — рисунок поедет вместе с полотном и при масштабировании превратится в муар.
float GM_BayerThreshold(float2 screenPos)
{
    int2 p = int2(fmod(screenPos, 4.0));
    return GM_BayerMatrix4x4[p.y * 4 + p.x];
}

#endif // GUILDMASTER_PROCEDURAL_INCLUDED
